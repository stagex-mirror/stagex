FROM base AS build
ARG USERNAME=user
ARG HOSTNAME=sxos
ARG AUTHORIZED_KEYS=empty
COPY authorized_keys /
COPY --from=user-openssh . /
COPY --from=core-openssl . /
COPY --from=core-filesystem . initramfs
COPY --from=user-linux-server /bzImage iso/boot/vmlinuz
COPY --from=core-busybox . initramfs
COPY --from=user-eudev . initramfs
COPY --from=core-musl . initramfs
COPY --from=core-zlib . initramfs
COPY --from=user-npth . initramfs
COPY --from=user-libksba . initramfs
COPY --from=core-bash . initramfs
COPY --from=user-flashtools . initramfs
COPY --from=core-curl . initramfs
COPY --from=user-tpm2-tools . initramfs
COPY --from=user-tpm2-tss . initramfs
COPY --from=core-openssl . initramfs
COPY --from=user-libusb . initramfs
COPY --from=user-ccid . initramfs
COPY --from=user-pcsc-lite . initramfs
COPY --from=user-pcsc-tools . initramfs
COPY --from=user-libqrencode . initramfs
COPY --from=core-gmp . initramfs
COPY --from=core-libunwind . initramfs
COPY --from=user-opensc . initramfs
COPY --from=user-util-linux . initramfs
COPY --from=core-llvm /usr/lib/. initramfs/usr/lib/
COPY --from=core-sqlite3 . initramfs
COPY --from=user-libslirp . initramfs
COPY --from=user-glib . initramfs
COPY --from=user-numactl . initramfs
COPY --from=core-libzstd . initramfs
COPY --from=core-zlib . initramfs
COPY --from=user-lzo . initramfs
COPY --from=user-dtc . initramfs
COPY --from=user-libaio . initramfs
COPY --from=user-libseccomp . initramfs
COPY --from=core-libffi . initramfs
COPY --from=core-libzstd . initramfs
COPY --from=core-zlib . initramfs
COPY --from=core-ncurses . initramfs
COPY --from=user-tmux . initramfs
COPY --from=user-dhcpcd . initramfs
COPY --from=user-openssh . initramfs
COPY --from=core-openssl . initramfs
COPY --from=core-zlib . initramfs
COPY src/rootfs/ initramfs
COPY --from=core-bash . initramfs
RUN <<-EOF
	set -eux
	cd initramfs
	sed -i 's/\$USERNAME/'$USERNAME'/g' etc/inittab
	sed -i 's/\$HOSTNAME/'$HOSTNAME'/g' etc/inittab
	echo "$HOSTNAME" > etc/hostname
	rm -rf home/user
	sed -i '/^user:/d' etc/passwd
	echo "$USERNAME:x:1000:1000:$USERNAME:/home/$USERNAME:/bin/bash" >> etc/passwd
	sed -i '/^user:/d' etc/group
	echo "$USERNAME:x:1000:" >> etc/group
	sed -i '/^docker:/d' etc/group
	echo "docker:x:993:$USERNAME" >> etc/group
	mkdir -p home/$USERNAME
	chown -R 1000:1000 home/$USERNAME
	if [ "$AUTHORIZED_KEYS" != "empty" ] && [ -s /authorized_keys ]; then
		mkdir -p home/$USERNAME/.ssh
		cp /authorized_keys home/$USERNAME/.ssh/authorized_keys
		chmod 700 home/$USERNAME/.ssh
		chmod 600 home/$USERNAME/.ssh/authorized_keys
	fi
	chown -R 1000:1000 home/$USERNAME
	# Generate build-time SSH keypair for container→guest access
	ls -la /usr/bin/ssh-keygen || (find / -name ssh-keygen -type f 2>/dev/null && echo "ssh-keygen not at /usr/bin")
	/usr/bin/ssh-keygen -t rsa -b 3072 -f ../ssh_host_key -N "" -q
	mkdir -p root/.ssh
	cat ../ssh_host_key.pub > root/.ssh/authorized_keys
	chmod 700 root/.ssh
	chmod 600 root/.ssh/authorized_keys
	find . -exec touch -hcd "@0" "{}" +
	find . -print0 \
	| sort -z \
	| cpio \
		--null \
		--create \
		--verbose \
		--format=newc \
	| gzip --best \
	> ../iso/boot/initramfs
EOF

## Grub (EFI Boot)
COPY src/config/grub.cfg iso/boot/grub/grub.cfg
COPY src/config/grub_early.cfg grub_early.cfg
RUN <<-EOF
    set -eux
    mkdir -p efi/boot
    grub-mkimage \
        --config="grub_early.cfg" \
        --prefix="/boot/grub" \
        --output="efi/boot/bootx64.efi" \
        --format="x86_64-efi" \
        --compression="xz" \
        all_video \
        disk \
        part_gpt \
        part_msdos \
        linux \
        boot \
        echo \
        normal \
        configfile \
        search \
        search_label \
        efi_gop \
        fat \
        iso9660 \
        gzio \
        serial \
        terminal
    find efi -exec touch -hcd "@0" "{}" +
    mformat -i iso/boot/grub/efi.img -C -f 1440 -N 0 ::
    mcopy -i iso/boot/grub/efi.img -ms efi ::
    touch -md "@0" iso/boot/grub/efi.img
EOF

ENV SOURCE_DATE_EPOCH=1
RUN <<-EOF
    set -eux
    dd if=/dev/zero bs=1M count=10 >> user.img
    mformat -v user -i user.img -N 0 ::
    find iso -exec touch -hcd "@0" "{}" +
    xorrisofs \
        -output sxos.iso \
        -full-iso9660-filenames \
        -joliet \
        -rational-rock \
        -sysid LINUX \
        -volid "sxos" \
        -eltorito-boot boot/grub/efi.img \
        -no-emul-boot \
        -eltorito-alt-boot \
        -e boot/grub/efi.img \
        -no-emul-boot \
        -isohybrid-gpt-basdat \
        -follow-links \
        -append_partition 3 0xb user.img \
        iso/
EOF

FROM stagex/user-openssh AS openssh-client

FROM stagex/service-qemu AS package
COPY --from=openssh-client . /
COPY --from=build /sxos.iso /disk.img
COPY --from=build /ssh_host_key /ssh_host_key
COPY src/qemu-startup.sh /usr/bin/qemu-startup.sh
COPY src/run /usr/bin/run
RUN chmod +x /usr/bin/qemu-startup.sh /usr/bin/run && chmod 600 /ssh_host_key
ENTRYPOINT ["/usr/bin/qemu-startup.sh"]

