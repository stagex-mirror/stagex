#!/bin/sh

NAME=home-setup

do_start() {
	echo -n "Setting up home partition: "
	
	HOME_PART=""
	
	# Check if a partition with label "home" already exists
	HOME_PART=$(blkid -L home)
	
	if [ -z "$HOME_PART" ]; then
		echo "home partition not found, looking for unformatted disk..."
		
		# Find unformatted disks (no partition table or no filesystem)
		# Look for /dev/sdX or /dev/nvmeXnY devices without partitions
		UNFORMATTED=""
		
		for dev in /dev/sd[a-z] /dev/nvme[0-9]*n[0-9]*; do
			[ -b "$dev" ] || continue
			
			# Skip if it has partitions
			if ls "${dev}"[1-9]* 2>/dev/null | grep -q .; then
				continue
			fi
			
			# Check if it has a filesystem
			if ! blkid "$dev" 2>/dev/null | grep -q TYPE; then
				UNFORMATTED="$dev"
				break
			fi
		done
		
		if [ -z "$UNFORMATTED" ]; then
			echo "FAIL - no unformatted disk found"
			return 1
		fi
		
		echo "Found unformatted disk: $UNFORMATTED"
		echo "Formatting with ext4 and labeling 'home'..."
		
		# Create partition table and partition
		echo -e "n\np\n1\n\n\nL\nt\n83\nw" | fdisk "$UNFORMATTED"
		
		PARTITION="${UNFORMATTED}1"
		
		# Wait for kernel to recognize partition
		sleep 1
		
		# Format with ext4 and label
		mkfs.ext4 -L home "$PARTITION"
		
		HOME_PART="$PARTITION"
		
		echo "Created and formatted $PARTITION"
	fi
	
	# Ensure /home exists
	mkdir -p /home
	
	# Check if /home has contents that need to be migrated
	if [ "$(ls -A /home 2>/dev/null)" ]; then
		echo "Transferring existing /home contents to new partition..."
		
		# Create temp mount point
		MOUNT_TMP="/tmp/home_mount"
		mkdir -p "$MOUNT_TMP"
		
		# Mount the home partition temporarily
		mount "$HOME_PART" "$MOUNT_TMP"
		
		# Copy existing contents
		cp -a /home/* "$MOUNT_TMP/" 2>/dev/null || true
		
		# Sync to ensure all data written
		sync
		
		# Unmount temp mount
		umount "$MOUNT_TMP"
		rmdir "$MOUNT_TMP"
		
		echo "Contents transferred"
	fi
	
	# Mount home partition to /home
	echo "Mounting home partition to /home..."
	mount "$HOME_PART" /home
	
	# Verify mount
	if mountpoint -q /home; then
		echo "OK"
	else
		echo "FAIL - could not mount home partition"
		return 1
	fi
}

do_stop() {
	echo -n "Stopping $NAME: "
	# Home partition should remain mounted during shutdown
	# It will be unmounted by rcK
	echo "OK"
}

case "$1" in
	start)
		do_start
		;;
	stop)
		do_stop
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
