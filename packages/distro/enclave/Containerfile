FROM stagex/core-filesystem AS core-filesystem
FROM stagex/core-busybox AS core-busybox
FROM stagex/core-musl AS core-musl
FROM stagex/core-zlib AS core-zlib
FROM stagex/core-openssl AS core-openssl
FROM stagex/core-curl AS core-curl
FROM stagex/core-libzstd AS core-libzstd
FROM stagex/core-libunwind AS core-libunwind
FROM stagex/user-sshdt AS user-sshdt
FROM stagex/user-rust-dhcp AS user-rust-dhcp
FROM stagex/user-linux-enclave AS user-linux-enclave
FROM stagex/user-tpm2-tss AS user-tpm2-tss
FROM stagex/user-tpm2-tools AS user-tpm2-tools
FROM stagex/user-sevctl AS user-sevctl
FROM stagex/user-bootproof AS user-bootproof
FROM stagex/user-enclaved AS user-enclaved
FROM stagex/user-snpguest AS user-snpguest
FROM stagex/user-execd AS user-execd
FROM stagex/user-brush AS user-brush
FROM stagex/user-cryptsetup AS user-cryptsetup
FROM stagex/user-popt AS user-popt
FROM stagex/user-lvm2 AS user-lvm2
FROM stagex/user-json-c AS user-json-c
FROM stagex/user-argon2 AS user-argon2
FROM stagex/user-libaio AS user-libaio
FROM stagex/user-e2fsprogs AS user-e2fsprogs
FROM stagex/user-gvisor AS user-gvisor
FROM stagex/user-iproute2 AS user-iproute2
FROM stagex/user-iptables AS user-iptables
FROM stagex/user-util-linux AS user-util-linux
FROM stagex/core-ncurses AS core-ncurses
FROM stagex/user-elfutils AS user-elfutils
FROM stagex/core-xz AS core-xz
FROM stagex/box-disk AS box-disk
FROM stagex/box-cpio AS box-cpio

# ============================================================
# Stage 1: rootfs variants
# ============================================================

# --- default (enclave): minimal ---
# Init: execd (nit: init.unpack=/system init.target=/usr/bin/execd). The unit
# set lives in /etc/execd/units (HCL). The busybox init stack (inittab + rcS
# + S??*) is gone: execd is PID 1 after nit's execve and its reaper parent
# handles orphan reaping + the liveness floor. The base image carries only
# `lo`; the dev variant adds the network + the enclaved daemon stack.
FROM scratch AS rootfs
COPY --from=core-filesystem . /
COPY --from=core-busybox . /
COPY --from=core-musl . /
COPY --from=core-zlib . /
COPY --from=core-openssl . /
COPY --from=core-curl . /
COPY --from=core-libzstd . /
COPY --from=core-libunwind . /
COPY --from=user-execd /usr/bin/execd /usr/bin/execd
# brush replaces busybox `ash` as /bin/sh: any unit `script` body runs on it.
# (The rest of busybox — ip, the coreutils applets the daemons call — stays;
# minification is a separate pass.)
COPY --from=user-brush /usr/bin/brush /usr/bin/brush
RUN ln -sf /usr/bin/brush /bin/sh
COPY src/rootfs/etc/environment /etc/environment
# /etc/{resolv.conf,hostname,hosts} must EXIST in the image: `runsc do`
# (setupNet, do.go) bind-mounts generated copies of all three into every
# sandbox, and the gofer creates each mount point with O_CREAT
# (specutils.go SafeSetupAndMount) before the bind. The booted rootfs is
# read-only erofs, so a missing destination is a gofer fatal (EROFS) that
# kills the whole sandbox at boot — the sentry then dies on an empty
# mounts pipe ("cannot read client sync file: EOF"). Present files make the
# O_CREAT a no-op and the bind is a VFS op (no fs write), the standard
# container-runtime convention. Content is placeholder: the sandbox never
# reads the host files (runsc over-mounts them), and the host-side daemons
# that do want DNS (rust-dhcp) write their own /etc/resolv.conf.
COPY src/rootfs/etc/resolv.conf /etc/resolv.conf
COPY src/rootfs/etc/hostname /etc/hostname
COPY src/rootfs/etc/hosts /etc/hosts
COPY src/rootfs/etc/execd/units/lo.hcl /etc/execd/units/
COPY src/rootfs/oldroot /oldroot
COPY --from=user-tpm2-tss . /
COPY --from=user-tpm2-tools . /
COPY --from=user-sevctl . /
RUN mkdir -p /mnt /run /var/log /etc/keys && touch /mnt/.keep

# --- dev: default + server kernel + network + enclaved daemon stack ---
# The whole boot path is shell-free. enclaved (the single no-arg daemon)
# owns the attestation hardware (SEV-SNP + TPM2), the bootproof evidence
# socket, the PCR11 rootfs measurement, cloud user-data (IMDS / config
# drive), the LUKS /home volume, and the unprivileged user. bootproofd is
# the sole HTTP face (TLS :443) over enclaved's Unix socket. The only
# remaining external calls are the first-boot oracles enclaved execs
# directly (cryptsetup luksFormat, mkfs.ext4, e2fsck, mount) — binaries,
# not shell.
FROM rootfs AS rootfs-dev
COPY --from=user-rust-dhcp /usr/bin/dhcp-client /usr/bin/dhcp-client
COPY --from=user-sshdt . /
COPY --from=user-bootproof . /
COPY --from=user-enclaved . /
COPY --from=user-cryptsetup . /
COPY --from=user-popt . /
COPY --from=user-lvm2 . /
COPY --from=user-json-c . /
COPY --from=user-argon2 . /
COPY --from=user-libaio . /
COPY --from=user-e2fsprogs . /
COPY --from=user-util-linux . /
COPY --from=core-ncurses . /
# Verify-flow helpers (not boot-path daemons): snpguest dumps the SNP report
# for verify-binding's BOUND check; tpm2-tools (above) reads live PCRs.
COPY --from=user-snpguest . /
# gVisor: the user-space kernel that can sandbox workloads.
# runsc (CLI) + the gvisor-bin sidecars (gvisor_sentry is a STRICT runtime
# requirement of runsc; the prewarmer is optional but cheap).
# xdp_loader: the standalone AF_XDP pin tool the sys-net supervisor runs
# (load + pin the redirect program/sockmap/link on the uplink before runsc
# create; runsc's client then inserts its bound socket into the pinned map).
COPY --from=user-gvisor /usr/bin/runsc /usr/bin/runsc
COPY --from=user-gvisor /usr/bin/xdp_loader /usr/bin/xdp_loader
COPY --from=user-gvisor /usr/bin/gvisor-bin /usr/bin/gvisor-bin
# Host-side network stack for runsc: `runsc do`'s setupNet shells out to the
# host `ip` (veth pairs) and `iptables` (NAT). The busybox `ip` applet is too
# limited (no `ip link add veth`); iproute2's /usr/bin/ip overwrites it.
COPY --from=user-iproute2 . /
COPY --from=user-iptables . /
# iproute2's /usr/sbin/ip NEEDs libelf.so.1 (elfutils) which NEEDs
# liblzma.so.5 (core-xz). Without libelf the ip binary cannot even load,
# so runsc do's setupNet (which shells out to `ip route list default` to
# find the egress device) fails and runsc falls back to an isolated netns:
# no veth, no egress, and the sandboxed provisioner's IMDS chain dead-
# times out on AWS (live: "IMDS chain timed out" -> drop: absent ->
# sshdt refused). Ship only the two runtime libs (not headers/.a/man).
# BuildKit COPY follows source symlinks, so the .so.1 soname files land
# as the real bytes.
COPY --from=user-elfutils /usr/lib/libelf.so.1 /usr/lib/libelf.so.1
COPY --from=core-xz /lib/liblzma.so.5 /lib/liblzma.so.5
# execd units (pure depends-graph, topo-sorted by execd): lo (base) ->
# dhcp -> enclaved -> { sshdt, bootproofd }. No shell scripts anywhere.
COPY src/dev/rootfs/etc/execd/units/dhcp.hcl /etc/execd/units/
COPY src/dev/rootfs/etc/execd/units/enclaved.hcl /etc/execd/units/
COPY src/dev/rootfs/etc/execd/units/sshdt.hcl /etc/execd/units/
COPY src/dev/rootfs/etc/execd/units/bootproofd.hcl /etc/execd/units/
# P4: provisioner = sandboxed user-data provisioning (runsc do); bootproofd
# behind a gVisor sandbox gets its TLS :443 face via a DNAT from host iptables.
COPY src/dev/rootfs/etc/execd/units/provisioner.hcl /etc/execd/units/
COPY src/dev/rootfs/usr/libexec/provision.sh /usr/libexec/provision.sh
COPY src/dev/rootfs/usr/libexec/bootproofd-sandbox.sh /usr/libexec/bootproofd-sandbox.sh
# sysnet: the Qubes sys-net face, sn-6 FULL NIC ownership — a gVisor sandbox
# owning the guest NIC's data plane via an AF_XDP redirect on the uplink
# (3-patch runsc, xdp-1..3). The redirect program XDP_PASSes tcp/22 (SSH)
# and diverts every other class into the sandbox's sentry netstack; the
# sandbox sources the guest's real lease address (no NAT). The program's
# empty-sockmap guard (sn-6e) makes the redirect class self-healing: a
# sandbox death auto-PASSes traffic to the kernel until the supervisor's
# liveness teardown respawns it and re-arms the redirect.
COPY src/dev/rootfs/etc/execd/units/sysnet.hcl /etc/execd/units/
COPY src/dev/rootfs/usr/libexec/sysnet.sh /usr/libexec/sysnet.sh
RUN chmod 755 /usr/libexec/sysnet.sh
# Full SPDX build-provenance document (git origin/branch/commit + every
# dependency's name/version/digest), generated into the build context by the
# build and baked into the image; installed at /provenance.spdx.
COPY provenance.spdx /provenance.spdx

# ============================================================
# Stage 2: boot objects (inputs to box-uki, not packed yet)
#
# Firmware-direct UKI: the live layout carries the boot objects in /boot
# (vmlinuz + cmdline). The initramfs is NOT stored here — in the unikernel
# scheme box-disk derives it: it packs the OS as erofs and wraps it in a
# cpio that loop-mounts it, so the erofs system image becomes the initramfs
# and the whole OS runs from memory.
# ============================================================

FROM scratch AS boot-dev
COPY --from=user-linux-enclave /bzImage /boot/vmlinuz
COPY src/config/uki-cmdline-uk /boot/cmdline

# ============================================================
# Stage 3: live layouts — the default package
#
# The pre-packed rootfs contents plus /boot with the boot objects (vmlinuz,
# cmdline) — no initramfs, since box-disk derives it from the erofs in the
# unikernel scheme. Running this as a container shows the same filesystem a
# live boot produces, for testing and debugging.
# ============================================================

FROM rootfs-dev AS package-enclave-dev
COPY --from=boot-dev /boot /boot
CMD ["/bin/sh"]

# ============================================================
# Stage 4: disk images — -img subpackages (unikernel)
#
# box-disk (UNIKERNEL=1) packs the OS as erofs, wraps it in a cpio that
# loop-mounts it (the erofs becomes the initramfs), builds the UKI with that
# as the .initrd, and emits a GPT with only the ESP. The OS runs from memory;
# the disk is just the firmware boot target (storage optional).
# ============================================================

FROM box-disk AS img-enclave-dev
COPY --from=package-enclave-dev . /live
RUN UNIKERNEL=1 box

FROM scratch AS package-enclave-dev-img
COPY --from=img-enclave-dev /disk.img /disk.img

# ============================================================
# Stage 5: -vm subpackages — QEMU runtime around the disk image
# ============================================================

FROM stagex/service-qemu AS package-base
COPY src/qemu-startup.sh /usr/bin/run
ENTRYPOINT ["/usr/bin/run"]

FROM package-base AS package-enclave-dev-vm
COPY --from=package-enclave-dev-img /disk.img /disk.img
