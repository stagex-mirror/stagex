#!/bin/sh
# S53snptpm-agent — start dual attestation agent (TPM2 + SEV-SNP)
#
# Exposes a unified attestation interface on port 9003:
#   GET /attest     -> combined TPM2 PCRs + SEV-SNP report
#   GET /snp/report -> raw SEV-SNP attestation report
#   GET /tpm/pcrs   -> TPM2 PCR values
#   GET /health     -> {"status":"ok"}
DAEMON="/usr/bin/snptpm-agent"
PIDFILE="/run/snptpm-agent.pid"
LOGFILE="/var/log/snptpm-agent.log"

start() {
	[ -x "$DAEMON" ] || { printf "Starting snptpm-agent: "; echo "FAIL (binary not found)"; return 1; }

	mkdir -p /var/log

	printf "Starting snptpm-agent: "
	nohup "$DAEMON" >> "$LOGFILE" 2>&1 &
	echo $! > "$PIDFILE"
	echo "OK (port 9003)"
	return 0
}

stop() {
	printf "Stopping snptpm-agent: "
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	echo "OK"
	return 0
}

status() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "snptpm-agent is running (PID: $(cat "$PIDFILE"), port 9003)"
	else
		echo "snptpm-agent is stopped"
	fi
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; start ;;
	status)  status ;;
	*) echo "Usage: $0 {start|stop|restart|status}" ;;
esac

exit $?
