#!/bin/sh
# S50swtpm — start software TPM emulator if no hardware TPM present
SWTPM="/usr/bin/swtpm"
TPMDEV="/dev/tpm0"
SWTPM_SOCKET="/run/swtpm-sock"
SWTPM_STATE="/var/lib/swtpm"

start() {
	if [ -e "$TPMDEV" ]; then
		printf "swtpm: hardware TPM detected, skipping\n" >&2
		return 0
	fi

	mkdir -p "$SWTPM_STATE"
	printf "Starting swtpm: "
	$SWTPM socket \
		--tpm2 \
		--ctrl type=unixio,path=$SWTPM_SOCKET \
		--tpmstate dir=$SWTPM_STATE \
		--log level=20 \
		--daemon && \
		chmod 666 "$SWTPM_SOCKET" && \
		echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping swtpm: "
	killall swtpm 2>/dev/null
	echo "OK"
}

case "$1" in
	start)  start ;;
	stop)   stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}" ;;
esac

exit $?
