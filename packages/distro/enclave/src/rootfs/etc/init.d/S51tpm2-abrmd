#!/bin/sh
# S51tpm2-abrmd — start TPM 2.0 Access Broker and Resource Manager
DAEMON="/usr/sbin/tpm2-abrmd"
PIDFILE="/run/tpm2-abrmd.pid"
SOCKET="/run/tpm2-abrmd/tpm2-abrmd.sock"

start() {
	[ -x "$DAEMON" ] || { printf "Starting tpm2-abrmd: "; echo "FAIL (binary not found)"; return 1; }

	mkdir -p /run/tpm2-abrmd
	chown root:root /run/tpm2-abrmd
	chmod 0755 /run/tpm2-abrmd

	printf "Starting tpm2-abrmd: "
	$DAEMON \
		--tpm-transport=device \
		--device-name=/dev/tpmrm0 \
		--address=unix:/run/tpm2-abrmd/tpm2-abrmd.sock \
		--session-bus=system \
		--daemonize \
		--pid-file="$PIDFILE" && \
		chmod 0660 "$SOCKET" && \
		echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping tpm2-abrmd: "
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	echo "OK"
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}" ;;
esac

exit $?
