#!/bin/sh
# S52keylime-agent — start Keylime TPM attestation agent
DAEMON="keylime_agent"
CONFIG="/etc/keylime/keylime.conf"
AGENT_CONF="/etc/keylime/agent.conf"
PIDFILE="/run/keylime/keylime-agent.pid"
LOGFILE="/var/log/keylime/keylime-agent.log"

start() {
	[ -f "$CONFIG" ] || { printf "Starting keylime-agent: "; echo "FAIL (no config)"; return 1; }
	[ -f "$AGENT_CONF" ] || { printf "Starting keylime-agent: "; echo "FAIL (no agent config)"; return 1; }

	mkdir -p /run/keylime /var/log/keylime
	chown root:root /run/keylime /var/log/keylime

	printf "Starting keylime-agent: "
	nohup /usr/bin/python3 -m keylime.agent \
		-c "$CONFIG" \
		--agent-config "$AGENT_CONF" \
		>> "$LOGFILE" 2>&1 &
	echo $! > "$PIDFILE"
	echo "OK"
	return 0
}

stop() {
	printf "Stopping keylime-agent: "
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	echo "OK"
	return 0
}

status() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "keylime-agent is running (PID: $(cat "$PIDFILE"))"
	else
		echo "keylime-agent is stopped"
	fi
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; start ;;
	status)  status ;;
	*) echo "Usage: $0 {start|stop|restart|status}" ;;
esac

exit $?
