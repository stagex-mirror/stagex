#!/bin/sh
# S52keylime-agent — start Rust Keylime TPM attestation agent
DAEMON="keylime_agent"
CONFIG="/etc/keylime/agent.conf"
PIDFILE="/run/keylime/keylime-agent.pid"
LOGFILE="/var/log/keylime/keylime-agent.log"

start() {
	[ -x "/usr/bin/$DAEMON" ] || { printf "Starting keylime-agent: "; echo "FAIL (binary not found)"; return 1; }

	mkdir -p /run/keylime /var/log/keylime /var/lib/keylime

	printf "Starting keylime-agent: "
	# agent.conf has run_as="" so it won't try to drop privileges
	# keylime_dir=/run/keylime ensures writable storage on read-only rootfs
	KEYLIME_AGENT_KEYLIME_DIR=/run/keylime \
	nohup /usr/bin/$DAEMON >> "$LOGFILE" 2>&1 &
	echo $! > "$PIDFILE"
	echo "OK"
	return 0
}

stop() {
	printf "Stopping keylime-agent: "
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	echo "OK"
	return 0
}

status() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "keylime-agent is running (PID: $(cat "$PIDFILE"))"
	else
		echo "keylime-agent is stopped"
	fi
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; start ;;
	status)  status ;;
	*) echo "Usage: $0 {start|stop|restart|status}" ;;
esac

exit $?
