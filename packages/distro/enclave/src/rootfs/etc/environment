PATH=/usr/sbin:/usr/bin:/sbin:/bin
HOME=/root
TERM=linux
SHELL=/bin/sh
RUST_LOG=info
# NOTE: execd's runtime env (EXECD_CONTROL_SOCKET, EXECD_FLEET_DIR) does NOT
# live here. nit execve's its init.target with an EMPTY environment (no
# envp; the README's "empty environment + minimal argv at exec"), and
# /etc/environment is a PAM login convention nit never reads — so anything
# set here is inert under nit. Those two vars are carried by the init
# wrapper /usr/libexec/execd-init (init.target), which exports them before
# exec'ing /usr/bin/execd.
