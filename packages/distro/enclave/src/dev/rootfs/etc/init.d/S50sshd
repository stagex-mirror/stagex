#!/bin/sh
# S50sshd — start the enclave SSH server (sshdt)
#
# sshdt (Rust, russh) listens on 0.0.0.0:22 directly — no tcpsvd front-end.
# Public-key auth only, against the cloud-init-seeded
# /root/.ssh/authorized_keys. sshdt auto-accepts anonymous (`none`) auth
# when NO key is configured, so this script is fail-closed: it refuses to
# start unless a key is present, and waits briefly for cloud-init (S05/S06)
# to seed one. Host key is per-boot (regenerated in the /run/ssh tmpfs).

DAEMON="sshdt"
PIDFILE="/var/run/$DAEMON.pid"
LOGFILE="/var/log/$DAEMON.log"
HOSTKEY="/run/ssh/host_ed25519"
AUTHORIZED="/root/.ssh/authorized_keys"
CONF="/run/ssh/sshdt.conf"

write_conf() {
	# Port 22, all interfaces. Pubkey only: no password, no anonymous
	# (`none`) fallback even if the key file is ever empty.
	printf '%s\n' \
		"Port 22" \
		"ListenAddress 0.0.0.0" \
		"HostKey $HOSTKEY" \
		"AuthorizedKeysFile $AUTHORIZED" \
		"PasswordAuthentication no" \
		> "$CONF"
}

wait_for_key() {
	# The key file must exist and hold at least one key line. Cloud-init
	# seeds it synchronously before this script (S05 drive / S06 net), but
	# a slow metadata fetch can lose the race on first boot.
	i=0
	while [ $i -lt 30 ]; do
		[ -s "$AUTHORIZED" ] && grep -qE '^(ssh-|ecdsa-|sk-|comment=)' "$AUTHORIZED" && return 0
		i=$((i + 1))
		sleep 3
	done
	return 1
}

start() {
	printf "Starting %s: " "$DAEMON"

	if ! wait_for_key; then
		# No key: sshdt would accept anonymous connections. Stay closed.
		echo "FAIL (no authorized key; refusing to run open)"
		return 1
	fi

	mkdir -p /run/ssh /var/log
	chmod 700 /run/ssh
	write_conf

	nohup "$DAEMON" -f "$CONF" -E "$LOGFILE" </dev/null >/dev/null 2>&1 &
	echo $! > "$PIDFILE"
	echo "OK"
	return 0
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	echo "OK"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit $?
