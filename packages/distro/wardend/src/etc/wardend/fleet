# The container-fleet spec (the wire-acceptance fleet; baked, not IMDS —
# the IMDS user-data fetch is broken on the real wire (the per-attempt LLA
# re-add fails with EOPNOTSUPP -95), so the fleet spec is baked into the
# bundle rootfs at /etc/wardend/fleet. The spec parser (spec::parse_lines)
# reads this file directly (load_fleet_spec) — NOT the broken IMDS path.
#
# The container line (the backend) must precede the host line (a dangling
# backend is a hard error in the spec parser).
container docker.io/library/udunit:latest name=udunit
host udunit.lrvick.dev backend=udunit
# The capstone's second vhost (the stock-nginx concept-proof): the
# `container` line declares the backend name (the spec parser's hard-error
# check: a dangling backend is a typo); the `host` line binds the domain
# to the backend (the SNI -> backend UDS route: /run/wardend/nginx.sock,
# spawned by the seed's `unit` directive). The second domain gets a cert
# as well (a second ACME order, the same seald HSM key); both domains
# are served over HTTPS with real certs (the SNI routes the domain to the
# backend UDS).
container docker.io/library/nginx:latest name=nginx
host nginx.lrvick.dev backend=nginx
# The capstone's ACME domain (real LE-issued cert, our own TLS 1.3 ACME
# client + seald HSM key). Reuses the nginx backend (the SNI route).
# The `acme=` line is the ACME directory URL — PRODUCTION (the staging
# edge resets the host's connection; production is the capstone target).
host acme-test.cautionos.dev backend=nginx
acme=https://acme-v02.api.letsencrypt.org/directory
