FROM stagex/core-filesystem AS core-filesystem
FROM stagex/core-busybox AS core-busybox
FROM stagex/core-musl AS core-musl
FROM stagex/core-libunwind AS core-libunwind
FROM stagex/user-demit AS user-demit
FROM stagex/user-wardend AS user-wardend
FROM stagex/user-linux-enclave AS user-linux-enclave
FROM stagex/user-gvisor AS user-gvisor
FROM stagex/box-disk AS box-disk
FROM stagex/box-cpio AS box-cpio

# ============================================================
# Stage 0: the netstack bundle rootfs
#
# The gvisor netstack sandbox's root filesystem (a Dir bundle rootfs, the
# gvisor moat's only accepted rootfs kind). Its init is `bastiond` (the
# bundle config.json process.args). The bundle carries:
#   - bastiond + posternd (the sandbox init + its :22 co-tenant)
#   - busybox (posternd's interactive shell = /bin/sh; the shell tools)
#   - /etc/{resolv.conf,hostname,hosts} — the P4 gofer rule: runsc setupNet
#     O_CREATs each bind target on the RO bundle rootfs; a missing target is
#     a gofer fatal (EROFS) that kills the sandbox. Present placeholders make
#     the O_CREAT a no-op (the sandbox never reads them; runsc over-mounts).
#   - /root/.ssh/authorized_keys — posternd's keys_dir (default /root/.ssh)
#     INSIDE the sandbox. This is the load-bearing SSH key for the netstack
#     model: bastiond spawns posternd in-sandbox, which reads the BUNDLE's
#     authorized_keys (NOT the host's — the host /root is a separate tmpfs).
#     Fail-closed: no valid key here, posternd refuses to build, :22 stays
#     closed.
#
# The bundle is SHELL-FREE at the init level: the sandbox init (bastiond) and
# its co-tenants (posternd, offline-srv, seald, dpmon) are all native
# binaries, and the IMDS LLA-removal window is pure-Rust netlink (no
# `busybox ip` shell-out). busybox is retained ONLY for posternd's SSH
# status/logs/interactive-shell (posternd execs /bin/sh -c; it is a separate
# crate, not part of this change).
#
# config.json (the runsc contract: process.args, the /run tmpfs mount, the
# caps) is NOT here — it ships from the user-wardend package (versioned with
# the wardend pin) and lands at /images/netstack/config.json in the host
# rootfs below, alongside this rootfs/ at /images/netstack/rootfs/.
# ============================================================
FROM scratch AS netstack-bundle
COPY --from=core-busybox . /
# bridge + posternd are dynamic musl PIEs (NEEDED: ld-musl, libc.musl,
# libunwind.so.1) — ship the musl runtime + libunwind into the bundle rootfs.
# Full-package COPY (not single-file): libc.musl-x86_64.so.1 is a relative
# symlink to ld-musl-x86_64.so.1, and BuildKit's single-file COPY of a
# relative symlink fails to resolve the target in the context.
COPY --from=core-musl . /
COPY --from=core-libunwind . /
COPY --from=user-wardend /usr/bin/bastiond /usr/bin/bastiond
COPY --from=user-wardend /usr/bin/bridge /usr/bin/bridge
COPY --from=user-wardend /usr/bin/posternd /usr/bin/posternd
# dpmon: the IN-SANDBOX data-plane liveness probe (a co-tenant of bridge
# wire, spawned by the bundle config.json argv's --dpmon-bin). It does a
# real external TCP connect on a bounded cadence and publishes
# `<epoch> pass|fail` to the host-visible /run/wardend/devices/dp.status
# (the bind-mounted dir the host-side wardend-watchdog reads).
# Dynamic-musl with the SAME NEEDED as bridge (libc.musl + libunwind) —
# the musl runtime + libunwind above cover it (bridge is the known-working
# sandbox init).
COPY --from=user-wardend /usr/bin/dpmon /usr/bin/dpmon
# offline-srv: the offline-workload co-tenant (UDS-only, no network of its
# own), published to the wire by bridge wire's --expose relay (see the
# bundle config.json argv). Dynamic musl like bridge/posternd — the musl
# runtime + libunwind above cover it.
COPY --from=user-wardend /usr/bin/offline-srv /usr/bin/offline-srv
# seald: the evidence daemon, an IN-SANDBOX co-tenant of bridge wire (spawned
# by the bundle config.json argv's --seald-bin). The bundle's linux.devices
# passes through /dev/tpmrm0 + /dev/tpm0 + /dev/sev-guest so seald's TPM2 /
# SEV-SNP evidence path works in-sandbox. seald is dynamic-musl with the SAME
# NEEDED as bridge (libc.musl + libunwind) — the musl runtime + libunwind
# above cover it (bridge is the known-working sandbox init).
COPY --from=user-wardend /usr/bin/seald /usr/bin/seald
# keepd: the host-side disks daemon (the LUKS2 data plane; a persist
# key-ed secret WARDEND_LUKS_KEY; the gvisor moat has no block-device
# passthrough, so keepd runs under the container moat with the host's
# /dev + CAP_SYS_ADMIN). Shipped by user-wardend (versioned with the
# wardend pin).
COPY --from=user-wardend /usr/bin/keepd /usr/bin/keepd
# The injection seed: bastiond reads /etc/wardend/seed (its default seed
# path, inside the sandbox) and merges the expose/offline directives. This is
# the sole directive source now (the bundle config.json argv is bare `bastiond`)
# — the offline-unit concept-proof: DIRECTIVES, not baked argv, drive
# the relay. The seed is versioned with the wardend pin (user-wardend ships it
# at /images/netstack/seed); the AWS user-data path will feed the same grammar
# from IMDS instead of this baked file.
COPY --from=user-wardend /images/netstack/seed /etc/wardend/seed
COPY src/rootfs/etc/resolv.conf /etc/resolv.conf
COPY src/rootfs/etc/hostname /etc/hostname
COPY src/rootfs/etc/hosts /etc/hosts
COPY src/rootfs/etc/ssh/authorized_keys /root/.ssh/authorized_keys
# The netstack bundle config.json bind-mounts the host's forwarded
# attestation devices (the moat mknods the host's present TPM nodes into
# {root}/devices at runsc-create time; --character-device-policy=passthrough
# then opens them as host fds in the sandbox). The GOFER creates every
# bind-mount DESTINATION with MkdirAll inside the bundle rootfs
# (runsc/specutils/specutils.go SafeSetupAndMount) BEFORE it binds — and on
# the wire this rootfs is served off the RO erofs host rootfs, so a mount
# point whose PARENT (/run/wardend) does not pre-exist makes the gofer
# fatal (mkdir EROFS -> "cannot read client sync file: EOF" -> runsc
# create 128). Pre-create the full path here (the P4 precedent for the
# /etc files the gofer O_CREATs) so the MkdirAll is a no-op on RO erofs.
RUN mkdir -p /run/wardend/devices
# The config.json ALSO bind-mounts {root}/devices/sev-guest -> /dev/sev-guest
# (the SEV-SNP device; the xdp-8 char-device ioctl proxy). The gofer O_CREATs
# the DESTINATION (/dev/sev-guest) inside the bundle rootfs before binding
# (specutils.go SafeSetupAndMount) — and this rootfs is served RO (the OCI
# spec's "readonly": true), so a missing destination is EROFS -> "cannot read
# client sync file: EOF" -> runsc create 128 (the whole netstack refuses to
# start). Pre-create the destination here (the P4 precedent for the /etc files
# the gofer O_CREATs) so the O_CREAT is a no-op on RO. On the wire the bind
# overlays the real char device (seald's sev_present sees a char device ->
# memory_encryption PROVEN); on QEMU (no SEV-SNP) the moat bind-mounts a
# placeholder REGULAR file, which is not a char device, so seald degrades
# honestly to NOT PROVEN (tpm2-only) instead of failing the gate closed.
# COPY (not RUN touch): BuildKit mounts a fresh /dev devtmpfs into the build
# container, so `touch /dev/sev-guest` lands on the discarded tmpfs and never
# reaches the image layer. COPY writes the file into the layer directly.
# The source is an empty regular file (a placeholder; the bind overlays the
# real char device on the wire).
COPY src/dev-sev-guest /dev/sev-guest

# ============================================================
# Stage 1: the host rootfs (the erofs system image)
#
# The wardend boot chain (all static, no shell on the boot path):
#   kernel -> cpio /init (demit) -> loop-mount /system (erofs) + pivot_root
#          -> execve init.target = /usr/bin/regentd (PID 1)
#   regentd: creates the runtime dirs (/run/wardend, /run/wardend/run,
#            /run/postern) + seeds the admin key, then spawns + supervises
#            /usr/bin/wardend.
#   wardend: reads /etc/wardend/units/*.hcl (the pure depends graph) and
#            supervises the units:
#     - xdp-attach (container oneshot, CLONE_NEWNS-only, shares the kernel
#       netns): runs /usr/bin/xattach -> execs the prebuilt xdp_loader to
#       pin the AF_XDP redirect program + socket map on the uplink (the
#       wedge rule: attach before any netstack sandbox). Writes the
#       sentinel netstack waits on.
#     - netstack (gvisor sandbox): runsc create/start --network=sandbox
#       --EXPERIMENTAL-xdp=redirect:eth0 on the /images/netstack bundle;
#       the sandbox init `bastiond` does LLA bootstrap + pure-Rust DHCP
#       + lease apply, the :22 -> UDS relay, the posternd supervisor, and
#       the :8080 demo face. The kernel is FULLY offline (no lease, no :22,
#       no route) — the netstack is the ONLY stack on the wire.
#
# Host-side binaries needed: regentd, wardend, xattach (the units' commands),
# runsc + the gvisor-bin sidecars (gvisor_sentry is a STRICT runsc
# requirement) + xdp_loader (xattach execs it). demit is NOT here — box-disk
# stages it separately as the cpio /init (INIT=/demit/init in the img stage).
# ============================================================
FROM scratch AS rootfs
COPY --from=core-filesystem . /
COPY --from=core-busybox . /
# regentd/wardend/xattach are dynamic musl PIEs (NEEDED: ld-musl, libc.musl,
# libunwind.so.1) — the musl runtime + libunwind must be in the erofs root.
# Full-package COPY (not single-file): libc.musl-x86_64.so.1 is a relative
# symlink; BuildKit's single-file COPY of a relative symlink fails.
COPY --from=core-musl . /
COPY --from=core-libunwind . /
COPY --from=user-wardend /usr/bin/regentd /usr/bin/regentd
COPY --from=user-wardend /usr/bin/wardend /usr/bin/wardend
# keepd: the host-side disks daemon (the LUKS2 data plane). The keepd
# unit runs under the container moat with `rootfs = "/"` (the host
# rootfs), so the binary must be in THIS stage (the netstack-bundle
# copy above is the sandbox bundle, not the host rootfs).
COPY --from=user-wardend /usr/bin/keepd /usr/bin/keepd
# wardend-watchdog: the data-plane backstop (a SEPARATE process from
# regentd + the warden; regentd spawns it once at boot). It fires
# `reboot -f` on a dp-dark >= 540 s (the in-sandbox dpmon status stale)
# or a stale warden heartbeat >= 600 s, with a persistent reboot-loop
# guard on the raw disk tail. Dynamic-musl like regentd (libc.musl +
# libunwind) — the musl runtime + libunwind above cover it.
COPY --from=user-wardend /usr/bin/wardend-watchdog /usr/bin/wardend-watchdog
# wardend-xdparm: the AF_XDP sock_map fast-path re-arm (a SEPARATE process
# from regentd + the warden; regentd spawns it once at boot, after
# spawn_watchdog). It does a real BPF_MAP_LOOKUP_ELEM on the pinned
# /sys/fs/bpf/<iface>/redirect_ip_map key 0 (the wedge detection: the
# kernel auto-removes the socket from the map when the sentry dies, so a
# missing/zero entry = the guard has XDP_ACT_PASS'd everything). On a
# wedge it re-arms WITHOUT a reboot: a fresh AF_XDP socket (SIOCGIFINDEX +
# sockaddr_xdp bind) + UMEM + the fill/completion/RX rings (the -ENOBUFS
# fix — the kernel's xskmap.c refuses to insert a socket whose xs->rx is
# NULL) + BPF_MAP_UPDATE_ELEM key 0, with bounded backoff. If the sentry
# is DEAD it falls back to the existing respawn path (it does not
# implement a new one). Dynamic-musl like regentd (libc.musl + libunwind)
# — the musl runtime + libunwind above cover it.
COPY --from=user-wardend /usr/bin/wardend-xdparm /usr/bin/wardend-xdparm
# wardend-xdpgone: the AF_XDP sock_map wedge TRIGGER (the xdp-9
# disambiguator's forced-wedge half; a SEPARATE process from regentd + the
# warden + the watchdog + the re-arm). regentd spawns it once at boot. It
# watches a trigger file in the bind-mounted devices dir; on trigger it does
# a BPF_OBJ_GET + BPF_MAP_DELETE_ELEM on key 0 of the pinned
# /sys/fs/bpf/eth0/redirect_ip_map, which simulates the kernel's
# xsk_delete_from_maps auto-removal WITHOUT killing the sentry (the socket
# fd stays open, just removed from the map) — the wedge the re-arm must
# recover without a reboot. Dynamic-musl like regentd (libc.musl +
# libunwind) — the musl runtime + libunwind above cover it.
COPY --from=user-wardend /usr/bin/wardend-xdpgone /usr/bin/wardend-xdpgone
COPY --from=user-wardend /usr/bin/xattach /usr/bin/xattach
# The host-side dhcp oneshot's lease-apply script (the udhcpc -s handler):
# the QEMU slirp gap — runsc's prepareRedirectInterfaceArgs is a host-side,
# pre-sandbox step that needs the uplink to already have a single IPv4
# address. On the wire the ENA is addressed by a prior VPC-DHCP step (the
# unit is a no-op there); on QEMU slirp there is no host-side client, so the
# unit runs udhcpc with this script as the -s handler. Versioned with the
# wardend pin (user-wardend ships it).
COPY --from=user-wardend /usr/libexec/dhcp.sh /usr/libexec/dhcp.sh
# gVisor: runsc (the CLI the gvisor moat execs) + the gvisor-bin sidecar dir
# (gvisor_sentry, a STRICT runsc requirement, found next to runsc via the
# gvisorbinaries package) + xdp_loader (the standalone AF_XDP pin tool that
# xattach execs to pin the redirect program/sockmap/link on the uplink).
COPY --from=user-gvisor /usr/bin/runsc /usr/bin/runsc
COPY --from=user-gvisor /usr/bin/gvisor-bin /usr/bin/gvisor-bin
COPY --from=user-gvisor /usr/bin/xdp_loader /usr/bin/xdp_loader
# The unit set (versioned with the wardend pin, shipped by user-wardend).
COPY --from=user-wardend /etc/wardend/units/ /etc/wardend/units/
# The netstack bundle: rootfs/ (Stage 0) + config.json (from user-wardend).
COPY --from=netstack-bundle / /images/netstack/rootfs/
COPY --from=user-wardend /images/netstack/config.json /images/netstack/config.json
# The baked admin key (regentd seeds host /root/.ssh from this; the netstack
# model's posternd reads the BUNDLE's copy, but the host copy keeps regentd
# quiet and serves the postern-sandbox topology if used).
COPY src/rootfs/etc/ssh/authorized_keys /etc/ssh/authorized_keys
# Host placeholder /etc (harmless; the sandbox uses the bundle's copies).
COPY src/rootfs/etc/resolv.conf /etc/resolv.conf
COPY src/rootfs/etc/hostname /etc/hostname
COPY src/rootfs/etc/hosts /etc/hosts
# /oldroot: demit's pivot_root put_old target (pivot_root(c"/mnt",
# c"/mnt/oldroot")) — it must EXIST inside the erofs image (the pivot moves
# the old root here). Empty dir; git cannot track empty dirs, so mkdir it.
RUN mkdir -p /mnt /run /var/log /oldroot && touch /mnt/.keep

# --- dev: the full wardend topology (this IS the dev variant) ---
FROM rootfs AS rootfs-dev
COPY provenance.spdx /provenance.spdx

# ============================================================
# Stage 2: boot objects (inputs to box-uki)
# ============================================================
FROM scratch AS boot-dev
COPY --from=user-linux-enclave /bzImage /boot/vmlinuz
COPY src/config/uki-cmdline-uk /boot/cmdline

# ============================================================
# Stage 3: live layout — the default package
# ============================================================
FROM rootfs-dev AS package-wardend-dev
COPY --from=boot-dev /boot /boot
CMD ["/bin/sh"]

# ============================================================
# Stage 4: disk image — -img subpackage (unikernel)
#
# box-disk (UNIKERNEL=1) packs the OS as erofs, wraps it in a cpio whose
# /init is the wardend init binary (demit, via INIT=/demit/init — the
# box-disk default is /nit/init for the nit topology), and uses that cpio as
# the UKI's .initrd. The kernel unpacks it into RAM; demit loop-mounts
# /system, pivots, then execve's init.target (/usr/bin/regentd) as PID 1.
# The disk is ESP-only (the OS runs from memory; storage optional).
# ============================================================
FROM box-disk AS img-wardend-dev
COPY --from=package-wardend-dev . /live
# Override box-disk's baked /nit/init with demit (the wardend init).
COPY --from=user-demit /usr/bin/demit /demit/init
RUN chmod +x /demit/init
RUN UNIKERNEL=1 INIT=/demit/init box

FROM scratch AS package-wardend-dev-img
COPY --from=img-wardend-dev /disk.img /disk.img

# ============================================================
# Stage 5: -vm subpackage — QEMU runtime around the disk image
# ============================================================
FROM stagex/service-qemu AS package-base
COPY src/qemu-startup.sh /usr/bin/run
ENTRYPOINT ["/usr/bin/run"]

FROM package-base AS package-wardend-dev-vm
COPY --from=package-wardend-dev-img /disk.img /disk.img
