FROM stagex/core-filesystem AS core-filesystem
FROM stagex/user-klibc-utils AS user-klibc-utils
FROM stagex/user-klibc-utils-mono AS user-klibc-utils-mono
FROM stagex/box-cpio AS box-cpio

# --- Stage 1: initramfs rootfs (init + mount + mknod utilities) ---
FROM core-filesystem AS initramfs-rootfs
COPY --from=user-klibc-utils-mono /init /init
COPY --from=user-klibc-utils /usr/bin/mount /bin/mount
COPY --from=user-klibc-utils /usr/bin/mknod /bin/mknod
COPY --from=user-klibc-utils /usr/bin/sleep /bin/sleep

# --- Stage 2: initramfs (final — outputs only /initramfs) ---
FROM scratch AS package
COPY --from=initramfs-rootfs --chown=0:0 . /rootfs
COPY --from=box-cpio . /
RUN box initramfs
