#!/bin/sh
# initramfs/init — find squashfs system partition, mount, switch_root, and hand over

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
exec 1>/dev/console 2>&1

echo "initramfs: starting"

# Create mount points
mkdir -p /mnt /proc /sys /dev

# Mount essential virtual filesystems in initramfs
mount -t proc proc /proc || { echo "initramfs: failed to mount proc"; exit 1; }
mount -t sysfs sysfs /sys || { echo "initramfs: failed to mount sysfs"; exit 1; }
mount -t devtmpfs devtmpfs /dev || { echo "initramfs: failed to mount devtmpfs"; exit 1; }

# --- Boot progress marker (persistent, on ESP partition 1) ---
# The serial console is unavailable on SEV-SNP guests, so write a marker to
# the last 4096 bytes of the ESP (FAT, free space) at each stage. After a
# clean poweroff the EBS persists; read the marker back to localize the failure.
# mark() locates the ESP and writes at its true tail (computed from the
# partition size in sysfs) so it works for any ESP size.
mark() {
    mi_esp=""
    mi_sz=""
    if [ -b /dev/nvme0n1p1 ]; then mi_esp=/dev/nvme0n1p1; mi_sz=$(cat /sys/block/nvme0n1/nvme0n1p1/size 2>/dev/null)
    elif [ -b /dev/sda1 ]; then mi_esp=/dev/sda1; mi_sz=$(cat /sys/block/sda/sda1/size 2>/dev/null)
    elif [ -b /dev/vda1 ]; then mi_esp=/dev/vda1; mi_sz=$(cat /sys/block/vda/vda1/size 2>/dev/null)
    elif [ -b /dev/xvda1 ]; then mi_esp=/dev/xvda1; mi_sz=$(cat /sys/block/xvda/xvda1/size 2>/dev/null)
    elif [ -b /dev/hda1 ]; then mi_esp=/dev/hda1; mi_sz=$(cat /sys/block/hda/hda1/size 2>/dev/null)
    fi
    if [ -z "$mi_esp" ]; then
        for mi_d in /sys/block/nvme* /sys/block/sd* /sys/block/vd* /sys/block/xvd*; do
            [ -d "$mi_d" ] || continue
            mi_n=${mi_d##*/}
            case "$mi_n" in
                nvme*) mi_p1="${mi_n}p1" ;;
                *)     mi_p1="${mi_n}1" ;;
            esac
            if [ -d "$mi_d/$mi_p1" ] && [ -f "$mi_d/$mi_p1/dev" ]; then
                mi_mm=$(cat "$mi_d/$mi_p1/dev")
                mknod "/dev/$mi_p1" b "${mi_mm%:*}" "${mi_mm#*:}" 2>/dev/null
                mi_esp="/dev/$mi_p1"
                mi_sz=$(cat "$mi_d/$mi_p1/size" 2>/dev/null)
                break
            fi
        done
    fi
    [ -n "$mi_esp" ] || return 0
    case "$mi_sz" in
        ''|*[!0-9]*) mi_seek=8191 ;;
        *) mi_seek=$(( mi_sz / 8 - 1 )) ;;
    esac
    printf 'STAGEXBOOT %s\n' "$1" | dd of="$mi_esp" bs=4096 seek="$mi_seek" conv=notrunc 2>/dev/null
    sync 2>/dev/null
    return 0
}

mark "initramfs-start"

echo "initramfs: waiting for block devices..."
mark "waiting-for-dev"

# Wait for the block device node to appear in /dev
i=0
while [ $i -lt 15 ]; do
    if [ -b /dev/sda2 ] || [ -b /dev/vda2 ] || [ -b /dev/hda2 ] || [ -b /dev/nvme0n1p2 ] || [ -b /dev/xvda2 ]; then
        break
    fi
    i=$((i + 1))
    sleep 1
done

# Find the second partition from the first disk in /sys/block/
# Prefer NVMe on EC2, fall back to other block devices
SYSTEM_DEV=""
for dev in /sys/block/nvme* /sys/block/sd* /sys/block/vd* /sys/block/xvd*; do
    [ -d "$dev" ] || continue
    devname=${dev##*/}
    # NVMe uses nvme0n1p2 (with 'p' prefix), others use sda2
    case "$devname" in
        nvme*) part2="${devname}p2" ;;
        *)     part2="${devname}2" ;;
    esac
    if [ -d "$dev/$part2" ]; then
        SYSTEM_DEV="/dev/$part2"
        if [ ! -b "$SYSTEM_DEV" ] && [ -f "$dev/$part2/dev" ]; then
            MAJOR_MINOR=$(cat "$dev/$part2/dev")
            MAJOR=${MAJOR_MINOR%:*}
            MINOR=${MAJOR_MINOR#*:}
            mknod "$SYSTEM_DEV" b "$MAJOR" "$MINOR"
        fi
        break
    fi
done

if [ -z "$SYSTEM_DEV" ]; then
    echo "initramfs: ERROR: no system partition found" >&2
    mark "fail-no-sys-part"
    exec /bin/sh
fi

mark "found-sys-part $SYSTEM_DEV"

echo "initramfs: mounting $SYSTEM_DEV as erofs..."

# Mount the erofs system image
mount -t erofs -o ro "$SYSTEM_DEV" /mnt || {
    echo "initramfs: ERROR: failed to mount $SYSTEM_DEV" >&2
    mark "fail-mount-erofs"
    exec /bin/sh
}

mark "mounted-erofs"

echo "initramfs: switching to new root..."

# Use pivot_root to switch to the new root
# Prepare old root mount point inside the new root
mkdir -p /mnt/oldroot
pivot_root /mnt /mnt/oldroot || { mark "fail-pivot"; exec /bin/sh; }

mark "before-exec-init"

# Hand over to the real init
exec /init
