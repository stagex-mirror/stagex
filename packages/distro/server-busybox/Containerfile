FROM stagex/core-busybox AS core-busybox
FROM stagex/core-musl AS core-musl
FROM stagex/core-filesystem AS core-filesystem
FROM stagex/core-zlib AS core-zlib
FROM stagex/core-xz AS core-xz
FROM stagex/core-libzstd AS core-libzstd
FROM stagex/user-cpio AS user-cpio
FROM stagex/user-linux-server AS user-linux-server
FROM stagex/box-grub AS box-grub
FROM stagex/user-openssh AS user-openssh
FROM stagex/core-openssl AS core-openssl
FROM stagex/user-tmux AS user-tmux
FROM stagex/core-ncurses AS core-ncurses
FROM stagex/core-bash AS core-bash
FROM stagex/core-llvm AS core-llvm
FROM stagex/core-libunwind AS core-libunwind
FROM stagex/core-libffi AS core-libffi
FROM stagex/core-sqlite3 AS core-sqlite3
FROM stagex/user-dhcpcd AS user-dhcpcd
FROM stagex/user-eudev AS user-eudev
FROM stagex/user-util-linux AS user-util-linux
FROM stagex/user-libslirp AS user-libslirp
FROM stagex/user-libseccomp AS user-libseccomp
FROM stagex/user-libaio AS user-libaio
FROM stagex/user-dtc AS user-dtc
FROM stagex/user-lzo AS user-lzo
FROM stagex/user-numactl AS user-numactl
FROM stagex/user-glib AS user-glib
FROM stagex/user-tpm2-tools AS user-tpm2-tools
FROM stagex/user-tpm2-tss AS user-tpm2-tss
FROM stagex/user-libtpms AS user-libtpms
FROM stagex/user-swtpm AS user-swtpm

# --- Stage 1: base ---
# Minimal /rootfs — busybox + filesystem, just enough for a shell
FROM scratch AS base
COPY --from=core-busybox . rootfs
COPY --from=core-musl . rootfs
COPY --from=core-filesystem . rootfs
COPY --from=core-zlib . rootfs
COPY --from=core-xz . rootfs
COPY --from=core-libzstd . rootfs

# --- Stage 2: dev ---
# Extended /rootfs — adds sshd, tpm2 tools, and config/tools
FROM base AS dev
COPY --from=core-openssl . rootfs
COPY --from=user-openssh . rootfs
COPY --from=user-tpm2-tools . rootfs
COPY --from=user-tpm2-tss . rootfs
COPY --from=user-tmux . rootfs
COPY --from=core-ncurses . rootfs
COPY --from=core-bash . rootfs
COPY --from=user-dhcpcd . rootfs
COPY --from=user-eudev . rootfs
COPY --from=user-util-linux . rootfs
COPY --from=core-llvm /usr/lib/. rootfs/usr/lib/
COPY --from=core-libunwind . rootfs
COPY --from=core-libffi . rootfs
COPY --from=core-sqlite3 . rootfs
COPY --from=user-libslirp . rootfs
COPY --from=user-libseccomp . rootfs
COPY --from=user-libaio . rootfs
COPY --from=user-dtc . rootfs
COPY --from=user-lzo . rootfs
COPY --from=user-numactl . rootfs
COPY --from=user-glib . rootfs
COPY --from=core-libzstd . rootfs
COPY --from=core-zlib . rootfs
COPY src/rootfs/ rootfs

# --- Stage 3: system ---
# Takes base /rootfs + kernel + grub → system.img
FROM base AS system
COPY --from=box-grub . /
COPY --from=user-linux-server /bzImage rootfs/boot/vmlinuz
COPY src/config/grub.cfg rootfs/boot/grub/grub.cfg
RUN <<-EOF
	set -eux
	cd rootfs
	find . -exec touch -hcd "@0" "{}" +
	find . -print0 | sort -z | cpio --null --create --format=newc | gzip --best > boot/initramfs
	/usr/bin/box
EOF

# --- Stage 4: system-dev ---
# Takes dev /rootfs + kernel + grub → system-dev.img
FROM dev AS system-dev
COPY --from=box-grub . /
COPY --from=user-linux-server /bzImage rootfs/boot/vmlinuz
COPY src/config/grub.cfg rootfs/boot/grub/grub.cfg
RUN <<-EOF
	set -eux
	cd rootfs
	find . -exec touch -hcd "@0" "{}" +
	find . -print0 | sort -z | cpio --null --create --format=newc | gzip --best > boot/initramfs
	/usr/bin/box
EOF

# --- Stage 5: package ---
# Runtime image that boots the base system.img
FROM stagex/service-qemu AS package
COPY --from=system /disk.img /disk.img
COPY src/qemu-startup.sh /usr/bin/qemu-startup.sh
COPY src/run /usr/bin/run
RUN chmod +x /usr/bin/qemu-startup.sh /usr/bin/run
ENTRYPOINT ["/usr/bin/qemu-startup.sh"]

# --- Stage 6: package-dev ---
# Runtime image that boots the extended system-dev.img
FROM stagex/service-qemu AS package-dev
COPY --from=system-dev /disk.img /disk.img
COPY --from=user-openssh . /
COPY src/qemu-startup.sh /usr/bin/qemu-startup.sh
COPY src/run /usr/bin/run
RUN chmod +x /usr/bin/qemu-startup.sh /usr/bin/run
ENTRYPOINT ["/usr/bin/qemu-startup.sh"]
