#!/bin/sh
DAEMON="sshd"
PIDFILE="/var/run/$DAEMON.pid"

# Ensure dynamic linker can find libraries
export LD_LIBRARY_PATH="/usr/lib:/lib:${LD_LIBRARY_PATH}"
ldconfig 2>/dev/null || true

[ -f /usr/bin/ssh-keygen ] || exit 0

umask 077

start() {
	/bin/mkdir -p /etc/ssh
	/bin/chmod 755 /etc/ssh
	/usr/bin/ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" 2>/dev/null || true
	/usr/bin/ssh-keygen -t rsa -b 3072 -f /etc/ssh/ssh_host_rsa_key -N "" 2>/dev/null || true
	printf "Starting %s: " "$DAEMON"
	start-stop-daemon --start --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Stopping sshd: "
	start-stop-daemon --stop --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	while [ -f "$PIDFILE" ]; do
		sleep 0.1
	done
	return "$status"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit $?
