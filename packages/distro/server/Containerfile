# --- Shared base with build tools ---
FROM scratch AS base
COPY --from=core-busybox . /
COPY --from=core-musl . /
COPY --from=core-xz . /
COPY --from=core-zlib . /
COPY --from=user-cpio . /

# --- Stage 1: build ---
# Assembles /rootfs with kernel, init, packages, and config
FROM base AS build
ARG USERNAME=user
ARG HOSTNAME=sxos
ARG AUTHORIZED_KEYS=empty
COPY authorized_keys /
COPY --from=user-openssh . /
COPY --from=core-openssl . /
COPY --from=core-filesystem . rootfs
COPY --from=user-linux-server /bzImage rootfs/boot/vmlinuz
COPY --from=core-busybox . rootfs
COPY --from=user-eudev . rootfs
COPY --from=core-musl . rootfs
COPY --from=core-zlib . rootfs
COPY --from=user-npth . rootfs
COPY --from=user-libksba . rootfs
COPY --from=core-bash . rootfs
COPY --from=user-flashtools . rootfs
COPY --from=core-curl . rootfs
COPY --from=user-tpm2-tools . rootfs
COPY --from=user-tpm2-tss . rootfs
COPY --from=core-openssl . rootfs
COPY --from=user-libusb . rootfs
COPY --from=user-ccid . rootfs
COPY --from=user-pcsc-lite . rootfs
COPY --from=user-pcsc-tools . rootfs
COPY --from=user-libqrencode . rootfs
COPY --from=core-gmp . rootfs
COPY --from=core-libunwind . rootfs
COPY --from=user-opensc . rootfs
COPY --from=user-util-linux . rootfs
COPY --from=core-llvm /usr/lib/. rootfs/usr/lib/
COPY --from=core-sqlite3 . rootfs
COPY --from=user-libslirp . rootfs
COPY --from=user-glib . rootfs
COPY --from=user-numactl . rootfs
COPY --from=core-libzstd . rootfs
COPY --from=core-zlib . rootfs
COPY --from=user-lzo . rootfs
COPY --from=user-dtc . rootfs
COPY --from=user-libaio . rootfs
COPY --from=user-libseccomp . rootfs
COPY --from=core-libffi . rootfs
COPY --from=core-libzstd . rootfs
COPY --from=core-zlib . rootfs
COPY --from=core-ncurses . rootfs
COPY --from=user-tmux . rootfs
COPY --from=user-dhcpcd . rootfs
COPY --from=user-openssh . rootfs
COPY --from=core-openssl . rootfs
COPY --from=core-zlib . rootfs
COPY src/rootfs/ rootfs
COPY --from=core-bash . rootfs
RUN <<-EOF
	set -eux
	cd rootfs
	sed -i 's/\$USERNAME/'$USERNAME'/g' etc/inittab
	sed -i 's/\$HOSTNAME/'$HOSTNAME'/g' etc/inittab
	echo "$HOSTNAME" > etc/hostname
	rm -rf home/user
	sed -i '/^user:/d' etc/passwd
	echo "$USERNAME:x:1000:1000:$USERNAME:/home/$USERNAME:/bin/bash" >> etc/passwd
	sed -i '/^user:/d' etc/group
	echo "$USERNAME:x:1000:" >> etc/group
	sed -i '/^docker:/d' etc/group
	echo "docker:x:993:$USERNAME" >> etc/group
	mkdir -p home/$USERNAME
	chown -R 1000:1000 home/$USERNAME
	if [ "$AUTHORIZED_KEYS" != "empty" ] && [ -s /authorized_keys ]; then
		mkdir -p home/$USERNAME/.ssh
		cp /authorized_keys home/$USERNAME/.ssh/authorized_keys
		chmod 700 home/$USERNAME/.ssh
		chmod 600 home/$USERNAME/.ssh/authorized_keys
	fi
	chown -R 1000:1000 home/$USERNAME
	/usr/bin/ssh-keygen -t ed25519 -f ../ssh_host_key -N "" -q
	mkdir -p root/.ssh
	cat ../ssh_host_key.pub > root/.ssh/authorized_keys
	chmod 700 root/.ssh
	chmod 600 root/.ssh/authorized_keys
    chown -R root:root root/
	find . -exec touch -hcd "@0" "{}" +
	find . -print0 \
	| sort -z \
	| cpio \
		--null \
		--create \
		--verbose \
		--format=newc \
	| gzip --best \
	> ../initramfs
	find . -print0 \
	| sort -z \
	| cpio \
		--null \
		--create \
		--format=newc \
	| gzip --best \
	> boot/initramfs
EOF

# --- Stage 2: box ---
# Uses box-grub to assemble /rootfs into /disk.img
FROM base AS box
COPY --from=box-grub . /
COPY --from=build /rootfs rootfs
COPY --from=build /initramfs rootfs/boot/initramfs
COPY src/config/grub.cfg rootfs/boot/grub/grub.cfg
RUN /usr/bin/box

# --- Stage 3: package ---
# Runtime image that boots the disk image
FROM stagex/service-qemu AS package
COPY --from=openssh-client . /
COPY --from=box /disk.img /disk.img
COPY --from=build /ssh_host_key /ssh_host_key
COPY src/qemu-startup.sh /usr/bin/qemu-startup.sh
COPY src/run /usr/bin/run
RUN chmod +x /usr/bin/qemu-startup.sh /usr/bin/run && chmod 600 /ssh_host_key
ENTRYPOINT ["/usr/bin/qemu-startup.sh"]

# --- Stage 4: package-dev ---
# Same as package; -dev variant for consistency with distro naming convention
FROM stagex/service-qemu AS package-dev
COPY --from=openssh-client . /
COPY --from=box /disk.img /disk.img
COPY --from=build /ssh_host_key /ssh_host_key
COPY src/qemu-startup.sh /usr/bin/qemu-startup.sh
COPY src/run /usr/bin/run
RUN chmod +x /usr/bin/qemu-startup.sh /usr/bin/run && chmod 600 /ssh_host_key
ENTRYPOINT ["/usr/bin/qemu-startup.sh"]
