#!/usr/bin/sh
# box-grub — assembles kernel + initramfs + GRUB config into /boot.img (FAT32 ESP)
set -eux

# --- Inputs ---
KERNEL="${KERNEL:-/vmlinuz}"
GRUB_CFG="${GRUB_CFG:-/grub.cfg}"
HOSTNAME="${HOSTNAME:-stagex}"
INITRAMFS="${INITRAMFS:-/initramfs}"

# --- Output ---
BOOT_IMG="/boot.img"
BOOT_IMG_SIZE="${BOOT_IMG_SIZE:-512}"

# --- Prepare ESP layout ---
ESP="/esp"
rm -rf "$ESP"
mkdir -p "$ESP/EFI/BOOT" "$ESP/boot/grub"

# Copy kernel
if [ -f "$KERNEL" ]; then
    cp "$KERNEL" "$ESP/boot/vmlinuz"
else
    echo "WARNING: kernel not found at $KERNEL"
fi

# Copy initramfs (optional — skip if absent)
if [ -f "$INITRAMFS" ]; then
    cp "$INITRAMFS" "$ESP/boot/initramfs"
fi

# Copy or generate grub config
if [ -f "$GRUB_CFG" ]; then
    cp "$GRUB_CFG" "$ESP/boot/grub/grub.cfg"
else
    cat > "$ESP/boot/grub/grub.cfg" <<-EOF
set timeout=2
menuentry "Linux Stagex" {
    echo "Loading kernel..."
    linux /boot/vmlinuz ro init=/init hostname=$HOSTNAME
    initrd /boot/initramfs
    echo "Booting..."
}
EOF
fi

# --- Build GRUB EFI image ---
cat > grub_early.cfg <<-EOF
configfile /boot/grub/grub.cfg
EOF

grub-mkimage \
    --config="grub_early.cfg" \
    --prefix="/boot/grub" \
    --output="$ESP/EFI/BOOT/BOOTX64.EFI" \
    --format="x86_64-efi" \
    --compression="xz" \
    all_video \
    disk \
    part_gpt \
    part_msdos \
    squash4 \
    linux \
    tpm \
    boot \
    echo \
    normal \
    configfile \
    search \
    search_label \
    efi_gop \
    fat \
    gzio \
    zstd \
    serial \
    terminal \
    loadenv

# --- Create boot.img (FAT32) ---
# Size: 512MB (UEFI spec minimum for x64 is 100MB; 512MB matches AWS AMIs)
dd if=/dev/zero of="$BOOT_IMG" bs=1M count="$BOOT_IMG_SIZE"

# mformat picks FAT16 for this size; force FAT32 like a standard 512MB ESP
busybox mkfs.vfat -F 32 -S 512 -s $(( BOOT_IMG_SIZE * 2048 )) "$BOOT_IMG" >/dev/null

# Pre-create the GRUB env block (SEV-SNP boot marker target, see grub.cfg)
grub-editenv "$ESP/boot/env" create

if [ "${TREE_ONLY:-0}" = "1" ]; then
    # Leave the ESP tree in place: /boot = the ESP's boot/ tree, /efi = the
    # ESP's EFI/ tree. For distros that pack boot.img later from the live
    # layout (box-disk).
    rm -rf /boot /efi
    mv "$ESP/boot" /boot
    mv "$ESP/EFI" /efi
    rm -rf "$ESP" grub_early.cfg
    echo "ESP tree left at /boot + /efi"
else
    # --- Create boot.img (FAT32) ---
    # Size: 512MB (UEFI spec minimum for x64 is 100MB; 512MB matches AWS AMIs)
    dd if=/dev/zero of="$BOOT_IMG" bs=1M count="$BOOT_IMG_SIZE"

    # mformat picks FAT16 for this size; force FAT32 like a standard 512MB ESP
    busybox mkfs.vfat -F 32 -S 512 -s $(( BOOT_IMG_SIZE * 2048 )) "$BOOT_IMG" >/dev/null

    mcopy -i "$BOOT_IMG" -sm "$ESP/EFI" ::EFI
    mcopy -i "$BOOT_IMG" -sm "$ESP/boot" ::boot

    # Cleanup
    rm -rf "$ESP"
    rm -f grub_early.cfg
    echo "boot.img created: $(du -h "$BOOT_IMG" | cut -f1)"
fi
