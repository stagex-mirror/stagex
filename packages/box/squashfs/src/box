#!/usr/bin/sh
# box-squashfs — compresses a directory into a labeled squashfs image
set -eux

ROOTFS="${ROOTFS:-/rootfs}"
OUTPUT="${OUTPUT:-/system.img}"
LABEL="${LABEL:-}"

# Ensure mount point directories exist (may be stripped from empty dirs in squashfs)
mkdir -p "$ROOTFS/proc" "$ROOTFS/sys" "$ROOTFS/dev" "$ROOTFS/tmp" "$ROOTFS/mnt"

# Create .keep files to ensure empty mount point dirs survive mksquashfs
touch "$ROOTFS/proc/.keep" "$ROOTFS/sys/.keep" "$ROOTFS/dev/.keep" "$ROOTFS/tmp/.keep" "$ROOTFS/mnt/.keep"

# Build squashfs image
if [ -n "$LABEL" ]; then
	mksquashfs "$ROOTFS" "$OUTPUT" -comp gzip -noappend -processors $(nproc 2>/dev/null || echo 1) -label "$LABEL"
else
	mksquashfs "$ROOTFS" "$OUTPUT" -comp gzip -noappend -processors $(nproc 2>/dev/null || echo 1)
fi

echo "$OUTPUT created: $(du -h "$OUTPUT" | cut -f1)"
