#!/bin/sh
# box — uploads disk image to S3, imports as snapshot, registers AMI
set -eux

# --- Inputs (env vars) ---
AMI_NAME="${AMI_NAME:?required: name for the resulting AMI}"
AWS_REGION="${AWS_REGION:?required: AWS region}"
DISK_IMAGE="${DISK_IMAGE:-/disk.img}"

echo "=== aws-ami box ===" >&2
echo "  region:      $AWS_REGION" >&2
echo "  name:        $AMI_NAME" >&2
echo "  disk_image:  $DISK_IMAGE" >&2
echo "" >&2

# Validate disk image exists
if [ ! -f "$DISK_IMAGE" ]; then
    echo "ERROR: $DISK_IMAGE not found"
    exit 1
fi

# Create /run directory if needed
mkdir -p /run

# Write OpenTofu variables
cat > /run/aws-ami.tfvars <<EOF
ami_name   = "${AMI_NAME}"
region     = "${AWS_REGION}"
disk_image = "${DISK_IMAGE}"
EOF

# Run OpenTofu
cd /default
tofu init -input=false >/dev/null 2>&1

# Apply (suppress all output)
tofu apply -auto-approve -var-file=/run/aws-ami.tfvars -no-color >/dev/null 2>/dev/null

# Output tfvars for downstream consumption
tofu output -no-color
