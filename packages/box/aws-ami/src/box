#!/usr/bin/sh
# box — creates S3 bucket, uploads /system.img, imports to EC2, returns AMI ID
set -eux

# --- Inputs (env vars) ---
AWS_BUCKET="${AWS_BUCKET:?required: S3 bucket base name}"
AWS_REGION="${AWS_REGION:?required: AWS region}"
AMI_NAME="${AMI_NAME:?required: name for the resulting AMI}"
SYSTEM_IMG="${SYSTEM_IMG:-/system.img}"

# --- Validate ---
if [ ! -f "$SYSTEM_IMG" ]; then
    echo "ERROR: $SYSTEM_IMG not found"
    exit 1
fi

echo "=== aws-ami box ==="
echo "  image:  $SYSTEM_IMG"
echo "  bucket: $AWS_BUCKET"
echo "  region: $AWS_REGION"
echo "  name:   $AMI_NAME"
echo ""

# Write OpenTofu variables
cat > /run/aws-ami.tfvars <<EOF
ami_name   = "${AMI_NAME}"
region     = "${AWS_REGION}"
image_path = "${SYSTEM_IMG}"
bucket_name = "${AWS_BUCKET}"
EOF

# Run OpenTofu (single shot: init + apply)
cd /default
tofu init -input=false
tofu apply -auto-approve -var-file=/run/aws-ami.tfvars
