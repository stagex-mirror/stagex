#!/usr/bin/sh
# box-gpt — assembles boot.img + system.img into GPT disk.img
set -eux

BOOT_IMG="${BOOT_IMG:-/boot.img}"
SYSTEM_IMG="${SYSTEM_IMG:-/system.img}"
DISK="${DISK:-/disk.img}"

# Deterministic disk GUID → PARTUUID = <disk-GUID>-0002
DISK_GUID="72c48e5a-b7a4-4b16-8a86-87c14f9e8d20"
SYSTEM_PARTUUID="${DISK_GUID}-0002"

# Calculate total size with alignment padding (add 16MB for GPT overhead)
BOOT_SIZE=$(du -k "$BOOT_IMG" | cut -f1)
SYSTEM_SIZE=$(du -k "$SYSTEM_IMG" | cut -f1)
TOTAL_KB=$((BOOT_SIZE + 1024 + SYSTEM_SIZE + 1024 + 2048 + 16384))
TOTAL_MB=$(( (TOTAL_KB + 1023) / 1024 ))

# Create empty disk
dd if=/dev/zero of="$DISK" bs=1M count="$TOTAL_MB"

# Create GPT partition table with deterministic disk GUID using sfdisk
sfdisk "$DISK" <<EOF
label: gpt
label-id: ${DISK_GUID}
device: ${DISK}

${DISK}1 : size=64M, type=C12A7328-F81F-11D2-BA4B-00A0C905CAF0
${DISK}2 : type=0FC63DAF-8483-4772-8E79-3D69D8477DE4
EOF

# Calculate partition offsets
ESP_OFFSET=1
SYSTEM_OFFSET=65

# Copy boot.img to ESP partition
dd if="$BOOT_IMG" of="$DISK" bs=1M seek="$ESP_OFFSET" conv=notrunc

# Copy system.img to system partition
dd if="$SYSTEM_IMG" of="$DISK" bs=1M seek="$SYSTEM_OFFSET" conv=notrunc

echo "disk.img created: $(du -h "$DISK" | cut -f1)"
echo "system PARTUUID: $SYSTEM_PARTUUID"
