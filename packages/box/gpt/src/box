#!/bin/sh
# box-gpt — assembles boot.img (+ optional system.img) into GPT disk.img
#
# Normal:   boot.img (ESP) + system.img (erofs) → 2-partition GPT
# ESP-only: boot.img (ESP) only → 1-partition GPT. Used by the unikernel
#           scheme, where the OS lives in the UKI's initrd (in RAM) so no
#           system partition is needed and disk storage is optional.
set -eux

BOOT_IMG="${BOOT_IMG:-/boot.img}"
SYSTEM_IMG="${SYSTEM_IMG:-}"
DISK="${DISK:-/disk.img}"

# Deterministic disk GUID → PARTUUID = <disk-GUID>-0002
DISK_GUID="72c48e5a-b7a4-4b16-8a86-87c14f9e8d20"

# ESP is always partition 1 at 1MB (LBA 2048); sized by box-disk to fit the UKI
ESP_MB=$(( ( $(stat -c %s "$BOOT_IMG") + 1048575 ) / 1048576 ))

if [ -n "$SYSTEM_IMG" ]; then
	# Normal: ESP + erofs system partition
	SYSTEM_SIZE=$(du -k "$SYSTEM_IMG" | cut -f1)
	TOTAL_KB=$(( ESP_MB*1024 + 1024 + SYSTEM_SIZE + 1024 + 2048 ))
	TOTAL_MB=$(( (TOTAL_KB + 1023) / 1024 ))
	dd if=/dev/zero of="$DISK" bs=1M count="$TOTAL_MB"
	sfdisk "$DISK" <<EOF
label: gpt
label-id: ${DISK_GUID}
device: ${DISK}

${DISK}1 : size=${ESP_MB}M, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
${DISK}2 : type=0FC63DAF-8483-4772-8E79-3D69D8477DE4
EOF
	dd if="$BOOT_IMG" of="$DISK" bs=1M seek=1 conv=notrunc
	dd if="$SYSTEM_IMG" of="$DISK" bs=1M seek=$((ESP_MB+1)) conv=notrunc
	echo "system PARTUUID: ${DISK_GUID}-0002"
else
	# ESP-only (unikernel): the OS is in the UKI initrd, disk is just the ESP
	# + 1MiB tail for the alternate GPT header
	TOTAL_MB=$(( ESP_MB + 2 ))
	dd if=/dev/zero of="$DISK" bs=1M count="$TOTAL_MB"
	sfdisk "$DISK" <<EOF
label: gpt
label-id: ${DISK_GUID}
device: ${DISK}

${DISK}1 : size=${ESP_MB}M, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
EOF
	dd if="$BOOT_IMG" of="$DISK" bs=1M seek=1 conv=notrunc
fi

echo "disk.img created: $(du -h "$DISK" | cut -f1)"
