FROM stagex/core-busybox AS core-busybox
FROM stagex/core-musl AS core-musl
FROM stagex/core-xz AS core-xz
FROM stagex/core-zlib AS core-zlib
FROM stagex/core-libzstd AS core-libzstd
FROM stagex/core-ncurses AS core-ncurses
FROM stagex/core-tar AS core-tar
FROM stagex/user-mtools AS user-mtools
FROM stagex/user-util-linux AS user-util-linux
FROM stagex/user-dosfstools AS user-dosfstools
FROM stagex/user-erofs-utils AS user-erofs-utils
FROM stagex/box-uki AS box-uki
FROM stagex/box-erofs AS box-erofs
FROM stagex/box-gpt AS box-gpt
FROM stagex/user-nit AS user-nit

FROM scratch AS package
COPY --from=core-busybox . /
COPY --from=core-musl . /
COPY --from=core-xz . /
COPY --from=core-zlib . /
COPY --from=core-libzstd . /
COPY --from=core-ncurses . /
COPY --from=user-mtools . /
COPY --from=user-util-linux . /
COPY --from=user-dosfstools . /
COPY --from=user-erofs-utils . /
COPY --from=box-uki . /
COPY --from=box-uki /usr/bin/box /usr/bin/box-uki
COPY --from=box-erofs /usr/bin/box /usr/bin/box-erofs
COPY --from=box-gpt /usr/bin/box /usr/bin/box-gpt
# The nit init binary for the unikernel initramfs (copied in as /init by
# box-disk; kept under /nit so it doesn't shadow box-disk's applets)
COPY --from=user-nit /usr/bin/nit /nit/init
# GNU tar: box-erofs needs --null -T - to archive in sorted order (busybox
# tar has no file-list input and recurses in readdir() order instead).
# Named tar.gnu: BuildKit COPY follows a symlink at the destination, so
# copying over /usr/bin/tar (a busybox applet symlink -> /usr/bin/busybox)
# silently overwrites the busybox binary itself.
COPY --from=core-tar /usr/bin/tar /usr/bin/tar.gnu
COPY src/box /usr/bin/box
RUN chmod +x /usr/bin/box /usr/bin/box-uki /usr/bin/box-erofs /usr/bin/box-gpt /nit/init
ENTRYPOINT ["/usr/bin/box"]
