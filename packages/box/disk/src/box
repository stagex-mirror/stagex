#!/bin/sh
# box-disk — assembles a full GPT disk from a live layout
#
# Input: a live layout directory (LIVE, default /live) containing the
# rootfs contents plus the boot partition contents:
#   /boot  — kernel, initramfs, grub config (the ESP's boot/ tree)
#   /efi   — BOOTX64.EFI tree (the ESP's EFI/ tree)
#
# Output: /disk.img
#   partition 1: FAT32 ESP   — /efi -> ::EFI, /boot -> ::boot
#   partition 2: erofs root  — the live layout minus /boot and /efi
#
# Inner assembly is delegated: erofs packing runs box-erofs, GPT
# assembly runs box-gpt (both installed alongside this script).
set -eux

LIVE="${LIVE:-/live}"
BOOT_IMG="${BOOT_IMG:-/boot.img}"
SYSTEM_IMG="${SYSTEM_IMG:-/system.img}"
DISK="${DISK:-/disk.img}"
BOOT_IMG_SIZE="${BOOT_IMG_SIZE:-512}"

# --- boot.img: FAT32 ESP from /efi + /boot ---
dd if=/dev/zero of="$BOOT_IMG" bs=1M count="$BOOT_IMG_SIZE"
busybox mkfs.vfat -F 32 -S 512 -s $(( BOOT_IMG_SIZE * 2048 )) "$BOOT_IMG" >/dev/null
mcopy -i "$BOOT_IMG" -sm "$LIVE/efi" ::EFI
mcopy -i "$BOOT_IMG" -sm "$LIVE/boot" ::boot

# --- system.img: erofs of the live layout minus the boot partition ---
rm -rf /rootfs
cp -a "$LIVE" /rootfs
rm -rf /rootfs/boot /rootfs/efi
ROOTFS=/rootfs OUTPUT="$SYSTEM_IMG" box-erofs

# --- disk.img: GPT assembly ---
BOOT_IMG="$BOOT_IMG" SYSTEM_IMG="$SYSTEM_IMG" DISK="$DISK" box-gpt

rm -rf /rootfs
echo "disk.img created: $(du -h "$DISK" | cut -f1)"
