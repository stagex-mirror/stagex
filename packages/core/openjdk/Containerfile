FROM scratch AS build
ARG VERSION
ARG TARGETARCH
COPY --from=stagex/core-filesystem . /
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-bash . /
COPY --from=stagex/core-ncurses . /
COPY --from=stagex/core-llvm . /
COPY --from=stagex/core-mold . /
COPY --from=stagex/core-onetbb . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-pkgconf . /
COPY --from=stagex/core-libffi . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-linux-headers . /
COPY --from=stagex/core-openssl . /
COPY --from=stagex/core-python . /
COPY --from=stagex/core-samurai . /
COPY --from=stagex/core-sed . /
COPY --from=stagex/core-gawk . /
COPY --from=stagex/core-perl . /
COPY --from=stagex/core-autoconf . /
COPY --from=stagex/core-icedtea . /
COPY --from=stagex/core-jamvm . /
COPY --from=stagex/core-gcc6-java . /
# GCC 15 for HotSpot 8 compilation (same approach as icedtea/OpenJDK 7)
# clang miscompiles HotSpot's synchronizer.cpp at -O>0 on musl
COPY --from=stagex/core-gcc /usr/bin/gcc /usr/bin/real-gcc
COPY --from=stagex/core-gcc /usr/bin/g++ /usr/bin/real-g++
COPY --from=stagex/core-gcc /usr/lib/gcc /usr/lib/gcc
COPY --from=stagex/core-gcc /usr/libexec/gcc /usr/libexec/gcc
COPY --from=stagex/core-gcc /usr/include/c++ /usr/include/c++
COPY --from=stagex/core-gcc /usr/lib/libstdc++.so /usr/lib/gcc15/libstdc++.so
COPY --from=stagex/core-gcc /usr/lib/libstdc++.so.6 /usr/lib/gcc15/libstdc++.so.6
COPY --from=stagex/core-gcc /usr/lib/libstdc++.so.6.0.34 /usr/lib/gcc15/libstdc++.so.6.0.34
COPY --from=stagex/core-gcc /usr/lib/libgcc_s.so /usr/lib/gcc15/libgcc_s.so
COPY --from=stagex/core-gcc /usr/lib/libgcc_s.so.1 /usr/lib/gcc15/libgcc_s.so.1
COPY --from=stagex/core-binutils /usr/bin/as /usr/bin/as
COPY --from=stagex/core-isl /usr/lib/libisl.so.23 /usr/lib/libisl.so.23
COPY --from=stagex/core-mpfr /usr/lib/libmpfr.so.6 /usr/lib/libmpfr.so.6
COPY --from=stagex/core-mpc /usr/lib/libmpc.so.3 /usr/lib/libmpc.so.3
COPY --from=stagex/core-gmp /usr/lib/libgmp.so.10 /usr/lib/libgmp.so.10
COPY --from=stagex/core-libxml2 . /
COPY --from=stagex/core-libxslt . /
ENV SOURCE_DATE_EPOCH=1

COPY <<-'EOF' /etc/profile
	set -eu
	if [ "$TARGETARCH" = "amd64" ]; then export ARCH="x86_64"; fi
	if [ "$TARGETARCH" = "arm64" ]; then export ARCH="aarch64"; fi
EOF
SHELL ["/bin/sh","-l","-c"]

COPY patches/ /patches/
COPY setup-icedtea3.sh /tmp/setup-icedtea3.sh
COPY GenStubs-noop.java /tmp/GenStubs-noop.java
COPY build-icedtea3.sh /tmp/build-icedtea3.sh
COPY spp.sh /tmp/spp.sh
COPY jfr-stubs/ /tmp/jfr-stubs/
COPY fetch/patch-2.7.6.tar.xz /tmp/patch-2.7.6.tar.xz
COPY fetch/ecj-4.9.jar /usr/share/java/ecj-4.9.jar
ADD fetch/icedtea-3.38.0.tar.xz /
ADD fetch/xorgproto-2024.1.tar.xz /tmp/
COPY fetch/openjdk8-git.tar.xz /openjdk8-git.tar.xz

# Step 1: Setup + extract + patch + configure + apply all patches (cached)
RUN --network=none <<-'EOF'
	set -eu
	cd /icedtea-3.38.0
	sh /tmp/setup-icedtea3.sh
	export JAVA_HOME=/usr/lib/jvm/java-bootstrap
	export PATH=${JAVA_HOME}/bin:${PATH}
	mkdir -p stamps
	ln -sf /openjdk8-git.tar.xz openjdk-git.tar.xz
	touch stamps/download-openjdk.stamp stamps/download.stamp
	make stamps/extract-openjdk.stamp SHELL=/bin/bash > /dev/null 2>&1
	sed -i '/^stamps\/sanitise-openjdk.stamp/,/^\ttouch/{s/^\t[^t].*/\ttrue/}' Makefile
	sed -i '/^stamps\/sanitise.stamp/,/^\ttouch/{s/^\t[^t].*/\ttrue/}' Makefile
	# Apply IcedTea's bootstrap patches FIRST (makes langtools Java 7-compilable)
	cp -a openjdk openjdk-boot
	echo "=== Applying IcedTea patches ==="
	make stamps/patch-boot.stamp SHELL=/bin/bash > /tmp/patch-boot.log 2>&1 || {
		echo "=== patch-boot.stamp failed ==="
		tail -20 /tmp/patch-boot.log
		echo "=== Trying to apply patches manually ==="
		# IcedTea's Makefile applies patches from patches/ to openjdk-boot/
		for p in patches/boot/*.patch patches/openjdk-boot/*.patch; do
			[ -f "$p" ] || continue
			echo "Applying $p"
			(cd openjdk-boot && patch -p0 < "../$p") || true
		done
	}
	echo "=== IcedTea patch-boot complete ==="
	# Remove doclets .java sources from boot tree — they need JAXP but
	# we only need javac for bootstrap. Keep resources/properties files.
	find openjdk-boot/langtools/src -path '*/doclets/*.java' -delete 2>/dev/null || true
	find openjdk-boot/langtools/src -path '*/javadoc/*.java' -delete 2>/dev/null || true
	find openjdk-boot/langtools/src -path '*/com/sun/javadoc/*.java' -delete 2>/dev/null || true
	echo "Removed doclets+javadoc .java from boot langtools"
	# Remove JDK files that need optional features we don't have:
	# - newrmic: alternative RMI compiler (needs com.sun.javadoc)
	# - sun/awt/X11/*: needs auto-generated X11 wrapper classes (XEvent etc.)
	# - jndi corba toolkit: needs org.omg.CORBA classes
	# - jmx remote iiop: needs CORBA portable interfaces
	# - rmi/rmic/iiop: needs com.sun.corba classes
	# Delete the whole sun/rmi/rmic directory — depends on com.sun.javadoc and CORBA
	rm -rf openjdk-boot/jdk/src/share/classes/sun/rmi/rmic 2>/dev/null || true
	# Both Nimbus look-and-feel locations (auto-generated NimbusDefaults missing)
	rm -rf openjdk-boot/jdk/src/share/classes/javax/swing/plaf/nimbus 2>/dev/null || true
	rm -rf openjdk-boot/jdk/src/share/classes/com/sun/java/swing/plaf/nimbus 2>/dev/null || true
	# javax.sql.XAConnection needs javax.transaction.xa (separate optional package)
	rm -f openjdk-boot/jdk/src/share/classes/javax/sql/XAConnection.java 2>/dev/null || true
	rm -f openjdk-boot/jdk/src/share/classes/javax/sql/XADataSource.java 2>/dev/null || true
	# Delete X11 .java files but keep the generator subdir (Tools.gmk references it)
	find openjdk-boot/jdk/src/solaris/classes/sun/awt/X11 -maxdepth 1 -name '*.java' -delete 2>/dev/null || true
	rm -rf openjdk-boot/jdk/src/share/classes/com/sun/jndi/toolkit/corba 2>/dev/null || true
	# For these CORBA-dependent dirs, delete .java but keep .properties (referenced by gensrc)
	for d in com/sun/jndi/cosnaming com/sun/jndi/url/corbaname \
	         com/sun/jndi/url/iiopname com/sun/jndi/url/iiop; do
		find openjdk-boot/jdk/src/share/classes/$d -maxdepth 1 -name '*.java' -delete 2>/dev/null || true
	done
	rm -rf openjdk-boot/jdk/src/share/classes/com/sun/jmx/remote/protocol/iiop 2>/dev/null || true
	find openjdk-boot/jdk/src/share/classes/sun/rmi/rmic -name 'iiop' -type d -exec rm -rf {} + 2>/dev/null || true

	# Replace jvmtiGen.java with an xsltproc shim — OpenJDK 7's jaxp.jar is
	# missing javax.xml.transform so we can't use the original which uses JAXP.
	# The replacement parses -IN/-XSL/-OUT/-PARAM args and execs xsltproc.
	for f in $(find openjdk-boot -name 'jvmtiGen.java' -path '*/hotspot/*' 2>/dev/null); do
		cat > "$f" <<'JVMTIGEN'
import java.util.*;
public class jvmtiGen {
    public static void main(String[] args) throws Exception {
        String in = null, xsl = null, out = null;
        List<String> params = new ArrayList<String>();
        for (int i = 0; i < args.length; i++) {
            if (args[i].equals("-IN")) in = args[++i];
            else if (args[i].equals("-XSL")) xsl = args[++i];
            else if (args[i].equals("-OUT")) out = args[++i];
            else if (args[i].equals("-PARAM")) {
                // xsltproc expects param values to be XPath expressions; quote string literals
                String key = args[++i];
                String val = args[++i];
                params.add("--stringparam"); params.add(key); params.add(val);
            }
        }
        if (in == null || xsl == null || out == null) {
            System.err.println("usage: jvmtiGen -IN file -XSL file -OUT file [-PARAM key val]...");
            System.exit(1);
        }
        List<String> cmd = new ArrayList<String>();
        cmd.add("xsltproc"); cmd.add("--xinclude");
        cmd.addAll(params);
        cmd.add("-o"); cmd.add(out);
        cmd.add(xsl); cmd.add(in);
        Process p = new ProcessBuilder(cmd).inheritIO().start();
        System.exit(p.waitFor());
    }
}
JVMTIGEN
	done
	# Now apply our musl/build fixes on top
	find openjdk-boot openjdk -name 'autoconf-config.sub' -exec \
		sed -i 's/linux-uclibc\*/linux-musl* | linux-uclibc*/' {} \;
	find openjdk-boot openjdk -name 'autoconf-config.sub' -exec \
		sed -i 's/-linux-uclibc\*/-linux-musl* | -linux-uclibc*/' {} \;
	find openjdk-boot openjdk -name 'generated-configure.sh' -exec \
		sed -i 's/as_fn_error.*A .* compiler is required/echo "gcc check bypassed" #/' {} \;

	# Replace GenStubs with no-op
	find openjdk-boot -name 'GenStubs.java' -path '*/genstubs/*' -exec \
		cp /tmp/GenStubs-noop.java {} \;

	# Fix XML encoding for GNU Classpath parser
	find openjdk-boot openjdk \( -name '*.xml' -o -name '*.xsd' -o -name '*.xsl' \) \
		-exec sed -i 's/encoding="utf-8"/encoding="UTF-8"/g' {} + 2>/dev/null || true

# Disable JFR completely (GNU Classpath can't validate JFR XML schema)
	find openjdk-boot openjdk -name 'top.make' -path '*/hotspot/*' \
		-exec sed -i 's/jfr_stuff//' {} + 2>/dev/null || true
	# Disable JFR in generated-configure and configure output
	find openjdk-boot openjdk -name 'generated-configure.sh' \
		-exec sed -i 's/INCLUDE_JFR=true/INCLUDE_JFR=false/g' {} + 2>/dev/null || true
	# Disable JFR .cpp files in jfr/ directory (core JFR infrastructure)
	find openjdk-boot openjdk -path '*/hotspot/*/jfr/*.cpp' \
		-exec sh -c 'echo "// JFR disabled" > "$1"' _ {} \; 2>/dev/null || true
	# Empty specific JFR .hpp files that cause issues (template code)
	find openjdk-boot openjdk -name 'jfrFlush.hpp' -path '*/hotspot/*' \
		-exec sh -c 'echo "// JFR disabled" > "$1"' _ {} \; 2>/dev/null || true
	# GC/allocation tracers — replace with stub files from /tmp/jfr-stubs/
	for stub in /tmp/jfr-stubs/*.cpp; do
		name=$(basename "$stub")
		find openjdk-boot openjdk -name "$name" -path '*/hotspot/*' \
			-exec cp "$stub" {} \; 2>/dev/null || true
	done

	# Fix left-shift-of-negative (clang error in constant expressions)
	# IMPORTANT: use ~(uintptr_t)0 not ~0u — must be 64-bit on 64-bit systems
	find openjdk-boot openjdk \( -name '*.hpp' -o -name '*.cpp' -o -name '*.h' \) -path '*/hotspot/*' -exec \
		sed -i -e 's/(\(-1\)) *<</(~(uintptr_t)0) <</g' \
			-e 's/(\(-1\))<</(~(uintptr_t)0)<</g' \
			-e 's/~(\(-1\))/~(~(uintptr_t)0)/g' {} + 2>/dev/null || true

	# Disable SA (Serviceability Agent) completely
	find openjdk-boot openjdk -path '*/hotspot/agent/src/os/linux/*.c' \
		-exec sh -c 'echo "// SA disabled" > "$1"' _ {} \; 2>/dev/null || true
	find openjdk-boot openjdk -path '*/hotspot/agent/src/share/native/*.c' \
		-exec sh -c 'echo "// SA disabled" > "$1"' _ {} \; 2>/dev/null || true
	# Disable sa_stuff make target (rmic etc. not available in bootstrap)
	find openjdk-boot openjdk -name 'top.make' -path '*/hotspot/*' \
		-exec sed -i 's/sa_stuff//' {} + 2>/dev/null || true
	# Also skip SA native library build and create stub sa-jdi.jar
	find openjdk-boot openjdk -name 'sa.make' -path '*/hotspot/*' \
		-exec sh -c 'printf "all:\n\t@true\n.DEFAULT:\n\t@true\n" > "$1"' _ {} \; 2>/dev/null || true
	# Create stub libthread_db.a (musl doesn't have it)
	echo 'void __thread_db_stub(void) {}' | clang -c -x c - -o /tmp/thread_db.o
	ar rcs /usr/lib/libthread_db.a /tmp/thread_db.o

	# Create JDK include symlinks for compilation
	mkdir -p /usr/lib/jvm/java-bootstrap/include/linux
	find openjdk-boot -path '*/jdk/src/share/javavm/export/jni.h' -exec cp {} /usr/lib/jvm/java-bootstrap/include/ \; 2>/dev/null || true
	find openjdk-boot -path '*/jdk/src/share/javavm/export/jni_md.h' -exec cp {} /usr/lib/jvm/java-bootstrap/include/linux/ \; 2>/dev/null || true
	find openjdk-boot -path '*/jdk/src/solaris/javavm/export/jni_md.h' -exec cp {} /usr/lib/jvm/java-bootstrap/include/linux/ \; 2>/dev/null || true

	# musl: stub glibc-specific headers
	printf '#ifndef _THREAD_DB_H\n#define _THREAD_DB_H\ntypedef void* td_thragent_t;\ntypedef void* td_thrhandle_t;\ntypedef int td_err_e;\n#define TD_OK 0\n#endif\n' > /usr/include/thread_db.h
	printf '#ifndef _PROC_SERVICE_H\n#define _PROC_SERVICE_H\ntypedef void* ps_prochandle;\n#endif\n' > /usr/include/proc_service.h
	mkdir -p /usr/include/gnu
	printf 'static inline const char* gnu_get_libc_version(void) { return "musl"; }\nstatic inline const char* gnu_get_libc_release(void) { return "stable"; }\n' > /usr/include/gnu/libc-version.h
	printf '#ifndef _FPU_CONTROL_H\n#define _FPU_CONTROL_H\n#define _FPU_GETCW(cw) (cw=0)\n#define _FPU_SETCW(cw) do {} while(0)\ntypedef unsigned int fpu_control_t;\n#endif\n' > /usr/include/fpu_control.h

	# musl: SIGCLD -> SIGCHLD, __SIGRTMAX -> _NSIG (both HotSpot and JDK)
	find openjdk-boot openjdk -name 'jvm_linux.cpp' -path '*/hotspot/*' \
		-exec sed -i 's/SIGCLD/SIGCHLD/g' {} + 2>/dev/null || true
	find openjdk-boot openjdk \( -name '*.c' -o -name '*.h' \) -path '*/jdk/src/*' \
		-exec sed -i 's/__SIGRTMAX/_NSIG/g; s/SIGCLD/SIGCHLD/g' {} + 2>/dev/null || true
	# Fix incomplete siglabel array (musl doesn't define all signals)
	find openjdk-boot openjdk -name 'jvm_linux.cpp' -path '*/hotspot/*' \
		-exec sed -i '/sizeof(siglabel)/s/sizeof(siglabel)/sizeof(siglabel[0]) * 40/' {} + 2>/dev/null || true

	# musl: isnanf -> isnan (both HotSpot and JDK native code)
	find openjdk-boot openjdk -name 'globalDefinitions_gcc.hpp' -path '*/hotspot/*' \
		-exec sed -i 's/isnanf/isnan/g' {} + 2>/dev/null || true
	find openjdk-boot openjdk -name 'jdk_util_md.h' \
		-exec sed -i 's/isnanf/isnan/g' {} + 2>/dev/null || true

	# musl: *64 functions -> standard (musl is 64-bit native)
	find openjdk-boot openjdk \( -name '*.cpp' -o -name '*.hpp' -o -name '*.h' \) -path '*/hotspot/*' \
		-exec sed -i 's/::lseek64/::lseek/g; s/::ftruncate64/::ftruncate/g; s/stat64/stat/g; s/fstat64/fstat/g; s/mmap64/mmap/g; s/off64_t/off_t/g; s/open64/open/g' {} + 2>/dev/null || true
	# musl: *64 functions in JDK native code too (no \b — busybox sed)
	find openjdk-boot openjdk -path '*/jdk/src/*' \( -name '*.c' -o -name '*.h' \) \
		-exec sed -i 's/stat64/stat/g; s/lseek64/lseek/g; s/ftruncate64/ftruncate/g; s/mmap64/mmap/g; s/open64/open/g; s/off64_t/off_t/g; s/dirent64/dirent/g; s/readdir64/readdir/g' {} + 2>/dev/null || true
	# musl: dlvsym -> dlsym wrapper (dlvsym takes 3 args, dlsym takes 2)
	find openjdk-boot openjdk -name 'os_linux.cpp' -path '*/hotspot/*' \
		-exec sed -i '1i #define dlvsym(h,s,v) dlsym(h,s)' {} + 2>/dev/null || true

	# Fix forward references in JDK native code (clang requires declarations before use)
	# Add forward declarations for all JNIEXPORT functions at the top of each C file
	find openjdk-boot openjdk -path '*/jdk/src/*' -name '*.c' -exec sh -c '
		# Extract all JNIEXPORT function signatures from the file
		DECLS=$(awk "/^JNIEXPORT/{buf=\$0; while(buf !~ /\\{/) {getline; buf=buf \" \" \$0} sub(/\\{.*/, \";\", buf); print buf}" "$1" 2>/dev/null)
		if [ -n "$DECLS" ]; then
			# Find the last #include line and insert declarations after it
			LASTINC=$(grep -n "^#include" "$1" 2>/dev/null | tail -1 | cut -d: -f1)
			if [ -n "$LASTINC" ]; then
				{ head -n "$LASTINC" "$1"; echo "$DECLS"; tail -n +"$((LASTINC + 1))" "$1"; } > "$1.tmp" && mv "$1.tmp" "$1"
			fi
		fi
	' _ {} \; 2>/dev/null || true


	# Fix clang miscompilation of ObjectSynchronizer::inflate
	# Clang's optimizer merges the neutral/locked CAS paths incorrectly,
	# causing SIGSEGV when inflating a neutral mark word.
	# Add #pragma optimize("", off) at the top of synchronizer.cpp
	find openjdk-boot openjdk -name 'synchronizer.cpp' -path '*/hotspot/*' \
		-exec sed -i '1i #pragma clang optimize off' {} + 2>/dev/null || true

# Skip EquivMapsGenerator (fails on JamVM) — delete entire rule block
	find openjdk-boot openjdk -name 'GensrcLocaleDataMetaInfo.gmk' \
		-exec sed -i '/LocaleEquivalentMaps/,/^$/d' {} + 2>/dev/null || true

	# Skip gensrc tools that fail on JamVM/GNU Classpath
	# These tools need AWT, JAXB, CLDR converters etc. that don't work in bootstrap
	# Skip gensrc/gendata tools that fail on JamVM
	# Skip ALL gensrc/gendata tools that fail on JamVM (too many to enumerate)
	# Remove build tools that need JAXB/JAXP/javadoc (not available in bootstrap)
	for tool in generatenimbus cldrconverter swingbeaninfo; do
		find openjdk-boot -path "*/$tool/*.java" -delete 2>/dev/null || true
	done
	for gmk in GensrcIcons.gmk GensrcCLDR.gmk GensrcSwing.gmk GensrcX11Wrappers.gmk GensrcNimbus.gmk; do
		find openjdk-boot openjdk -name "$gmk" -path '*/jdk/*' \
			-exec sh -c 'printf "all:\n\t@true\n.DEFAULT:\n\t@true\n" > "$1"' _ {} \; 2>/dev/null || true
	done
	# Skip JDWP, AWT/2D, Sound — not needed for bootstrap
	for gmk in ServiceabilityLibraries.gmk Awt2dLibraries.gmk SoundLibraries.gmk; do
		find openjdk-boot openjdk -name "$gmk" -path '*/jdk/*' \
			-exec sh -c 'printf "all:\n\t@true\n.DEFAULT:\n\t@true\n" > "$1"' _ {} \; 2>/dev/null || true
	done
	# Skip gendata and genclasses (Java tools fail on JamVM)
	# IMPORTANT: use s///g not /d — don't delete lines that contain other targets
	find openjdk-boot openjdk -name 'BuildJdk.gmk' -exec \
		sed -i 's/gendata-only//g; s/genclasses-only//g' {} + 2>/dev/null || true
	# Make jar creation tolerant of missing class directories
	# The WARNING + exit comes from a path checking script
	find openjdk-boot openjdk -name 'CreateJars.gmk' -path '*/jdk/*' \
		-exec sed -i 's/exit 1/exit 0/g; s/&& exit/|| true \&\& exit/g' {} + 2>/dev/null || true
	# Also patch the jar setup macro to not fail on missing paths
	find openjdk-boot openjdk -name 'SetupJavaCompilation.gmk' -o -name 'MakeBase.gmk' -path '*/make/*' 2>/dev/null | \
		xargs sed -i 's/exit 1/exit 0/g' 2>/dev/null || true
	# Skip Nashorn (JavaScript engine) — nasgen tool needs full JDK
	find openjdk-boot openjdk -name 'Main.gmk' -path '*/make/*' -exec \
		sed -i 's/nashorn-only//g' {} + 2>/dev/null || true
	find openjdk-boot openjdk -name 'BuildNashorn.gmk' \
		-exec sh -c 'printf "all:\n\t@true\n.DEFAULT:\n\t@true\n" > "$1"' _ {} \; 2>/dev/null || true
	# Skip CORBA IDL processing in JDK phase (IDL compiler needs full JDK)
	find openjdk-boot openjdk -name 'BuildCorba.gmk' \
		-exec sh -c 'printf "all:\n\t@true\n.DEFAULT:\n\t@true\n" > "$1"' _ {} \; 2>/dev/null || true
	# Skip JAXWS (Web Services) — needs javax.activation (JAF classpath issue)
	# Not needed for bootstrap JDK
	find openjdk-boot openjdk -name 'BuildJaxws.gmk' \
		-exec sh -c 'printf "all:\n\t@true\n.DEFAULT:\n\t@true\n" > "$1"' _ {} \; 2>/dev/null || true
	# Also skip jaxws-only target in Main.gmk
	find openjdk-boot openjdk -name 'Main.gmk' -path '*/make/*' -exec \
		sed -i 's/jaxws-only//g' {} + 2>/dev/null || true
	# Skip JAXWS import in JDK (Import.gmk expects jaxws classes.jar)
	find openjdk-boot openjdk -name 'Import.gmk' -path '*/jdk/*' -exec \
		sed -i '/JAXWS.*import/d; /jaxws.*classes/d' {} + 2>/dev/null || true

	rm -f /openjdk8-git.tar.xz openjdk-git.tar.xz
	# Bypass javac checks in OpenJDK's internal configure (generated-configure.sh)
	find openjdk-boot openjdk -name 'generated-configure.sh' -exec sed -i \
		-e 's/as_fn_error.*diamond operator.*/echo "bypassed" #/' \
		-e 's/as_fn_error.*Compiler failed.*/echo "bypassed" #/' \
		-e 's/as_fn_error.*VM failed.*/echo "bypassed" #/' \
		-e 's/as_fn_error.*does not support.*/echo "bypassed" #/' \
		{} + 2>/dev/null || true
	echo "=== Running internal configure ==="
	make stamps/icedtea-boot-configure.stamp SHELL=/bin/bash 2>&1 | tail -30 || true
	if [ ! -f openjdk.build-boot/Makefile ]; then
		echo "=== INTERNAL CONFIGURE FAILED ==="
		grep -E 'error|Error' openjdk.build-boot/config.log 2>/dev/null | tail -20
		echo "=== config.log tail ==="
		tail -30 openjdk.build-boot/config.log 2>/dev/null
		exit 1
	fi
	echo "=== Setup + configure complete ==="
EOF

# Step 2: Build OpenJDK 8
RUN --network=none sh /tmp/build-icedtea3.sh

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

# Marker to bust containerd cache
