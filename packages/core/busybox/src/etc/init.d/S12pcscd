#!/bin/sh

case "$1" in
    start)
        /usr/sbin/pcscd -d || { echo "FAIL"; exit 1; }
        killall pcscd
        /usr/sbin/pcscd -d || { echo "FAIL"; exit 1; }
        echo "done"
        ;;
    stop)
        # Stop execution of events
        killall pcscd
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

exit 0
