#!/bin/sh
# S05cloud-init-drive — seed hostname + ssh keys from a no-cloud config drive
# Follows no-cloud datasource convention: user-data (cloud-config YAML)
# on a volume labeled "cidata" (ISO9660 or squashfs).

CONFIG_DRIVE="/tmp/cfg"
HOSTNAME_FILE="/run/hostname"
KEYS_FILE="/root/.ssh/authorized_keys"

set_hostname() {
	local h
	# Accept either a file path or a raw string value
	if [ -f "$1" ]; then
		h=$(head -1 "$1" | tr -d '\r\n ' | head -c 64)
	else
		h=$(printf '%s' "$1" | head -1 | tr -d '\r\n ' | head -c 64)
	fi
	[ -n "$h" ] || return 1
	hostname "$h"
	echo "$h" > "$HOSTNAME_FILE"
	return 0
}

seed_keys() {
	local src="$1"
	[ -f "$src" ] || return 1
	mkdir -p /root/.ssh
	cat "$src" > "$KEYS_FILE"
	chmod 600 "$KEYS_FILE"
	return 0
}

# Skip if hostname already set
[ -s "$HOSTNAME_FILE" ] && { printf "Cloud-init (drive): skip\n"; exit 0; }

# Look for a no-cloud config drive (any mountable block device)
mkdir -p "$CONFIG_DRIVE"
for dev in /dev/sr0 /dev/sda /dev/sdb /dev/xvdf /dev/vdb; do
	[ -e "$dev" ] || continue
	mount -t squashfs -o ro "$dev" "$CONFIG_DRIVE" 2>/dev/null && break
	mount -o ro "$dev" "$CONFIG_DRIVE" 2>/dev/null && break
done

if [ $? -ne 0 ]; then
	printf "Cloud-init (drive): no device\n"
	exit 0
fi

# --- Parse no-cloud user-data (cloud-config YAML subset) ---
UD="$CONFIG_DRIVE/user-data"
if [ -f "$UD" ]; then
	# hostname: single-line value
	H=$(grep -m1 '^[[:space:]]*hostname:' "$UD" | sed 's/^[[:space:]]*hostname:[[:space:]]*//' | tr -d '\r\n ')
	[ -n "$H" ] && set_hostname "$H"

	# ssh_authorized_keys: multi-line list
	KEYS="/tmp/cloud-keys"
	grep -q '^[[:space:]]*ssh_authorized_keys:' "$UD" && {
		# Extract everything after ssh_authorized_keys: until next top-level key
		awk '/^[[:space:]]*ssh_authorized_keys:/{found=1; next} found && /^[[:space:]]/{print} found && /^[a-zA-Z]/{exit}' "$UD" | \
			sed 's/^[[:space:]]*//' | \
			sed 's/^[|-][[:space:]]*//' | \
			tr -d '\r' > "$KEYS"
		[ -s "$KEYS" ] && seed_keys "$KEYS"
		rm -f "$KEYS"
	}

	# write_files: path, content (inline or block scalar |), permissions, owner, encoding
	awk '
BEGIN { in_wf = 0; idx = -1; in_block = 0; block_indent = 0 }

function write_entry(    dir, tmpfile, i, regex) {
	if (path == "") return
	tmpfile = "/tmp/cloud-tmp-" idx
	if (encoding == "b64" || encoding == "base64") {
		printf "%s", content > tmpfile; close(tmpfile)
	} else {
		sub(/\n$/, "", content)
		printf "%s\n", content > tmpfile; close(tmpfile)
	}
	dir = path; sub(/\/[^\/]*$/, "", dir)
	if (dir != path) system("mkdir -p " dir)
	if (encoding == "b64" || encoding == "base64") {
		system("base64 -d < " tmpfile " > " tmpfile ".d")
		system("mv " tmpfile ".d " path)
	} else {
		system("mv " tmpfile " " path)
	}
	if (perms != "") system("chmod " perms " " path)
	if (owner != "") system("chown " owner " " path)
	printf "S05: wrote %s\n", path
}

/^[[:space:]]*write_files:/ { in_wf = 1; next }
!in_wf { next }
/^[a-zA-Z]/ { in_wf = 0; next }
/^[[:space:]]*-[[:space:]]+path:/ {
	write_entry(); idx++; line = $0
	sub(/^[[:space:]]*-[[:space:]]+path:[[:space:]]*/, "", line)
	gsub(/^["'"'"']|["'"'"']$/, "", line)
	path = line; content = ""; perms = "0644"; owner = ""; encoding = ""
	in_block = 0; block_indent = 0; next
}
in_wf && idx >= 0 && /^[[:space:]]+content:[[:space:]]*\|/ {
	in_block = 1; content = ""; block_indent = 0; next
}
in_wf && in_block {
	line = $0
	if (block_indent == 0 && line !~ /^[[:space:]]*$/) {
		tmp = line; gsub(/[^ ].*/, "", tmp); block_indent = length(tmp)
	}
	if (line ~ /^[[:space:]]*$/) { content = content "\n"; next }
	tmp = line; gsub(/[^ ].*/, "", tmp)
	if (length(tmp) >= block_indent) {
		regex = "^"; for (i = 0; i < block_indent; i++) regex = regex " "
		sub(regex, "", line); content = content line "\n"; next
	}
	in_block = 0
	if (line ~ /^[[:space:]]+permissions:/) {
		sub(/^[[:space:]]+permissions:[[:space:]]*/, "", line)
		gsub(/^["'"'"']|["'"'"']$/, "", line); perms = line
	} else if (line ~ /^[[:space:]]+owner:/) {
		sub(/^[[:space:]]+owner:[[:space:]]*/, "", line)
		gsub(/^["'"'"']|["'"'"']$/, "", line); owner = line
	} else if (line ~ /^[[:space:]]+encoding:/) {
		sub(/^[[:space:]]+encoding:[[:space:]]*/, "", line)
		gsub(/^["'"'"']|["'"'"']$/, "", line); encoding = line
	}
	next
}
in_wf && idx >= 0 && !in_block && /^[[:space:]]+content:/ {
	line = $0; sub(/^[[:space:]]+content:[[:space:]]*/, "", line)
	gsub(/^["'"'"']|["'"'"']$/, "", line); content = line; next
}
in_wf && idx >= 0 && !in_block && /^[[:space:]]+permissions:/ {
	sub(/^[[:space:]]+permissions:[[:space:]]*/, ""); gsub(/^["'"'"']|["'"'"']$/, ""); perms = $0; next
}
in_wf && idx >= 0 && !in_block && /^[[:space:]]+owner:/ {
	sub(/^[[:space:]]+owner:[[:space:]]*/, ""); gsub(/^["'"'"']|["'"'"']$/, ""); owner = $0; next
}
in_wf && idx >= 0 && !in_block && /^[[:space:]]+encoding:/ {
	sub(/^[[:space:]]+encoding:[[:space:]]*/, ""); gsub(/^["'"'"']|["'"'"']$/, ""); encoding = $0; next
}
END { write_entry() }
' "$UD" 2>/dev/null
fi

# Legacy fallback: raw files (non-ISO volumes)
[ -z "$H" ] && set_hostname "$CONFIG_DRIVE/hostname"
[ ! -s "$KEYS_FILE" ] && seed_keys "$CONFIG_DRIVE/authorized_keys"

umount "$CONFIG_DRIVE" 2>/dev/null

printf "Cloud-init (drive): ok\n"
