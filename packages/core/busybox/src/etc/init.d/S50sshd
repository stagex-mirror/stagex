#!/bin/sh
DAEMON="tinysshd"
PIDFILE="/var/run/$DAEMON.pid"
KEYDIR="/run/tinyssh/keys"

ensure_host_key() {
	mkdir -p "$KEYDIR"
	chmod 700 "$KEYDIR"
	[ -f "$KEYDIR/host_key" ] || /usr/sbin/tinysshd-makekey "$KEYDIR"
}

sync_authorized_keys() {
	# Copy cloud-seeded authorized_keys to tinyssh key directory
	if [ -s /root/.ssh/authorized_keys ]; then
		cat /root/.ssh/authorized_keys >> "$KEYDIR/authorized_keys"
	fi
}

start() {
	ensure_host_key
	sync_authorized_keys

	[ -f "$KEYDIR/host_key" ] || { printf "Starting %s: " "$DAEMON"; echo "FAIL (no host key)"; return 1; }

	printf "Starting %s: " "$DAEMON"
	start-stop-daemon --start --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON" \
		-- -l -v "$KEYDIR"
	status=$?
	if [ "$status" = 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	start-stop-daemon --stop --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" = 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	while [ -f "$PIDFILE" ]; do
		sleep 0.1
	done
	return "$status"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit $?
