#!/bin/sh
DAEMON="sshd"
PIDFILE="/var/run/$DAEMON.pid"
KEYDIR="/etc/keys"

# Ensure dynamic linker can find libraries
export LD_LIBRARY_PATH="/usr/lib:/lib:${LD_LIBRARY_PATH}"
ldconfig 2>/dev/null || true

[ -f /usr/bin/ssh-keygen ] || exit 0

umask 077

ensure_keys() {
	# /etc/keys is tmpfs-mounted at boot — writable by design
	mkdir -p "$KEYDIR"
	chmod 700 "$KEYDIR"

	# Use /dev/urandom to avoid blocking on low entropy
	export SSH_KNOWN_HOSTS=/dev/null
	[ -f "$KEYDIR/ssh_host_ed25519_key" ] || \
		/usr/bin/ssh-keygen -t ed25519 -f "$KEYDIR/ssh_host_ed25519_key" -N "" >/dev/null 2>&1
	[ -f "$KEYDIR/ssh_host_rsa_key" ] || \
		/usr/bin/ssh-keygen -t rsa -b 3072 -f "$KEYDIR/ssh_host_rsa_key" -N "" >/dev/null 2>&1
}

start() {
	ensure_keys

	[ -f "$KEYDIR/ssh_host_ed25519_key" ] || return 1
	[ -f "$KEYDIR/ssh_host_rsa_key" ] || return 1

	printf "Starting %s: " "$DAEMON"
	start-stop-daemon --start --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON" \
		-- -o HostKey="$KEYDIR/ssh_host_ed25519_key" \
		   -o HostKey="$KEYDIR/ssh_host_rsa_key"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Stopping %s: " "$DAEMON"
	start-stop-daemon --stop --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	while [ -f "$PIDFILE" ]; do
		sleep 0.1
	done
	return "$status"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit $?
