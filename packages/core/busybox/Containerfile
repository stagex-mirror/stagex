ARG BUILD_MODE=native

# Host-arch oracle: build busybox natively with defconfig so we can
# enumerate applets without exec'ing target-arch busybox in the main
# stage. Keeps multi-platform core-busybox builds qemu-free.
FROM --platform=$BUILDPLATFORM stagex/bootstrap-stage3 AS busybox-oracle
ARG VERSION
ADD fetch/busybox-${VERSION}.tar.bz2 .
WORKDIR /busybox-${VERSION}
RUN --network=none <<-EOF
	set -eux
	make CC=clang HOSTCC=clang defconfig
	echo "CONFIG_STATIC=y" >> .config
	make CC=clang HOSTCC=clang
	mkdir -p /host-tools
	cp busybox /host-tools/busybox
EOF

FROM stagex/bootstrap-stage3 AS base-native
FROM --platform=$BUILDPLATFORM stagex/core-cross-base AS base-cross

FROM base-${BUILD_MODE} AS build
ARG BUILD_MODE
ARG VERSION
ARG TARGETARCH
COPY --from=busybox-oracle /host-tools/busybox /host-tools/busybox
ADD fetch/busybox-${VERSION}.tar.bz2 .
WORKDIR /busybox-${VERSION}
ENV KCONFIG_NOTIMESTAMP=1
ENV ARCH=$TARGETARCH
RUN --network=none <<-EOF
	set -eux

	case "${TARGETARCH}" in
		amd64)   TARGET_ARCH=x86_64 ;;
		arm64)   TARGET_ARCH=aarch64 ;;
		riscv64) TARGET_ARCH=riscv64 ;;
		*) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;;
	esac

	# Under MODE=cross the RUN executes on the build host's arch;
	# point clang at the target sysroot so the output binary is
	# target-arch code. See core/musl for the fallback rationale.
	CROSS_CC="clang"
	if [ "${BUILD_MODE}" = "cross" ] && [ "$(uname -m)" != "${TARGET_ARCH}" ]; then
		CROSS_CC="clang --target=${TARGET_ARCH}-linux-musl --sysroot=/usr/${TARGET_ARCH}-linux-musl --gcc-toolchain=/usr/${TARGET_ARCH}-linux-musl -rtlib=libgcc -unwindlib=none"
	fi
	setConfs='
	    CONFIG_LAST_SUPPORTED_WCHAR=0
	    CONFIG_STATIC=y
	'
	unsetConfs='
	    CONFIG_FEATURE_SYNC_FANCY
	    CONFIG_FEATURE_HAVE_RPC
	    CONFIG_FEATURE_INETD_RPC
	    CONFIG_FEATURE_UTMP
	    CONFIG_FEATURE_WTMP
	'
	# Add hwaccel configs for ARM architectures
	if [ "$TARGETARCH" = "arm64" ] || [ "$TARGETARCH" = "aarch64" ]; then
	    unsetConfs="$unsetConfs
	    CONFIG_SHA1_HWACCEL
	    CONFIG_SHA256_HWACCEL
	    CONFIG_MD5_HWACCEL
	"
	fi
	export HOSTCC=clang CC="${CROSS_CC}"
	make HOSTCC=clang CC="${CROSS_CC}" defconfig
	for conf in $unsetConfs; do
		sed -i \
			-e "s!^$conf=.*\$!# $conf is not set!" \
		.config
	done
	for confV in $setConfs; do
		conf="${confV%=*}"
		sed -i \
			-e "s!^$conf=.*\$!$confV!" \
			-e "s!^# $conf is not set\$!$confV!" \
			.config
		if ! grep -q "^$confV\$" .config; then
			echo "$confV" >> .config
		fi
	done
	make HOSTCC=clang CC="${CROSS_CC}" oldconfig
	for conf in $unsetConfs; do
		! grep -q "^$conf=" .config
	done
	for confV in $setConfs; do
		grep -q "^$confV\$" .config
	done
	make HOSTCC=clang CC="${CROSS_CC}" -j$(nproc)
	mkdir -p /rootfs/usr/bin
	cp busybox /rootfs/usr/bin
	for a in $(/host-tools/busybox --list); do
		ln -sf busybox /rootfs/usr/bin/$a
	done
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
ENTRYPOINT ["/bin/sh"]
