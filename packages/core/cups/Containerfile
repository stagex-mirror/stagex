FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-openssl . /
ADD fetch/cups-${VERSION}-source.tar.gz .
WORKDIR /cups-${VERSION}
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-pam \
		--disable-dbus \
		--disable-avahi \
		--disable-systemd \
		--disable-launchd \
		--disable-libpaper \
		--disable-libusb \
		--enable-ssl=yes \
		--with-tls=openssl
	make -j "$(nproc)"
	make BUILDROOT=/rootfs install
	# Keep only headers, libs, and pkgconfig — remove runtime dirs
	rm -rf /rootfs/etc /rootfs/var /rootfs/usr/sbin /rootfs/usr/bin \
		/rootfs/usr/share /rootfs/usr/libexec
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
