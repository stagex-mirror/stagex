FROM scratch AS build
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-linux-headers . /
COPY --from=stagex/core-llvm . /
COPY --from=stagex/core-mold . /
COPY --from=stagex/core-onetbb . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-xz . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-cmake . /
COPY --from=stagex/core-openssl . /
COPY --from=stagex/core-samurai . /
COPY --from=stagex/core-binutils . /
COPY --from=stagex/core-pkgconf . /
ARG VERSION
COPY --from=stagex/core-libpng . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-libjpeg . /
COPY --from=stagex/core-giflib . /
ADD fetch/libwebp-${VERSION}.tar.gz .
WORKDIR /libwebp-${VERSION}
RUN --network=none <<-EOF
	cmake \
		-B build \
		-G Ninja \
		-DCMAKE_BUILD_TYPE=MinSizeRel \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DWEBP_BUILD_ANIM_UTILS=ON \
		-DWEBP_BUILD_CWEBP=ON \
		-DWEBP_BUILD_DWEBP=ON \
		-DWEBP_BUILD_GIF2WEBP=ON \
		-DWEBP_BUILD_IMG2WEBP=ON \
		-DWEBP_BUILD_WEBPINFO=ON \
		-DWEBP_BUILD_WEBPMUX=ON
	cmake --build build
	DESTDIR=/rootfs cmake --install build
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /