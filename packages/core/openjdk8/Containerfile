	set -eu
	if [ "$TARGETARCH" = "amd64" ]; then export ARCH="x86_64"; fi
	if [ "$TARGETARCH" = "arm64" ]; then export ARCH="aarch64"; fi
EOF
SHELL ["/bin/sh","-l","-c"]

# --- Stage: buildenv ---
FROM deps AS buildenv
ARG APORTS_VERSION
COPY patches/ /patches/
COPY fetch/patch-2.7.6.tar.xz /tmp/patch-2.7.6.tar.xz
COPY fetch/ecj-4.9.jar /usr/share/java/ecj-4.9.jar
