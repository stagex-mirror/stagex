# ============================================================
# OpenJDK 8 via IcedTea 3 bootstrap
# Multi-stage build: deps → buildenv → source → patched → configured → built → package
# ============================================================

# --- Stage: deps ---
FROM scratch AS deps
ARG VERSION
ARG APORTS_VERSION
ARG TARGETARCH
COPY --from=stagex/core-filesystem . /
