ARG BUILD_MODE=native

FROM stagex/bootstrap-stage3 AS base-native
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-llvm . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-musl . /

FROM stagex/core-musl AS musl-target
FROM --platform=$BUILDPLATFORM stagex/core-cross-base AS base-cross
# Overlay core-musl so cross-linked binaries carry the same NEEDED
# libc.musl-<arch>.so.1 SONAME as native-linked ones. Sourced from
# the target-tagged musl (via the untagged FROM above which defaults
# to $TARGETPLATFORM) so its libc.so matches what we're emitting.
COPY --from=musl-target / /

FROM base-${BUILD_MODE} AS build
ARG BUILD_MODE
ARG TARGETARCH
ARG VERSION
ADD fetch/zlib-${VERSION}.tar.gz .
WORKDIR /zlib-${VERSION}
ENV CFLAGS="-fPIC"
RUN --network=none <<-EOF
	set -eux
	# zlib's configure tests shared-lib support by linking with $LDSHARED.
	# Default LDSHARED=$CC (just "clang") fails the test (no main()) so
	# configure silently disables shared lib. Force -shared so the test succeeds.
	export LDSHARED="clang -shared"
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib \
		--shared
	make -j "$(nproc)"
	make DESTDIR=/rootfs install
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
