FROM stagex/core-profile AS build
ARG VERSION
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-llvm . /
COPY --from=stagex/core-mold . /
COPY --from=stagex/core-onetbb . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-openssl . /
COPY --from=stagex/core-perl . /
COPY --from=stagex/core-ca-certificates . /
ADD fetch/curl-${VERSION}.tar.xz .
WORKDIR /curl-${VERSION}
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	autoreconf -vfi
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--with-ca-bundle=/etc/ssl/certs/ca-certificates.crt \
		--with-openssl \
		--without-libpsl \
		--enable-static
	# TODO: libpsl support disabled - configure fails with "runtime libs availability... failed" when libpsl is present
	# even with static+dynamic artifacts. Needs investigation. https://github.com/curl/curl/issues/17385
	make -j "$(nproc)"
	make install DESTDIR=/rootfs
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
