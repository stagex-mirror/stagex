FROM stagex/bootstrap-stage3 AS build
ARG VERSION
ADD fetch/mimalloc-${VERSION}.tar.gz .
WORKDIR /mimalloc-${VERSION}
RUN --network=none <<-EOF
  set -eux

  # For some reason, `mimalloc` contains binary blobs in releases, so we explicitly remove those now
  rm -rf .git bin

  # Required as `mimalloc` compiles in the date, time it was built
  export SOURCE_DATE_EPOCH=1

  export CFLAGS="-Wformat -Werror=format-security"
  export CFLAGS="$CFLAGS -O2 -fPIC"
  # Enable basic hardening
  export CFLAGS="$CFLAGS -fstack-protector-strong -fstack-clash-protection"

  # Explicitly use `pthread` for TLS, as we expect to use with `musl` (providing `pthread`).
  # Use the compiler builtin to obtain the thread's ID, as the default method
  # (using the address of a thread-local variable) won't work when building into `musl`.
  export CFLAGS="$CFLAGS -DMI_TLS_PTHREAD=1 -DMI_USE_BUILTIN_THREAD_POINTER=1"

  mkdir out
  cd out

  cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_INCLUDEDIR=/usr/include/mimalloc \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib/mimalloc \
    -DMI_INSTALL_TOPLEVEL=ON \
    -DMI_NO_OPT_ARCH=ON \
    -DMI_OVERRIDE=ON \
    -DMI_LIBC_MUSL=ON \
    -DMI_SECURE=ON \
    -DMI_XMALLOC=ON \
    -DMI_BUILD_TESTS=OFF \
    ..
  make -j $(nproc)

  mkdir /rootfs
  make DESTDIR=/rootfs install

  mkdir -p /rootfs/usr/share/licenses
  cp ../LICENSE /rootfs/usr/share/licenses/mimalloc
EOF

FROM stagex/core-filesystem AS package-mimalloc
COPY --from=build /rootfs /

# AArch64 cross-compiled mimalloc subpackage
FROM stagex/bootstrap-stage3 AS build-mimalloc-linux-aarch64
COPY --from=stagex/pallet-clang /usr /usr
COPY --from=stagex/core-musl / /
COPY --from=stagex/core-llvm-compiler-rt-aarch64 . /
SHELL ["/bin/sh", "-c"]
ARG VERSION
ADD fetch/mimalloc-${VERSION}.tar.gz .
WORKDIR /mimalloc-${VERSION}

RUN --network=none <<-EOF
	set -eux

	rm -rf .git bin
	export SOURCE_DATE_EPOCH=1
	
	# Cross-compile flags for aarch64
	export CFLAGS="-Wformat -Werror=format-security -O2 -fPIC -fstack-protector-strong -fstack-clash-protection -DMI_TLS_PTHREAD=1 -DMI_USE_BUILTIN_THREAD_POINTER=1"
	export CFLAGS="$CFLAGS --target=aarch64-unknown-linux-musl"
	
	mkdir out
	cd out
	
	cmake \
		-DCMAKE_SYSTEM_NAME=Linux \
		-DCMAKE_SYSTEM_PROCESSOR=aarch64 \
		-DCMAKE_C_COMPILER=clang \
		-DCMAKE_INSTALL_INCLUDEDIR=/usr/aarch64-unknown-linux-musl/include/mimalloc \
		-DCMAKE_INSTALL_LIBDIR=/usr/aarch64-unknown-linux-musl/lib/mimalloc \
		-DMI_INSTALL_TOPLEVEL=ON \
		-DMI_NO_OPT_ARCH=ON \
		-DMI_LIBC_MUSL=ON \
		-DMI_SECURE=ON \
		-DMI_XMALLOC=ON \
		-DMI_BUILD_TESTS=OFF \
		-DMI_BUILD_SHARED=OFF \
		-DMI_BUILD_STATIC=ON \
		-DMI_BUILD_OBJECT=ON \
		..
	
	make -j $(nproc)
	
	# Install to aarch64 sysroot
	mkdir -p /rootfs/usr/aarch64-unknown-linux-musl
	cp -r out/lib/* /rootfs/usr/aarch64-unknown-linux-musl/lib/
EOF

FROM scratch AS package-mimalloc-linux-aarch64
COPY --from=build-mimalloc-linux-aarch64 /rootfs/ /
