ARG BUILD_MODE=native

FROM stagex/bootstrap-stage3 AS base-native
FROM --platform=$BUILDPLATFORM stagex/core-cross-base AS base-cross

FROM base-${BUILD_MODE} AS build
ARG BUILD_MODE
ARG TARGETARCH
ARG VERSION
ADD fetch/mimalloc-${VERSION}.tar.gz .
WORKDIR /mimalloc-${VERSION}
RUN --network=none <<-EOF
  set -eux

  case "${TARGETARCH}" in
    amd64)   ARCH=x86_64 ;;
    arm64)   ARCH=aarch64 ;;
    riscv64) ARCH=riscv64 ;;
    *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;;
  esac

  # For some reason, `mimalloc` contains binary blobs in releases, so we explicitly remove those now
  rm -rf .git bin

  # Required as `mimalloc` compiles in the date, time it was built
  export SOURCE_DATE_EPOCH=1

  export CFLAGS="-Wformat -Werror=format-security"
  export CFLAGS="$CFLAGS -O2 -fPIC"
  # Enable basic hardening
  export CFLAGS="$CFLAGS -fstack-protector-strong -fstack-clash-protection"

  # Explicitly use `pthread` for TLS, as we expect to use with `musl` (providing `pthread`).
  # Use the compiler builtin to obtain the thread's ID, as the default method
  # (using the address of a thread-local variable) won't work when building into `musl`.
  export CFLAGS="$CFLAGS -DMI_TLS_PTHREAD=1 -DMI_USE_BUILTIN_THREAD_POINTER=1"

  # Under MODE=cross the RUN executes on the build host's arch;
  # point clang at the target sysroot so the output object files
  # are target-arch code that can link into a target-arch libc.a.
  # Stage3's LLVM only ships compiler-rt/libunwind for the host arch,
  # so for cross targets we fall back to what stage2-sysroot does
  # provide: gcc's libgcc and no unwind lib. --gcc-toolchain points
  # clang at the per-target gcc install so it finds libgcc.a.
  if [ "${BUILD_MODE}" = "cross" ] && [ "$(uname -m)" != "${ARCH}" ]; then
    CROSS_FLAGS="--target=${ARCH}-linux-musl --sysroot=/usr/${ARCH}-linux-musl --gcc-toolchain=/usr/${ARCH}-linux-musl -rtlib=libgcc -unwindlib=none"
    export CC="clang ${CROSS_FLAGS}"
    export CXX="clang++ ${CROSS_FLAGS}"
    export CFLAGS="$CFLAGS ${CROSS_FLAGS}"
  fi

  mkdir out
  cd out

  # Under cross the sysroot lacks a full runtime (no libunwind, etc.)
  # so CMake's link-based compiler probe fails. Fall back to a
  # static-archive probe which only requires the compiler itself.
  if [ "${BUILD_MODE}" = "cross" ] && [ "$(uname -m)" != "${ARCH}" ]; then
    CROSS_CMAKE_ARGS="-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY"
  else
    CROSS_CMAKE_ARGS=""
  fi
  cmake \
    ${CROSS_CMAKE_ARGS} \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_INCLUDEDIR=/usr/include/mimalloc \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib/mimalloc \
    -DMI_INSTALL_TOPLEVEL=ON \
    -DMI_NO_OPT_ARCH=ON \
    -DMI_OVERRIDE=ON \
    -DMI_LIBC_MUSL=ON \
    -DMI_SECURE=ON \
    -DMI_XMALLOC=ON \
    -DMI_BUILD_TESTS=OFF \
    ..
  make -j $(nproc)

  mkdir /rootfs
  make DESTDIR=/rootfs install

  mkdir -p /rootfs/usr/share/licenses
  cp ../LICENSE /rootfs/usr/share/licenses/mimalloc
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs /
