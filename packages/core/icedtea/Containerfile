ENV SOURCE_DATE_EPOCH=1
ENV CC=clang
ENV CXX=clang++

# ============================================================
# Phase 0: Build freetype from source
# ============================================================
ADD fetch/freetype-2.13.2.tar.xz .
RUN --network=none <<-EOF
	set -eux
	cd /freetype-2.13.2
	./configure \
		--prefix=/usr \
		--enable-shared \
		--disable-static \
		--with-zlib=yes \
		--with-png=yes \
		--with-bzip2=no \
		--with-harfbuzz=no \
		--with-brotli=no
	make -j "$(nproc)"
	make install
EOF

# ============================================================
# Phase 1: Install ALSA headers + stub library (for configure)
# ============================================================
ADD fetch/alsa-lib-1.2.12.tar.bz2 .
RUN --network=none <<-EOF
	set -eux
	# Only install headers — OpenJDK dlopens libasound at runtime
	cp -r /alsa-lib-1.2.12/include/sound /usr/include/
	mkdir -p /usr/include/alsa
	cp /alsa-lib-1.2.12/include/*.h /usr/include/alsa/

	# Generate asoundlib.h if not present
	if [ ! -f /usr/include/alsa/asoundlib.h ]; then
		cp /alsa-lib-1.2.12/include/asoundlib-head.h /usr/include/alsa/asoundlib.h
	fi

	# Create stub shared library (need a dummy input file)
	echo 'void __alsa_stub(void) {}' | ${CC} -x c - -shared -o /usr/lib/libasound.so -Wl,-soname,libasound.so.2

	# Create pkg-config file
	mkdir -p /usr/lib/pkgconfig
	cat > /usr/lib/pkgconfig/alsa.pc <<'PC'
	Name: alsa
	Version: 1.2.12
	Description: ALSA library (stub)
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lasound
	PC
EOF

# ============================================================
# Phase 2: Install X11 protocol headers + create X11 stubs
# ============================================================
ADD fetch/xorgproto-2024.1.tar.xz .
RUN --network=none <<-EOF
	set -eux

	# Install X11 protocol headers (xproto, etc.)
	cd /xorgproto-2024.1
	mkdir build && cd build
	# xorgproto uses meson, but we can just copy the headers
	cd ..
	cp -r include/X11 /usr/include/

	# Create minimal stub libraries and pkg-config files for X11
	# These satisfy IcedTea's configure checks. The actual OpenJDK build
	# dlopens X11 libs at runtime, so stubs are sufficient for compilation.

	# Create empty stub .so files
	echo 'void __stub(void) {}' > /tmp/stub.c
	for lib in X11 Xt Xinerama Xrender Xcomposite Xtst Xext Xrandr Xi \
		xcb xcb-shm xcb-render; do
		${CC} -shared -o /usr/lib/lib${lib}.so -Wl,-soname,lib${lib}.so /tmp/stub.c
	done

	# Create pkg-config files
	mkdir -p /usr/lib/pkgconfig

	cat > /usr/lib/pkgconfig/xproto.pc <<'PC'
	Name: Xproto
	Version: 7.0.31
	Description: X protocol headers
	Cflags: -I/usr/include
	PC

	cat > /usr/lib/pkgconfig/x11.pc <<'PC'
	Name: X11
	Version: 1.8.0
	Description: X11 library
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lX11
	PC

	cat > /usr/lib/pkgconfig/xt.pc <<'PC'
	Name: Xt
	Version: 1.3.0
	Description: X Toolkit
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lXt
	PC

	cat > /usr/lib/pkgconfig/xinerama.pc <<'PC'
	Name: Xinerama
	Version: 1.1.5
	Description: Xinerama extension
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lXinerama
	PC

	cat > /usr/lib/pkgconfig/xrender.pc <<'PC'
	Name: Xrender
	Version: 0.9.11
	Description: X Render extension
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lXrender
	PC

	cat > /usr/lib/pkgconfig/xcomposite.pc <<'PC'
	Name: Xcomposite
	Version: 0.4.6
	Description: X Composite extension
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lXcomposite
	PC

	cat > /usr/lib/pkgconfig/xtst.pc <<'PC'
	Name: Xtst
	Version: 1.2.4
	Description: X TST extension
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lXtst
	PC

	cat > /usr/lib/pkgconfig/xext.pc <<'PC'
	Name: Xext
	Version: 1.3.6
	Description: X Extension library
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lXext
	PC

	cat > /usr/lib/pkgconfig/xrandr.pc <<'PC'
	Name: Xrandr
	Version: 1.5.4
	Description: X RandR extension
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lXrandr
	PC

	cat > /usr/lib/pkgconfig/xi.pc <<'PC'
	Name: Xi
	Version: 1.8.1
	Description: X Input extension
	Cflags: -I/usr/include
	Libs: -L/usr/lib -lXi
	PC

	# Create minimal Xlib.h stub (xorgproto has X.h/Xproto.h but not Xlib.h)
	mkdir -p /usr/include/X11
	cat > /usr/include/X11/Xlib.h <<'HEADER'
	#ifndef _Xlib_h
	#define _Xlib_h
	#include <X11/X.h>
	#include <sys/types.h>
	#include <stdlib.h>
	#define Bool int
	#define Boolean Bool
	typedef char *XPointer;
	#define XStdICCTextStyle 0
	#define Status int
	#define True 1
	#define False 0
	#define QueuedAlready 0
	#define QueuedAfterReading 1
	#define QueuedAfterFlush 2
	typedef struct _XExtData { int number; struct _XExtData *next; int (*free_private)(struct _XExtData *); void *private_data; } XExtData;
	typedef struct { XExtData *ext_data; VisualID visualid; int class; unsigned long red_mask, green_mask, blue_mask; int bits_per_rgb; int map_entries; } Visual;
	typedef struct { int depth; int bits_per_pixel; int scanline_pad; } XPixmapFormatValues;
	struct _XDisplay;
	struct _Screen;
	typedef struct _Screen Screen;
	#define ConnectionNumber(d) ((d)->fd)
	#define DefaultScreen(d) ((d)->default_screen)
	#define ScreenOfDisplay(d,s) (&(d)->screens[s])
	#define DefaultVisual(d,s) (ScreenOfDisplay(d,s)->root_visual)
	#define DefaultDepth(d,s) (ScreenOfDisplay(d,s)->root_depth)
	#define DefaultColormap(d,s) (ScreenOfDisplay(d,s)->cmap)
	#define DisplayWidth(d,s) (ScreenOfDisplay(d,s)->width)
	#define DisplayHeight(d,s) (ScreenOfDisplay(d,s)->height)
	#define RootWindow(d,s) (ScreenOfDisplay(d,s)->root)
	#define BlackPixel(d,s) (ScreenOfDisplay(d,s)->black_pixel)
	#define WhitePixel(d,s) (ScreenOfDisplay(d,s)->white_pixel)
	#define AllPlanes ((unsigned long)~0L)
	#define XFree(p) free(p)
	typedef struct _XDisplay Display;
	typedef struct _XGC *GC;
	typedef struct { int type; unsigned long serial; Bool send_event; Display *display; Window window; } XAnyEvent;
	typedef struct { int x, y; unsigned int width, height, border_width, depth; Visual *visual; Window root; int class; int bit_gravity, win_gravity; int backing_store; unsigned long backing_planes, backing_pixel; Bool save_under; Colormap colormap; Bool map_installed; int map_state; long all_event_masks, your_event_mask, do_not_propagate_mask; Bool override_redirect; Screen *screen; } XWindowAttributes;
	typedef struct { Visual *visual; VisualID visualid; int screen; int depth; int class; unsigned long red_mask, green_mask, blue_mask; int colormap_size; int bits_per_rgb; } XVisualInfo;
	typedef struct { int type; Display *display; XID resourceid; unsigned long serial; unsigned char error_code; unsigned char request_code; unsigned char minor_code; } XErrorEvent;
	typedef struct { int type; unsigned long serial; Bool send_event; Display *display; Window window; Window root; Window subwindow; Time time; int x, y, x_root, y_root; unsigned int state; unsigned int keycode; Bool same_screen; } XKeyEvent;
	typedef XKeyEvent XKeyPressedEvent;
	typedef XKeyEvent XKeyReleasedEvent;
	typedef struct { int type; unsigned long serial; Bool send_event; Display *display; Window window; Window root; Window subwindow; Time time; int x, y, x_root, y_root; unsigned int state; unsigned int button; Bool same_screen; } XButtonEvent;
	typedef struct { int type; unsigned long serial; Bool send_event; Display *display; Window window; Window root; Window subwindow; Time time; int x, y, x_root, y_root; unsigned int state; char is_hint; Bool same_screen; } XMotionEvent;
	typedef struct { int type; unsigned long serial; Bool send_event; Display *display; Window window; int x, y, width, height, count; } XExposeEvent;
	typedef struct { int type; unsigned long serial; Bool send_event; Display *display; Window event; Window window; Bool override_redirect; } XMapEvent;
