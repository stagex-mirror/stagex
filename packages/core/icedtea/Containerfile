RUN --network=none <<-EOF
	set -eux
	mkdir -p /rootfs/usr/lib/jvm
	# Boot build produces j2sdk-image in the build dir
	JDKIMG=/icedtea-2.6.28/openjdk.build-boot/j2sdk-image
	if [ -d "$JDKIMG" ]; then
		cp -aL "$JDKIMG" /rootfs/usr/lib/jvm/java-7-openjdk
	elif [ -d /usr/lib/jvm/java-7-openjdk ]; then
		cp -aL /usr/lib/jvm/java-7-openjdk /rootfs/usr/lib/jvm/
	else
		echo "ERROR: No JDK image found"; exit 1
	fi

	# Create convenience symlinks
	mkdir -p /rootfs/usr/bin
	for bin in java javac javah jar javap jarsigner keytool; do
		if [ -f /rootfs/usr/lib/jvm/java-7-openjdk/bin/$bin ]; then
			ln -s /usr/lib/jvm/java-7-openjdk/bin/$bin /rootfs/usr/bin/$bin
		fi
	done

	# Create jaxp.jar with ALL XML-related classes from the build output
	# These are NOT added to rt.jar (causes StackOverflow from -O0 stack pressure)
	# They're loaded on demand via -Xbootclasspath/a: in the OpenJDK 8 build
	echo "=== Creating jaxp.jar ==="
	mkdir -p /tmp/jaxp-collect
	# Collect from all build output directories
	for d in /icedtea-2.6.28/openjdk.build-boot/jaxp/classes \
	         /icedtea-2.6.28/openjdk.build-boot/classes \
	         /icedtea-2.6.28/openjdk.build-boot/jdk/classes; do
		[ -d "$d" ] || continue
		echo "  Scanning $d..."
		# Copy javax/xml, org/xml, org/w3c, com/sun/org/apache/x* class trees
		for pkg in javax/xml org/xml org/w3c com/sun/org/apache/xerces \
		           com/sun/org/apache/xalan com/sun/org/apache/xml \
		           com/sun/org/apache/xpath com/sun/xml; do
			if [ -d "$d/$pkg" ]; then
				mkdir -p "/tmp/jaxp-collect/$pkg"
				cp -a "$d/$pkg/." "/tmp/jaxp-collect/$pkg/" 2>/dev/null
			fi
		done
	done
	cd /tmp/jaxp-collect
	JCOUNT=$(find . -name '*.class' 2>/dev/null | wc -l)
	echo "Creating jaxp.jar with $JCOUNT classes"
	if [ "$JCOUNT" -gt 0 ]; then
		find . -name '*.class' | xargs fastjar cf /rootfs/usr/lib/jvm/java-7-openjdk/jre/lib/jaxp.jar 2>/dev/null
		ls -la /rootfs/usr/lib/jvm/java-7-openjdk/jre/lib/jaxp.jar
	else
		echo "WARNING: No JAXP classes found!"
	fi
	cd /icedtea-2.6.28
	rm -rf /tmp/jaxp-collect

	# Remove src.zip if present (save space)
	rm -f /rootfs/usr/lib/jvm/java-7-openjdk/src.zip

	# HotSpot works with -O0 + 32MB launcher stack!
	JVMDIR=/rootfs/usr/lib/jvm/java-7-openjdk
	# Check j2sdk-image tools.jar before copying
	echo "=== j2sdk-image tools.jar ==="
	JDKIMG_TOOLS=$JDKIMG/lib/tools.jar
	ls -la "$JDKIMG_TOOLS" 2>/dev/null
	file "$JDKIMG_TOOLS" 2>/dev/null || true
	# Check if it's a symlink
	readlink "$JDKIMG_TOOLS" 2>/dev/null && echo "IS SYMLINK" || echo "is real file"
	# Recreate tools.jar from langtools classes
	# The j2sdk-image tools.jar is created by fastjar which produces broken jars
	# Use the build's java+jar to create a proper tools.jar
	# Find langtools classes (may be at different paths)
	LTCLASSES=$(find /icedtea-2.6.28/openjdk.build-boot -name 'com' -path '*/sun/tools/javac/../../../..' -type d 2>/dev/null | head -1)
	[ -z "$LTCLASSES" ] && LTCLASSES=$(find /icedtea-2.6.28/openjdk.build-boot -path '*/langtools/*classes*' -name 'com' -type d 2>/dev/null | head -1 | sed 's|/com$||')
	[ -z "$LTCLASSES" ] && LTCLASSES=$(find /icedtea-2.6.28 -path '*/langtools*' -name 'Main.class' 2>/dev/null | head -1 | sed 's|/com/.*||')
	echo "Found langtools classes at: $LTCLASSES"
	JDKJAR=/icedtea-2.6.28/openjdk.build-boot/j2sdk-image/bin/jar
	if [ -n "$LTCLASSES" ] && [ -d "$LTCLASSES" ]; then
		echo "Recreating tools.jar from $(find $LTCLASSES -name '*.class' | wc -l) class files"
		rm -f $JVMDIR/lib/tools.jar
		cd "$LTCLASSES"
		# Use the j2sdk-image's jar if available, otherwise fastjar
		if [ -x "$JDKJAR" ]; then
			JAVA_HOME=/icedtea-2.6.28/openjdk.build-boot/j2sdk-image \
			LD_LIBRARY_PATH=/icedtea-2.6.28/openjdk.build-boot/j2sdk-image/jre/lib/amd64:/icedtea-2.6.28/openjdk.build-boot/j2sdk-image/jre/lib/amd64/server \
			"$JDKJAR" cf $JVMDIR/lib/tools.jar . 2>&1 | head -3 || echo "jar failed"
		else
			find . -type f | xargs -n 500 fastjar cf $JVMDIR/lib/tools.jar 2>/dev/null
		fi
		cd /icedtea-2.6.28
		echo "tools.jar: $(ls -la $JVMDIR/lib/tools.jar 2>/dev/null)"
	fi
	# Copy ECJ native binary and GCJ runtime libs
	mkdir -p /rootfs/usr/lib/jvm/java-1.5-gcj/bin
	cp /usr/lib/jvm/java-1.5-gcj/bin/ecj /rootfs/usr/lib/jvm/java-1.5-gcj/bin/ecj
	# ECJ needs libgcj.so and friends
	for lib in libgcj.so* libgcj_bc.so* libgcc_s.so* libstdc++.so* libfreetype.so*; do
		cp -a /usr/lib/$lib /rootfs/usr/lib/ 2>/dev/null || true
	done
	# Freetype headers for downstream builds
	cp -a /usr/include/freetype2 /rootfs/usr/include/ 2>/dev/null || true
	cp /usr/lib/pkgconfig/freetype2.pc /rootfs/usr/lib/pkgconfig/ 2>/dev/null || true

	# Also copy JamVM and Classpath runtime into rootfs
	cp /usr/bin/jamvm /rootfs/usr/bin/jamvm
	cp -a /usr/lib/classpath /rootfs/usr/lib/classpath 2>/dev/null || true
	echo "=== JamVM runtime ==="
	ls -la /usr/share/jamvm/ 2>/dev/null || echo "NO /usr/share/jamvm"
	ls -la /usr/share/classpath/glibj.zip 2>/dev/null || echo "NO glibj.zip"
	mkdir -p /rootfs/usr/share/jamvm /rootfs/usr/share/classpath
	cp -a /usr/share/classpath/* /rootfs/usr/share/classpath/ 2>/dev/null || echo "classpath copy failed"
	cp -a /usr/share/jamvm/* /rootfs/usr/share/jamvm/ 2>/dev/null || echo "jamvm copy failed"
	# JamVM needs libffi
	cp /usr/lib/libffi.so* /rootfs/usr/lib/ 2>/dev/null || true
EOF

FROM stagex/core-filesystem AS package
