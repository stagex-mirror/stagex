	typedef struct { int type; unsigned long serial; Bool send_event; Display *display; Window window; char key_vector[32]; } XKeymapEvent;
	typedef union _XEvent { int type; XAnyEvent xany; XKeyEvent xkey; XButtonEvent xbutton; XMotionEvent xmotion; XExposeEvent xexpose; XMapEvent xmap; XUnmapEvent xunmap; XConfigureEvent xconfigure; XClientMessageEvent xclient; XPropertyEvent xproperty; XFocusChangeEvent xfocus; XResizeRequestEvent xresizerequest; XSelectionRequestEvent xselectionrequest; XSelectionEvent xselection; XColormapEvent xcolormap; XMappingEvent xmapping; XSelectionClearEvent xselectionclear; XCreateWindowEvent xcreatewindow; XDestroyWindowEvent xdestroywindow; XReparentEvent xreparent; XVisibilityEvent xvisibility; XCirculateEvent xcirculate; XCrossingEvent xcrossing; XGraphicsExposeEvent xgraphicsexpose; XNoExposeEvent xnoexpose; XMapRequestEvent xmaprequest; XGravityEvent xgravity; XConfigureRequestEvent xconfigurerequest; XCirculateRequestEvent xcirculaterequest; XErrorEvent xerror; XKeymapEvent xkeymap; long pad[24]; } XEvent;
