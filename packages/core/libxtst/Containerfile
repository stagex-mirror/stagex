FROM stagex/pallet-clang-gnu-busybox AS build
COPY --from=stagex/user-xorgproto . /
COPY --from=stagex/core-libx11 . /
COPY --from=stagex/core-libxext . /
COPY --from=stagex/user-libxi . /
COPY --from=stagex/user-libxcb . /
COPY --from=stagex/user-libxdmcp . /
COPY --from=stagex/user-libxau . /
COPY --from=stagex/user-util-macros . /
ARG VERSION
ADD fetch/libXtst-${VERSION}.tar.xz .
WORKDIR /libXtst-${VERSION}
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--enable-static
	make -j "$(nproc)"
	make DESTDIR=/rootfs install
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
