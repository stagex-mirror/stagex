# Per-target compiler runtime bundles for out-of-tree cross compilation.
# Each ships libunwind/libc++/libc++abi/compiler-rt-builtins for one target
# under clang's per-target runtime dir. Update the /22/ path on LLVM major
# version bumps.

FROM stagex/core-filesystem AS package-runtime-cross-x86_64
COPY --from=build /rootfs/usr/lib/clang/22/lib/x86_64-unknown-linux-musl/. /usr/lib/clang/22/lib/x86_64-unknown-linux-musl/

FROM stagex/core-filesystem AS package-runtime-cross-aarch64
COPY --from=build /rootfs/usr/lib/clang/22/lib/aarch64-unknown-linux-musl/. /usr/lib/clang/22/lib/aarch64-unknown-linux-musl/
