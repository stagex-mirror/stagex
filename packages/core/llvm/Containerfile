ARG BUILD_MODE=native

# Native path: target-arch stage3, overlaid with the polished core-musl
# (matching libc SONAME) and stage2-sysroot (multi-target sysroots used
# by the cross-target runtime pass further down).
FROM stagex/bootstrap-stage3 AS base-native
COPY --from=stagex/core-musl . /
COPY --from=stagex/bootstrap-stage2-sysroot . /

# Cross path: host-arch clang+lld+multi-target sysroots from cross-base.
# Target-arch libc/libc++/libunwind live under /usr/<TARGET>/ (from
# stage2-sysroot) and /usr/lib/clang/22/lib/<TARGET>/ (from stage3's
# cross-runtime pass), so no target-arch overlay on / is needed here.
# An overlay would break LLVM's NATIVE sub-cmake, which does a host-arch
# try_compile that pulls crt from /lib.
FROM --platform=$BUILDPLATFORM stagex/core-cross-base AS base-cross

FROM base-${BUILD_MODE} AS build
ARG BUILD_MODE
ARG VERSION
ARG TARGETARCH
# Overrides base's /etc/profile with LLVM-specific vars. Cross-mode
# target flags are NOT injected into env here — they go through cmake
# args below instead. Reason: LLVM's cross-compile creates a NATIVE
# sub-cmake for host-side tools (llvm-min-tblgen), and that sub-cmake
# inherits env CFLAGS/CXXFLAGS. If those carry --target=<TARGET>, the
# host tool gets built for the wrong arch and the build fails.
COPY <<-'EOF' /etc/profile
	set -eux

	export MAKEFLAGS="-j$(nproc)"
	export MAJOR_VERSION=$(echo "$VERSION" | cut -d'.' -f1)

	case "${TARGETARCH:-}" in
		amd64)   ARCH=x86_64;  LLVM_TARGET_ARCH=X86 ;;
		arm64)   ARCH=aarch64; LLVM_TARGET_ARCH=AArch64 ;;
		riscv64) ARCH=riscv64; LLVM_TARGET_ARCH=RISCV ;;
	esac
	export ARCH LLVM_TARGET_ARCH
	export BUILD=${ARCH}-unknown-linux-musl
	# LLVM canonicalizes triples with -unknown- inserted, so the per-target
	# runtime dir installs under this name (LIBCC path below relies on it).
	export TARGET=${ARCH}-unknown-linux-musl
	# Host-arch runtime target. Cross-target runtimes are built out-of-tree
	# further down (LLVM's multi-target LLVM_RUNTIME_TARGETS races on shared
	# libcxx header configure paths).
	export RUNTIME_TARGETS="${ARCH}-linux-musl"
	# Cross targets get their own cmake runtime builds after main install.
	# riscv64 deferred until we sort out RISC-V-specific compiler-rt issues.
	export CROSS_RUNTIME_TARGETS="aarch64-linux-musl x86_64-linux-musl"
EOF
SHELL ["/bin/sh","-l","-c"]

ADD fetch/llvm-${VERSION}.tar.xz .
WORKDIR /llvm-project-${VERSION}.src

ADD patches/*.patch .
RUN --network=none <<-EOF
	for file in $(find . -maxdepth 1 -name "*.patch" | sort); do
		patch -p1 < "$file"
	done
EOF

RUN --network=none <<-EOF
	# CMake configuration arguments applicable to both of the following builds

	CMAKE_ARGS=""
	cmake_cache_set() {
	  CMAKE_ARGS="$CMAKE_ARGS -D$1=$2"
	}
	# Runtime settings must be prefixed with RUNTIMES_<triple>_ so LLVM's
	# nested cmake invocation for each target picks them up. Apply to every
	# RUNTIME_TARGETS entry so all three musl targets get identical runtime
	# configuration.
	cmake_runtime_cache_set() {
	  for T in $RUNTIME_TARGETS; do
	    CMAKE_ARGS="$CMAKE_ARGS -DRUNTIMES_${T}_$1=$2"
	  done
	}

	# Under cross-mode: tell cmake we're cross-compiling AND route the
	# target flags (--target/--sysroot) through cmake args, NOT through
	# env CFLAGS/CXXFLAGS. LLVM's own cross-compile creates a NATIVE
	# sub-cmake for host-side tools like llvm-min-tblgen; that sub-cmake
	# inherits parent env vars but not top-level cmake -D args, so
	# keeping target flags in cmake args scopes them to the target
	# build tree only.
	#
	# STATIC_LIBRARY try_compile skips the link step stage3's LLVM
	# can't service for cross targets.
	#
	# Default -rtlib=compiler-rt and -unwindlib=libunwind work directly
	# because bootstrap-stage3 now ships aarch64 compiler-rt/libunwind/
	# libc++/libc++abi under clang's per-target search dir.
	#
	# LLVM's RUNTIMES sub-cmake IS independent of the top-level, so
	# repeat all the cross settings with the RUNTIMES_<T>_ prefix.
	if [ "${BUILD_MODE}" = "cross" ] && [ "$(uname -m)" != "${ARCH}" ]; then
	  cmake_cache_set CMAKE_SYSTEM_NAME Linux
	  cmake_cache_set CMAKE_SYSTEM_PROCESSOR "$ARCH"
	  cmake_cache_set CMAKE_CROSSCOMPILING TRUE
	  cmake_cache_set CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY
	  cmake_cache_set CMAKE_C_COMPILER_TARGET "${ARCH}-linux-musl"
	  cmake_cache_set CMAKE_CXX_COMPILER_TARGET "${ARCH}-linux-musl"
	  cmake_cache_set CMAKE_ASM_COMPILER_TARGET "${ARCH}-linux-musl"
	  cmake_cache_set CMAKE_SYSROOT "/usr/${ARCH}-linux-musl"
	  # Pin find_package to the target sysroot so cmake doesn't detect
	  # host-arch zlib at /usr/lib and leak -I/usr/include into compile
	  # lines. -I/usr/include prepends host system headers before
	  # libc++'s, which breaks libc++'s "did we find our own stddef.h"
	  # include-order sanity check.
	  cmake_cache_set CMAKE_FIND_ROOT_PATH "/usr/${ARCH}-linux-musl"
	  cmake_cache_set CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY
	  cmake_cache_set CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY
	  cmake_cache_set CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY
	  cmake_cache_set CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER
	  # Sysroot has no zlib/zstd so keep them off to avoid feature-detection
	  # divergence between native and cross builds.
	  cmake_cache_set LLVM_ENABLE_ZLIB OFF
	  cmake_cache_set LLVM_ENABLE_ZSTD OFF
	  cmake_runtime_cache_set CMAKE_SYSTEM_NAME Linux
	  cmake_runtime_cache_set CMAKE_SYSTEM_PROCESSOR "$ARCH"
	  cmake_runtime_cache_set CMAKE_CROSSCOMPILING TRUE
	  cmake_runtime_cache_set CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY
	  cmake_runtime_cache_set CMAKE_C_COMPILER_TARGET "${ARCH}-linux-musl"
	  cmake_runtime_cache_set CMAKE_CXX_COMPILER_TARGET "${ARCH}-linux-musl"
	  cmake_runtime_cache_set CMAKE_ASM_COMPILER_TARGET "${ARCH}-linux-musl"
	  cmake_runtime_cache_set CMAKE_SYSROOT "/usr/${ARCH}-linux-musl"
	  # Under CMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY libcxxabi's
	  # detection can't probe symbol availability via a link and wrongly
	  # defaults __cxa_thread_atexit_impl to ON; musl doesn't ship it,
	  # so libc++abi.so fails to link with undefined symbol. Force OFF
	  # (matches the cross-runtimes pass below).
	  cmake_runtime_cache_set LIBCXXABI_HAS_CXA_THREAD_ATEXIT_IMPL OFF
	fi

	# Configure the build itself
	cmake_cache_set CMAKE_BUILD_TYPE Release
	cmake_cache_set CMAKE_INSTALL_PREFIX /usr/
	# If the following is set, LLVM should automatically set `CMAKE_INSTALL_LIBDIR`
	cmake_cache_set LLVM_LIBDIR_SUFFIX ""
	# We explicitly set this as there's discussions to standardize around it
	cmake_cache_set CMAKE_INSTALL_LIBDIR /usr/lib
	cmake_cache_set CMAKE_INSTALL_RPATH /usr/lib
	cmake_cache_set LLVM_INSTALL_UTILS ON
	cmake_cache_set LLVM_INSTALL_BINUTILS_SYMLINKS ON
	cmake_cache_set CLANG_CONFIG_FILE_SYSTEM_DIR /etc/clang

	# Configure for `musl`. HOST_TRIPLE / TARGET_ARCH pin the clang binary
	# itself; RUNTIME_TARGETS / BUILTIN_TARGETS list every triple we build
	# runtime bits for (semicolon-separated for cmake).
	cmake_cache_set LLVM_HOST_TRIPLE "${ARCH}-linux-musl"
	cmake_cache_set LLVM_TARGET_ARCH "$LLVM_TARGET_ARCH"
	RUNTIME_TARGETS_CMAKE=$(echo "$RUNTIME_TARGETS" | tr ' ' ';')
	cmake_cache_set LLVM_RUNTIME_TARGETS "$RUNTIME_TARGETS_CMAKE"
	cmake_cache_set LLVM_BUILTIN_TARGETS "$RUNTIME_TARGETS_CMAKE"
	cmake_runtime_cache_set LIBCXX_HAS_MUSL_LIBC ON
	cmake_runtime_cache_set COMPILER_RT_DEFAULT_TARGET_ONLY ON

	# Configure which parts of LLVM are built
	cmake_cache_set LLVM_ENABLE_PROJECTS "clang;lld"
	cmake_cache_set LLVM_ENABLE_RUNTIMES "compiler-rt;libunwind;libcxx;libcxxabi"

	# Configure compiler-rt
	cmake_runtime_cache_set COMPILER_RT_BUILD_BUILTINS ON
	# Provide all atomic builtins as part of compiler-rt.
	cmake_runtime_cache_set COMPILER_RT_EXCLUDE_ATOMIC_BUILTIN OFF
	cmake_runtime_cache_set COMPILER_RT_USE_BUILTINS_LIBRARY ON
	cmake_runtime_cache_set COMPILER_RT_USE_LLVM_UNWINDER ON
	# This does not work out-of-the-box with a `musl` host
	cmake_runtime_cache_set COMPILER_RT_BUILD_GWP_ASAN OFF
	cmake_cache_set CLANG_DEFAULT_RTLIB compiler-rt

	# Configure libcxx(abi) (and libunwind)
	cmake_cache_set LLVM_ENABLE_LIBCXX ON
	cmake_runtime_cache_set LIBCXX_CXX_ABI libcxxabi
	cmake_runtime_cache_set LIBCXX_HARDENING_MODE fast
	# Make sure libc++ does not link to GCC's libatomic.
	cmake_runtime_cache_set LIBCXX_HAS_ATOMIC_LIB OFF
	cmake_runtime_cache_set LIBCXX_USE_COMPILER_RT ON
	cmake_runtime_cache_set LIBCXXABI_USE_COMPILER_RT ON
	cmake_runtime_cache_set LIBCXXABI_USE_LLVM_UNWINDER ON
	cmake_runtime_cache_set LIBUNWIND_USE_COMPILER_RT ON

	cmake_cache_set CLANG_DEFAULT_CXX_STDLIB libc++
	cmake_cache_set CLANG_DEFAULT_UNWINDLIB libunwind

	# Disable a variety of unused/uninstantiated features
	cmake_cache_set LLVM_ENABLE_LIBXML2 OFF
	cmake_cache_set LLVM_ENABLE_LIBEDIT OFF
	cmake_cache_set LLVM_ENABLE_LIBPFM OFF
	cmake_cache_set LLVM_ENABLE_ICU OFF
	cmake_cache_set LLVM_ENABLE_ICONV OFF

	cmake_runtime_cache_set COMPILER_RT_SCUDO_STANDALONE_BUILD_SHARED OFF

	echo "$CMAKE_ARGS" > ./cmake_args
EOF

RUN --network=none <<-EOF
	export LIBCC="/usr/lib/clang/$MAJOR_VERSION/lib/${TARGET}/libclang_rt.builtins.a"

	# Append -fPIC (rather than overwrite) so cross-mode --target/--sysroot
	# from /etc/profile survive. `${var:+$var }` preserves the empty-CFLAGS
	# case exactly (no leading space) for MODE=native bit-identity.
	export CFLAGS="${CFLAGS:+$CFLAGS }-fPIC"
	export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-fPIC"

	#HACK: The only reason we are not using "all" here is because AMDGPU does not build deterministically
	# Zig hard requires "all" so this also forces a messy patch there as well to remove AMDGPU support as well
	export LLVM_TARGETS_TO_BUILD="AArch64;ARM;AVR;BPF;Hexagon;Lanai;LoongArch;Mips;MSP430;NVPTX;PowerPC;RISCV;Sparc;SPIRV;SystemZ;VE;WebAssembly;X86;XCore"

	CMAKE_ARGS="$(cat ./cmake_args)"
	cmake_cache_set() {
		CMAKE_ARGS="$CMAKE_ARGS -D$1=$2"
	}
	cmake_runtime_cache_set() {
		for T in $RUNTIME_TARGETS; do
			CMAKE_ARGS="$CMAKE_ARGS -DRUNTIMES_${T}_$1=$2"
		done
	}

	cmake_cache_set CMAKE_C_COMPILER /usr/bin/clang
	cmake_cache_set CMAKE_CXX_COMPILER /usr/bin/clang++
	cmake_cache_set CMAKE_AR /usr/bin/llvm-ar
	cmake_cache_set CMAKE_NM /usr/bin/llvm-nm
	cmake_cache_set CMAKE_RANLIB /usr/bin/llvm-ranlib
	cmake_cache_set LLVM_NATIVE_TOOL_DIR /usr/bin/
	cmake_cache_set LLVM_USE_LINKER lld
	cmake_cache_set LLVM_HEADERS_TABLEGEN /usr/bin/llvm-tblgen
	cmake_cache_set CLANG_TABLEGEN /usr/bin/clang-tblgen
	cmake_cache_set LLVM_TARGETS_TO_BUILD "$LLVM_TARGETS_TO_BUILD"
	cmake_cache_set LLVM_ENABLE_PER_TARGET_RUNTIME_DIR ON
	cmake_cache_set LLVM_BUILD_LLVM_DYLIB ON
	cmake_cache_set LLVM_LINK_LLVM_DYLIB ON

	echo "$CMAKE_ARGS" > ./cmake_args

	# We disable the sanitizers from this build because they kept hitting a race condition
	# https://codeberg.org/stagex/stagex/issues/778
	cmake_runtime_cache_set COMPILER_RT_BUILD_SANITIZERS OFF

	cmake \
		-B build \
		-S llvm \
		-Wno-dev \
		$CMAKE_ARGS
	cmake --build build -v
EOF

RUN --network=none <<-EOF
	export LIBCC="/usr/lib/clang/$MAJOR_VERSION/lib/${TARGET}/libclang_rt.builtins.a"

	# Append -fPIC (rather than overwrite) so cross-mode --target/--sysroot
	# from /etc/profile survive. `${var:+$var }` preserves the empty-CFLAGS
	# case exactly (no leading space) for MODE=native bit-identity.
	export CFLAGS="${CFLAGS:+$CFLAGS }-fPIC"
	export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-fPIC"

	CMAKE_ARGS="$(cat ./cmake_args)"
	cmake_cache_set() {
		CMAKE_ARGS="$CMAKE_ARGS -D$1=$2"
	}
	cmake_runtime_cache_set() {
		for T in $RUNTIME_TARGETS; do
			CMAKE_ARGS="$CMAKE_ARGS -DRUNTIMES_${T}_$1=$2"
		done
	}

	# Now that we've already built everything else, we additionally build the sanitizers
	# and lldb. Skipped under MODE=cross — LLVM's per-target library search
	# doesn't reliably find just-built cross libc++ when linking sanitizer
	# runtimes (e.g. tsan hits -lc++ not found), and lldb has additional
	# cross-compilation quirks. Cross builds get pass-1's clang+lld without
	# lldb or sanitizers; the primary goal is a functional target-arch
	# toolchain, not the full development stack.
	if [ "${BUILD_MODE}" != "cross" ] || [ "$(uname -m)" = "${ARCH}" ]; then
		cmake_cache_set LLVM_ENABLE_PROJECTS "clang;lld;lldb"
		cmake_runtime_cache_set COMPILER_RT_BUILD_SANITIZERS ON
	fi

	cmake \
		-B build \
		-S llvm \
		-Wno-dev \
		$CMAKE_ARGS
	cmake --build build -v
	DESTDIR="/rootfs" cmake --install build

	# NSan, for whatever reason, is not being reproducibly built. It's removed here as it
	# _should_ be unpopular and not a blocker, but ideally this would be solved (TODO).
	for T in $RUNTIME_TARGETS; do
		rm -f /rootfs/usr/lib/clang/$MAJOR_VERSION/lib/${T}/libclang_rt.nsan*
	done
EOF

RUN --network=none <<-EOF
	ln -sf /usr/bin/clang++ /rootfs/usr/bin/c++
	ln -sf /usr/bin/clang /rootfs/usr/bin/cc
	ln -sf /usr/bin/ld.lld /rootfs/usr/bin/ld
	ln -sf /usr/lib/clang/$MAJOR_VERSION/lib/${TARGET}/libclang_rt.builtins.a /rootfs/usr/lib/libclang_rt.builtins.a
	strip /rootfs/usr/lib/libLLVM.so.$MAJOR_VERSION.1
EOF

# Cross-target runtimes: build compiler-rt / libunwind / libcxx / libcxxabi
# for each non-host target as standalone cmake runtime projects. Separate
# builds avoid the shared-header race that LLVM's LLVM_RUNTIME_TARGETS hits
# when multiple targets are configured in a single top-level cmake.
RUN --network=none <<-EOF
	# Each iteration below builds for a DIFFERENT target than the main
	# build. Under MODE=cross the profile leaks --target/--sysroot into
	# CFLAGS/LDFLAGS pointing at the main target — clear them so each
	# cross-target's explicit CMAKE_C_COMPILER_TARGET / CMAKE_SYSROOT
	# wins unambiguously. No-op under MODE=native (CFLAGS empty).
	unset CFLAGS CXXFLAGS LDFLAGS CC CXX

	# Shared cmake args for all runtime passes. Clang canonicalizes T to
	# <arch>-unknown-linux-musl when computing its per-target runtime
	# search path, so we tag build artifacts with -unknown- but keep the
	# sysroot at the no-unknown path (matches bootstrap-stage2-sysroot).
	COMMON_ARGS='
		-Wno-dev
		-DCMAKE_BUILD_TYPE=Release
		-DCMAKE_INSTALL_PREFIX=/usr
		-DCMAKE_C_COMPILER=/usr/bin/clang
		-DCMAKE_CXX_COMPILER=/usr/bin/clang++
		-DCMAKE_AR=/usr/bin/llvm-ar
		-DCMAKE_NM=/usr/bin/llvm-nm
		-DCMAKE_RANLIB=/usr/bin/llvm-ranlib
		-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY
		-DLLVM_USE_LINKER=lld
		-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON
	'
	for T in $CROSS_RUNTIME_TARGETS; do
		if [ "$T" = "${ARCH}-linux-musl" ]; then
			continue
		fi
		TC=$(echo "$T" | sed 's/-linux-musl$/-unknown-linux-musl/')

		# Pass 1: standalone builtins-only build. Using the builtins
		# CMakeLists directly avoids the runtimes-level orchestration
		# that drags in libunwind before builtins are ready.
		cmake \
			-B build-cross-$T-rt \
			-S compiler-rt/lib/builtins \
			$COMMON_ARGS \
			-DCMAKE_C_COMPILER_TARGET=$TC \
			-DCMAKE_CXX_COMPILER_TARGET=$TC \
			-DCMAKE_ASM_COMPILER_TARGET=$TC \
			-DCMAKE_SYSROOT=/usr/$T \
			-DCOMPILER_RT_STANDALONE_BUILD=ON \
			-DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON \
			-DCOMPILER_RT_INSTALL_PATH=/usr/lib/clang/$MAJOR_VERSION
		cmake --build build-cross-$T-rt -v
		# Install system-wide so pass 2 can find the builtins via clang's
		# per-target search path.
		cmake --install build-cross-$T-rt

		# Pass 2: build the remaining runtimes against installed builtins.
		cmake \
			-B build-cross-$T \
			-S runtimes \
			$COMMON_ARGS \
			-DCMAKE_C_COMPILER_TARGET=$TC \
			-DCMAKE_CXX_COMPILER_TARGET=$TC \
			-DCMAKE_ASM_COMPILER_TARGET=$TC \
			-DCMAKE_SYSROOT=/usr/$T \
			-DLLVM_ENABLE_RUNTIMES="libunwind;libcxx;libcxxabi" \
			-DLIBCXX_HAS_MUSL_LIBC=ON \
			-DLIBCXX_CXX_ABI=libcxxabi \
			-DLIBCXX_HARDENING_MODE=fast \
			-DLIBCXX_HAS_ATOMIC_LIB=OFF \
			-DLIBCXX_USE_COMPILER_RT=ON \
			-DLIBCXXABI_USE_COMPILER_RT=ON \
			-DLIBCXXABI_USE_LLVM_UNWINDER=ON \
			-DLIBCXXABI_HAS_CXA_THREAD_ATEXIT_IMPL=OFF \
			-DLIBUNWIND_USE_COMPILER_RT=ON
		cmake --build build-cross-$T -v
		cmake --install build-cross-$T

		# libunwind/libcxx/libcxxabi install to /usr/lib/ regardless of
		# LLVM_ENABLE_PER_TARGET_RUNTIME_DIR — move them into the per-target
		# dir so successive cross targets don't overwrite each other and so
		# clang finds them under --target=<T> automatically.
		TDIR=/usr/lib/clang/$MAJOR_VERSION/lib/${TC}
		mkdir -p $TDIR
		for f in libunwind libc++ libc++abi; do
			mv /usr/lib/${f}.a /usr/lib/${f}.so* $TDIR/ 2>/dev/null || true
		done

		# Ship this cross target's per-target runtime dir via the subpackage.
		mkdir -p /rootfs/usr/lib/clang/$MAJOR_VERSION/lib
		cp -a $TDIR /rootfs/usr/lib/clang/$MAJOR_VERSION/lib/
		rm -f /rootfs/usr/lib/clang/$MAJOR_VERSION/lib/${TC}/libclang_rt.nsan*
	done
EOF

FROM build AS build-llvm-libgcc
RUN --network=none <<-EOF
	# The following is allowed to directly use `-DCOMPILER_RT` as it's not building via `llvm`
	cmake \
		-B build-libgcc \
		-S runtimes \
		-Wno-dev \
		-DCMAKE_C_COMPILER=/usr/bin/clang \
		-DCMAKE_CXX_COMPILER=/usr/bin/clang++ \
		-DCMAKE_AR=/usr/bin/llvm-ar \
		-DCMAKE_NM=/usr/bin/llvm-nm \
		-DCMAKE_RANLIB=/usr/bin/llvm-ranlib \
		-DCMAKE_C_COMPILER_TARGET="${TARGET}" \
		-DCMAKE_CXX_COMPILER_TARGET="${TARGET}" \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
		-DLLVM_USE_LINKER=lld \
		$(cat ./cmake_args) \
		-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=OFF \
		-DLLVM_ENABLE_RUNTIMES="llvm-libgcc" \
		-DLLVM_LIBGCC_EXPLICIT_OPT_IN=Yes \
		-DCOMPILER_RT_ENABLE_PEDANTIC=OFF \
		-DCOMPILER_RT_ENABLE_STATIC_UNWINDER=OFF \
		-DCOMPILER_RT_BUILD_SANITIZERS=OFF \
		-DCOMPILER_RT_BUILD_XRAY=OFF \
		-DCOMPILER_RT_BUILD_LIBFUZZER=OFF \
		-DCOMPILER_RT_BUILD_PROFILE=OFF \
		-DCOMPILER_RT_BUILD_CTX_PROFILE=OFF \
		-DCOMPILER_RT_BUILD_MEMPROF=OFF \
		-DCOMPILER_RT_BUILD_ORC=OFF \
		-DCOMPILER_RT_HWASAN_WITH_INTERCEPTORS=OFF
	cmake --build build-libgcc -v

	# Install the libraries to a temporary location
	mkdir libgcc-libs
	DESTDIR="libgcc-libs" cmake --install build-libgcc

	# Before installing _solely_ `libgcc*`, not the just-built copies of any other libraries
	rm -rf /rootfs
	mkdir -p /rootfs/usr/lib
	for libgcc in $(find libgcc-libs ! -type d -name "libgcc*"); do
		cp -P $libgcc /rootfs/usr/lib/
	done
	# Also copy the expected `linux` subdirectory which symbolic links point to
	# This is justified as this subdirectory isn't built by default and is specific to the `libgcc` build
	cp -r libgcc-libs/usr/lib/linux /rootfs/usr/lib
EOF

FROM stagex/core-filesystem AS package-llvm
COPY --from=build /rootfs/ /

FROM stagex/core-filesystem AS package-llvm-libgcc
COPY --from=build-llvm-libgcc /rootfs/ /

