FROM scratch AS build
ARG VERSION
COPY --from=stagex/core-pkgconf . /
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-llvm . /
COPY --from=stagex/core-mold . /
COPY --from=stagex/core-onetbb . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-bsd-compat-headers . /
ADD fetch/tcl${VERSION}-src.tar.gz .
WORKDIR /tcl${VERSION}/unix
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--enable-64bit
	# The freshly built tclsh lives in the build dir and must locate its own
	# libtcl*.so to run the in-tree `configure-packages` step; musl does not
	# search the build dir by default.
	export LD_LIBRARY_PATH="/tcl${VERSION}/unix:$LD_LIBRARY_PATH"
	make -j "$(nproc)"
	make DESTDIR=/rootfs install install-private-headers
	# Strip DWARF from the shared lib; its debug sections are not reproducible.
	find /rootfs -name "*.so" -exec llvm-strip --strip-debug {} +
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
