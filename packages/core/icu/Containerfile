FROM scratch AS build
ARG VERSION
ARG VERSION_UNDER
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-llvm . /
COPY --from=stagex/core-mold . /
COPY --from=stagex/core-onetbb . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-libzstd . /
# ICU changed the source naming in 78.x: files use a literal dot in the version
# (icu4c-78.3-*) and the C++ source is now "-sources.tgz" instead of "-src.tgz".
ADD fetch/icu4c-${VERSION}-sources.tgz .
ADD fetch/icu4c-${VERSION}-data.zip .
ADD fetch/icu4c-${VERSION}-data-bin-l.zip .
ADD fetch/icu4c-${VERSION}-data-bin-b.zip .
WORKDIR /icu/source
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man
		--with-data-packaging=archive \
		--disable-samples \
		--enable-static
	make -j "$(nproc)"
	make DESTDIR=/rootfs install
	install -vDm644 -t /rootfs/usr/share/icu/${VERSION} /icu4c-${VERSION}-data.zip
	install -vDm644 -t /rootfs/usr/share/icu/${VERSION} /icu4c-${VERSION}-data-bin-b.zip
	install -vDm644 -t /rootfs/usr/share/icu/${VERSION} /icu4c-${VERSION}-data-bin-l.zip
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs /
