# Build musl for native target
FROM stagex/bootstrap-stage3 AS build
ARG TARGETARCH
ARG VERSION

ADD fetch/musl-${VERSION}.tar.gz .
COPY --from=stagex/core-mimalloc / /

WORKDIR /musl-${VERSION}
ADD *.patch .
RUN set -eux ; \
	ARCH=$(uname -m) ; \
	export CFLAGS="-Wformat -Werror=format-security -fstack-protector-strong -fstack-clash-protection" ; \
	export LDFLAGS="-Wl,--as-needed,-O1,--sort-common -Wl,-soname,libc.musl-${ARCH}.so.1" ; \
	patch -p1 < CVE-2025-26519.patch ; \
	sed -i -E s/"PTHREAD_KEYS_MAX[ ]+128"/"PTHREAD_KEYS_MAX 256"/ include/limits.h ; \
	rm -rf src/malloc ; \
	rm src/legacy/valloc.c ; \
	rm src/string/strdup.c ; \
	rm src/string/strndup.c ; \
	mkdir -p src/malloc/mallocng ; \
	echo "int __malloc_replaced = 1;" >> src/malloc/mallocng/stub.c ; \
	echo "int __aligned_alloc_replaced = 1;" >> src/malloc/mallocng/stub.c ; \
	echo "void __malloc_donate(char *a, char *b) {}" >> src/malloc/mallocng/stub.c ; \
	MIMALLOC_O=$(find /usr/lib -name mimalloc-secure.o) ; \
	KEEP="malloc __libc_malloc malloc_usable_size" ; \
	KEEP="$KEEP calloc __libc_calloc" ; \
	KEEP="$KEEP realloc __libc_realloc" ; \
	KEEP="$KEEP free __libc_free" ; \
	KEEP="$KEEP aligned_alloc memalign posix_memalign" ; \
	KEEP="$KEEP reallocarray" ; \
	KEEP="$KEEP valloc strdup strndup" ; \
	for symbol in $(nm -f just-symbols $MIMALLOC_O); do \
		EMPTY_IF_NOT_PRESENT=$(echo " $KEEP " | grep " $symbol " || true) ; \
		if [ "$EMPTY_IF_NOT_PRESENT" = "" ]; then \
			strip --strip-symbol="$symbol" $MIMALLOC_O || true ; \
		fi ; \
	done ; \
	export LDFLAGS="$LDFLAGS -Wl,--push-state,--whole-archive,$MIMALLOC_O,--pop-state" ; \
	./configure --prefix=/usr --sysconfdir=/etc --mandir=/usr/share/man --infodir=/usr/share/info --localstatedir=/var --enable-optimize ; \
	make -j "$(nproc)" ; \
	make DESTDIR=/rootfs install ; \
	mkdir -p /rootfs/usr/bin /rootfs/usr/lib ; \
	rm -rf /rootfs/lib ; \
	ln -sf /usr/lib/ld-musl-${ARCH}.so.1 /rootfs/usr/bin/ldd ; \
	mv -f /rootfs/usr/lib/libc.so /rootfs/usr/lib/ld-musl-${ARCH}.so.1 ; \
	ln -sf ld-musl-${ARCH}.so.1 /rootfs/usr/lib/libc.musl-${ARCH}.so.1 ; \
	ln -sf /usr/lib/ld-musl-${ARCH}.so.1 /rootfs/usr/lib/libc.so ; \
	ar r /rootfs/usr/lib/libc.a $MIMALLOC_O ; \
	mkdir c_runtime ; \
	cd c_runtime ; \
	ar x $(find /usr/lib -type f -name libgcc.a) ; \
	for file in $(ls); do \
		if [ ! "$(nm -f just-symbols $file | grep __popcountdi2)" = "" ]; then \
			ar r /rootfs/usr/lib/libc.a $file ; \
			break ; \
		fi ; \
	done
FROM stagex/core-filesystem AS package-musl
COPY --from=build /rootfs/ /

# Cross-compiled musl subpackage for multiple architectures
FROM stagex/bootstrap-stage3 AS build-musl-cross
COPY --from=stagex/pallet-clang /usr /usr
COPY --from=stagex/core-clang-rt-crt-cross / /
COPY --from=stagex/core-make / /
ARG VERSION
ADD fetch/musl-${VERSION}.tar.gz .
COPY files/ ./files/
WORKDIR /musl-${VERSION}
ADD *.patch .
# Build musl for each target
RUN set -eux ; \
	patch -p1 < CVE-2025-26519.patch ; \
	sed -i -E s/"PTHREAD_KEYS_MAX[ ]+128"/"PTHREAD_KEYS_MAX 256"/ include/limits.h ; \
	TARGETS="aarch64 armhf armv7 ppc64le x86_64 loongarch64" ; \
	for target in $TARGETS; do \
		echo "Building musl for $target..." ; \
		case $target in \
			aarch64) TRIPLET="aarch64-unknown-linux-musl" ;; \
			armhf) TRIPLET="armv7l-unknown-linux-musleabihf" ;; \
			armv7) TRIPLET="armv7l-unknown-linux-musleabihf" ;; \
			ppc64le) TRIPLET="powerpc64le-unknown-linux-musl" ;; \
			x86_64) TRIPLET="x86_64-unknown-linux-musl" ;; \
			loongarch64) TRIPLET="loongarch64-unknown-linux-musl" ;; \
		esac ; \
		MALLOC=mallocng ; \
		mkdir -p "build-${target}" ; \
		cd "build-${target}" ; \
		../configure --target=${TRIPLET} --prefix=/usr --sysconfdir=/etc --mandir=/usr/share/man --infodir=/usr/share/info --localstatedir=/var --host=${TRIPLET} CC="clang --target=${TRIPLET}" --with-malloc=${MALLOC} ; \
		make -j2 LIBCC= AR=/usr/bin/llvm-ar RANLIB=/usr/bin/llvm-ranlib ; \
		make DESTDIR=/rootfs install ; \
		mkdir -p /rootfs/usr/${TRIPLET}/bin ; \
		ln -sf /usr/${TRIPLET}/lib/ld-musl-${target}.so.1 /rootfs/usr/${TRIPLET}/bin/ldd ; \
		ln -sf ld-musl-${target}.so.1 /rootfs/usr/${TRIPLET}/lib/libc.musl-${target}.so.1 ; \
		mkdir -p "/rootfs/usr/${TRIPLET}/lib/clang/21/lib/${TRIPLET}" ; \
		cp -r /usr/lib/clang/21/lib/${TRIPLET}/* "/rootfs/usr/${TRIPLET}/lib/clang/21/lib/${TRIPLET}/" 2>/dev/null || true ; \
		cd / ; \
		rm -rf "build-${target}" ; \
	done ; \
	mkdir -p /rootfs/usr/share/doc/musl-cross ; \
	cp /musl-${VERSION}/COPYRIGHT /rootfs/usr/share/doc/musl-cross/

FROM scratch AS package-musl-cross
COPY --from=build-musl-cross /rootfs/ /
