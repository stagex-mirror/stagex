FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-meson . /
COPY --from=stagex/core-icu . /
ADD fetch/libpsl-${VERSION}.tar.gz .
WORKDIR /libpsl-${VERSION}
RUN --network=none <<-EOF
	meson setup build \
		-Dprefix=/usr \
		-Dlibdir=/usr/lib \
		-Dtests=false \
		-Ddefault_library=both
	meson compile -C build -j "$(nproc)"
	DESTDIR="/rootfs" meson install -C build
	install -Dm644 COPYING /rootfs/usr/share/licenses/libpsl/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

FROM package AS package-run
COPY --from=stagex/core-attr . /
COPY --from=stagex/core-icu . /

