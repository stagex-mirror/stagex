FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-meson . /
COPY --from=stagex/core-icu . /
ADD fetch/libpsl-${VERSION}.tar.gz .
WORKDIR /libpsl-${VERSION}
RUN meson setup build \
	-Dprefix=/usr \
	-Dlibdir=/usr/lib \
	-Dtests=false
RUN meson compile -C build -j "$(nproc)"
RUN DESTDIR="/rootfs" meson install -C build
RUN install -Dm644 COPYING /rootfs/usr/share/licenses/libpsl/LICENSE
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
