FROM scratch AS build
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-linux-headers . /
COPY --from=stagex/core-llvm . /
COPY --from=stagex/core-mold . /
COPY --from=stagex/core-onetbb . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-xz . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-perl . /
COPY --from=stagex/core-gettext . /
COPY --from=stagex/core-autoconf . /
COPY --from=stagex/core-automake . /
COPY --from=stagex/core-libtool . /
COPY --from=stagex/core-pkgconf . /
COPY --from=stagex/core-binutils . /
COPY --from=stagex/core-flex . /
COPY --from=stagex/core-bison . /
COPY --from=stagex/core-m4 . /
ARG VERSION
COPY --from=stagex/core-libxcb . /
COPY --from=stagex/core-xorgproto . /
COPY --from=stagex/core-xcb-proto . /
COPY --from=stagex/core-xmlto . /
COPY --from=stagex/core-util-macros . /
COPY --from=stagex/core-xtrans . /
COPY --from=stagex/core-libxdmcp . /
COPY --from=stagex/core-libxau . /
ADD fetch/libX11-${VERSION}.tar.xz .
WORKDIR /libX11-${VERSION}
RUN --network=none <<-EOF
	./configure ac_cv_path_RAWCPP='cc -E -' \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--disable-xf86bigfont
	make
	make install DESTDIR=/rootfs
EOF
ENTRYPOINT ["bin/sh"]
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
