FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
COPY --from=stagex/core-make . /
ADD fetch/cbindgen-${VERSION}.tar.gz .
WORKDIR /cbindgen-${VERSION}
ENV RUSTFLAGS="-C target-feature=+crt-static -C link-arg=-fuse-ld=mold -C strip=symbols"
ENV SOURCE_DATE_EPOCH=1
RUN cargo fetch
RUN --network=none <<-'EOF'
	set -eux
	if [ "$TARGETARCH" = "amd64" ]; then
		ARCH=x86_64
	elif [ "$TARGETARCH" = "arm64" ]; then
		ARCH=aarch64
	fi
	cargo build --frozen --release --target ${ARCH}-unknown-linux-musl
	install -vdm0755 /rootfs/usr/bin
	install -vDm755 -t /rootfs/usr/bin target/${ARCH}-unknown-linux-musl/release/cbindgen
	install -vDm644 -t /rootfs/usr/share/licenses/cbindgen LICENSE
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
