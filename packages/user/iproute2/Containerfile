FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/user-elfutils . /
ADD fetch/iproute2-${VERSION}.tar.xz .
WORKDIR /iproute2-${VERSION}
RUN --network=none <<-EOF
	ln -s /usr/bin/clang /usr/bin/gcc
	make V=1
	make DESTDIR=/rootfs install
	mv /rootfs/sbin /rootfs/usr/sbin
	install -vDm644 -t /rootfs/usr/include include/libnetlink.h
	install -vDm644 -t /rootfs/usr/lib lib/libnetlink.a
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
