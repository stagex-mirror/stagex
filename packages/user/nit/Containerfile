FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/nit-${VERSION}.tar.gz .
WORKDIR /nit
# Static by necessity: nit is the initramfs init (cpio /init), executed by
# the kernel before any rootfs is mounted — there is no musl dynamic loader
# in memory at that point. (Every other in-rootfs Rust binary is dynamic.)
ENV RUSTFLAGS='-C codegen-units=1 -C target-feature=+crt-static'
RUN cargo fetch
RUN --network=none <<-EOF
  set -eux
  ARCH=$(uname -m)
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p nit
  install -vDm755 target/${ARCH}-unknown-linux-musl/release/nit /rootfs/usr/bin/nit
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
