FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION

ADD fetch/${VERSION}.tar.gz .
WORKDIR /hardened_malloc-${VERSION}

RUN --network=none <<-EOF
	set -eux
	# Upstream Makefile hardcodes -lstdc++ and assumes the default linker
	# supports LTO via LLVMgold.so. We use libc++ and lld instead.
	sed -i 's/-lstdc++/-lc++/g' Makefile
	export LDFLAGS="--ld-path=/usr/bin/ld.lld"
	make CONFIG_NATIVE=false CC=clang -j "$(nproc)"
	mkdir -p /rootfs/usr/lib
	install -vDm755 -t /rootfs/usr/lib out/libhardened_malloc.so
	install -vDm644 -t /rootfs/usr/share/licenses/hardened_malloc LICENSE
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
