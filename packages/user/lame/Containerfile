FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-make . /
ADD fetch/lame-${VERSION}.tar.gz .
WORKDIR /lame-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/lame-${VERSION}=."
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--disable-shared \
		--enable-nasm \
		--disable-frontend
	make -j$(nproc)
	DESTDIR=/rootfs make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/lame/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
