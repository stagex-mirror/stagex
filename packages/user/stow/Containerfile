FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-make . /
COPY --from=stagex/core-perl . /
ADD fetch/stow-${VERSION}.tar.gz .
WORKDIR /stow-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/stow-${VERSION}=."
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--disable-silent-rules
	make -j$(nproc)
	DESTDIR=/rootfs make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/stow/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
