FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/tlrc-v${VERSION}.tar.gz .
WORKDIR /tlrc-${VERSION}
ENV RUST_BACKTRACE=1
ENV RUSTFLAGS="-C codegen-units=1 -C target-feature=+crt-static"
RUN cargo fetch
RUN --network=none <<-EOF
	cargo build \
		--frozen \
		--release \
		--target ${ARCH}-unknown-linux-musl \
		--bin tldr
	mkdir -p /rootfs/usr/bin
	cp target/${ARCH}-unknown-linux-musl/release/tldr /rootfs/usr/bin/
	install -Dm644 LICENSE /rootfs/usr/share/licenses/tldr/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
