From: Stagex Build System
Date: 2026-03-30
Subject: Use system fftw3 instead of downloading

--- a/third-party/fftw3/CMakeLists.txt
+++ b/third-party/fftw3/CMakeLists.txt
@@ -3,17 +3,13 @@
 # Copyright Advanced Micro Devices, Inc.
 # SPDX-License-Identifier: MIT
 
-set(_source_dir "${CMAKE_CURRENT_BINARY_DIR}/source")
-set(_download_stamp "${_source_dir}/download.stamp")
-
-therock_subproject_fetch(fftw3-sources
-  SOURCE_DIR "${_source_dir}"
-  # Originally mirrored from: "https://fftw.org/fftw-3.3.10.tar.gz"
-  URL "https://rocm-third-party-deps.s3.us-east-2.amazonaws.com/fftw-3.3.10.tar.gz"
-  URL_HASH "SHA256=90562845b01e4bdc8772d5b6c5df4f613b8704cf384c597c95791a8e068a4878"
-  TOUCH "${_download_stamp}"
-)
+# Use system fftw3
+find_package(FFTW3 REQUIRED)
 
-therock_cmake_subproject_declare(therock-fftw3
-  EXTERNAL_SOURCE_DIR "fftw3"
-  USE_DIST_AMDGPU_TARGETS
-  NO_MERGE_COMPILE_COMMANDS
-  BACKGROUND_BUILD
-  OUTPUT_ON_FAILURE
-  EXTRA_DEPENDS "${_download_stamp}"
-)
+# Provide package for downstream dependencies
+set(FFTW3_SOURCE_DIR "/usr")
+
+therock_cmake_subproject_declare(therock-fftw3
+  EXTERNAL_SOURCE_DIR "${FFTW3_SOURCE_DIR}"
+  USE_DIST_AMDGPU_TARGETS
+  NO_MERGE_COMPILE_COMMANDS
+)
