From: Stagex Build System
Date: 2026-03-30
Subject: Use system flatbuffers, fmt, googletest, grpc instead of downloading

--- a/third-party/flatbuffers/CMakeLists.txt
+++ b/third-party/flatbuffers/CMakeLists.txt
@@ -3,17 +3,13 @@
 # Copyright Advanced Micro Devices, Inc.
 # SPDX-License-Identifier: MIT
 
-set(_source_dir "${CMAKE_CURRENT_BINARY_DIR}/source")
-set(_download_stamp "${_source_dir}/download.stamp")
-
-therock_subproject_fetch(flatbuffers-sources
-  SOURCE_DIR "${_source_dir}"
-  # Originally mirrored from: "https://github.com/google/flatbuffers/archive/refs/tags/v25.2.10.tar.gz"
-  URL "https://rocm-third-party-deps.s3.us-east-2.amazonaws.com/flatbuffers-25.9.23.tar.gz"
-  URL_HASH "SHA256=7e998a93d0a9e23e7a1c51b91e9c9dcc7f67f211d0f0f0e0e0e0e0e0e0e0e0e0"
-  TOUCH "${_download_stamp}"
-)
+# Use system flatbuffers
+find_package(flatbuffers REQUIRED)
 
-therock_cmake_subproject_declare(therock-flatbuffers
-  EXTERNAL_SOURCE_DIR "flatbuffers"
-  USE_DIST_AMDGPU_TARGETS
-  NO_MERGE_COMPILE_COMMANDS
-  BACKGROUND_BUILD
-  OUTPUT_ON_FAILURE
-  EXTRA_DEPENDS "${_download_stamp}"
-)
+# Provide package for downstream dependencies
+set(flatbuffers_SOURCE_DIR "/usr")
+
+therock_cmake_subproject_declare(therock-flatbuffers
+  EXTERNAL_SOURCE_DIR "${flatbuffers_SOURCE_DIR}"
+  USE_DIST_AMDGPU_TARGETS
+  NO_MERGE_COMPILE_COMMANDS
+)
