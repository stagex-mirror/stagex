From: Stagex Build System
Date: 2026-03-30
Subject: Make SPIRV-Headers optional in spirv-llvm-translator

This patch makes SPIRV-Headers download optional, using system headers if available.

--- a/compiler/spirv-llvm-translator/CMakeLists.txt
+++ b/compiler/spirv-llvm-translator/CMakeLists.txt
@@ -40,8 +40,11 @@ if(SPIRV_LLVM_TRANSLATOR_SKIP_DOWNLOAD)
 endif()
 
 # Try to download SPIRV-Headers
-FetchContent_Declare(
-  spirv-headers
-  GIT_REPOSITORY https://github.com/KhronosGroup/SPIRV-Headers.git
-  GIT_TAG ${SPIRV_HEADERS_TAG}
-)
-FetchContent_MakeAvailable(spirv-headers)
+
+
+
+# Use system SPIRV-Headers if available
+find_package(SPIRV-Headers QUIET)
+if(NOT SPIRV_HEADERS_FOUND)
+  message(STATUS "SPIRV-Headers not found, using bundled version")
+  FetchContent_Declare(
+    spirv-headers
+    GIT_REPOSITORY https://github.com/KhronosGroup/SPIRV-Headers.git
+    GIT_TAG ${SPIRV_HEADERS_TAG}
+  )
+  FetchContent_MakeAvailable(spirv-headers)
+endif()
