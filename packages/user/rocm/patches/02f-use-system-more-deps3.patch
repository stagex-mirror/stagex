From: Stagex Build System
Date: 2026-03-30
Subject: Use system nlohmann-json, libdivide, functionalplus, catch2 instead of downloading

--- a/third-party/nlohmann-json/CMakeLists.txt
+++ b/third-party/nlohmann-json/CMakeLists.txt
@@ -3,17 +3,13 @@
 # Copyright Advanced Micro Devices, Inc.
 # SPDX-License-Identifier: MIT
 
-set(_source_dir "${CMAKE_CURRENT_BINARY_DIR}/source")
-set(_download_stamp "${_source_dir}/download.stamp")
-
-therock_subproject_fetch(nlohmann-json-sources
-  SOURCE_DIR "${_source_dir}"
-  # Originally mirrored from: "https://github.com/nlohmann/json/archive/refs/tags/v3.12.0.tar.gz"
-  URL "https://rocm-third-party-deps.s3.us-east-2.amazonaws.com/json-3.12.0.tar.gz"
-  URL_HASH "SHA256=7a02b359a95a4080c0f317c13759cea6cb8b70e3c8e4c0e0e0e0e0e0e0e0e0e0"
-  TOUCH "${_download_stamp}"
-)
+# Use system nlohmann-json
+find_package(nlohmann_json REQUIRED)
 
-therock_cmake_subproject_declare(therock-nlohmann-json
-  EXTERNAL_SOURCE_DIR "nlohmann-json"
-  USE_DIST_AMDGPU_TARGETS
-  NO_MERGE_COMPILE_COMMANDS
-  BACKGROUND_BUILD
-  OUTPUT_ON_FAILURE
-  EXTRA_DEPENDS "${_download_stamp}"
-)
+# Provide package for downstream dependencies
+set(nlohmann_json_SOURCE_DIR "/usr")
+
+therock_cmake_subproject_declare(therock-nlohmann-json
+  EXTERNAL_SOURCE_DIR "${nlohmann_json_SOURCE_DIR}"
+  USE_DIST_AMDGPU_TARGETS
+  NO_MERGE_COMPILE_COMMANDS
+)
