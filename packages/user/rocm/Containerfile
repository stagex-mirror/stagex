COPY --from=rocthrust-build /rootfs/ /
COPY --from=hipcub-build /rootfs/ /
COPY --from=rocfft-build /rootfs/ /
COPY --from=rocrand-build /rootfs/ /
COPY --from=rocsolver-build /rootfs/ /
COPY --from=rocblas-build /rootfs/ /
COPY --from=rocsparse-build /rootfs/ /
COPY --from=hipblas-common-build /rootfs/ /
COPY --from=hipblas-build /rootfs/ /
COPY --from=hipblaslt-build /rootfs/ /
COPY --from=hipfft-build /rootfs/ /
