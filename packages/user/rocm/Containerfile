FROM rocm-base AS rocm-core-build
WORKDIR /
RUN tar -xzf rocm-systems.tar.gz && mv rocm-systems-develop rocm-systems
RUN --network=none <<-'EOF'
    set -e
    export PATH="/usr/lib/llvm-amd/bin:$PATH"
    export LLVM_DIR="/usr/lib/llvm-amd/lib/cmake/llvm"
    export CMAKE_PREFIX_PATH="/usr/lib/llvm-amd/lib/cmake:/usr/lib/llvm-amd/lib/cmake/llvm:${CMAKE_PREFIX_PATH:-}"
    rm -rf /rocm-systems/projects/rocm-core/build
    mkdir -p /rocm-systems/projects/rocm-core/build && cd /rocm-systems/projects/rocm-core/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_C_COMPILER=/usr/lib/llvm-amd/bin/clang -DCMAKE_CXX_COMPILER=/usr/lib/llvm-amd/bin/clang++ -DROCM_CMAKE_DIR=/usr/lib/cmake/rocm -DROCM_VERSION=7.11.0 ..
    ninja
    DESTDIR=/rootfs ninja install
    mkdir -p /usr/bin /usr/include /usr/lib /usr/libexec /usr/share /usr/amdgcn
    find /rootfs/usr -mindepth 1 -maxdepth 1 -type d -o -type l | while read dir; do
        basename=$(basename "$dir")
        [ "$basename" = "lib64" ] && continue
        cp -rf "$dir"/* /usr/ 2>/dev/null || true
    done
EOF

