# ============================================================================
# Stage: Build LLVM
# ============================================================================

FROM build AS llvm-build
WORKDIR /
RUN tar -xzf llvm-project.tar.gz && mv llvm-project-amd-mainline llvm-project
RUN --network=none <<-EOF
    set -e
    mkdir -p /llvm-project/llvm/build
    cd /llvm-project/llvm/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DLLVM_BUILD_LLVM_DYLIB=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_ENABLE_PROJECTS="clang;lld" \
        -DLLVM_TARGETS_TO_BUILD="X86;AMDGPU" \
        -DLLVM_AMDGPU_TGT_GFX1030=ON \
        -DLLVM_AMDGPU_TGT_GFX1100=ON \
        -DLLVM_INSTALL_TOOLCHAIN_ONLY=OFF \
        -DLLVM_ENABLE_TERMINFO=OFF \
        -DLLVM_EXTERNAL_ROCM_DEVICE_LIBS_SOURCE_DIR=/llvm-project/amd/device-libs \
        -DLLVM_EXTERNAL_PROJECTS="rocm-device-libs" \
        ..
    ninja -j"$(nproc)"
    DESTDIR=/rootfs ninja install
EOF
# Build and install AMD device-libs
RUN --network=none <<-EOF
    set -e
    mkdir -p /llvm-project/amd/device-libs/build
    cd /llvm-project/amd/device-libs/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DLLVM_DIR=/usr/lib/cmake/llvm \
        -DCLANG_DIR=/usr/lib/cmake/clang \
        ..
    ninja
    DESTDIR=/rootfs ninja install
EOF

# ============================================================================
# Stage: Build AMD ComGR (part of LLVM monorepo)
# ============================================================================

FROM llvm-build AS amd_comgr-build
WORKDIR /
# Copy AMDDeviceLibs cmake config from llvm-build's rootfs to /usr
RUN --network=none <<-EOF
    set -e
    mkdir -p /usr/lib64/cmake/AMDDeviceLibs
    cp /rootfs/usr/lib64/cmake/AMDDeviceLibs/AMDDeviceLibsConfig.cmake /usr/lib64/cmake/AMDDeviceLibs/
EOF
RUN --network=none <<-EOF
    set -e
    mkdir -p /llvm-project/amd/comgr/build
    cd /llvm-project/amd/comgr/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DLLVM_DIR=/usr/lib/cmake/llvm \
        -DCLANG_DIR=/usr/lib/cmake/clang \
        -DLLD_DIR=/usr/lib/cmake/lld \
        -DAMDDeviceLibs_DIR=/usr/lib64/cmake/AMDDeviceLibs \
        -DCMAKE_PREFIX_PATH="/usr/lib64/cmake:/usr/lib/cmake" \
        ..
    ninja
    DESTDIR=/rootfs ninja install
EOF

# ============================================================================
# Stage: Build ROCm Base Infrastructure
# ============================================================================

FROM amd_comgr-build AS rocm-base
WORKDIR /
RUN tar -xzf rocm-cmake.tar.gz && mv rocm-cmake-master rocm-cmake
RUN --network=none <<-EOF
    set -e
    export CMAKE_PREFIX_PATH="/usr/lib/cmake:${CMAKE_PREFIX_PATH:-}"
    mkdir -p /rocm-cmake/build && cd /rocm-cmake/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr ..
    ninja
    DESTDIR=/rootfs ninja install
EOF

# ============================================================================
# Stage: Build rocm-core

FROM rocm-base AS rocm-core-build
WORKDIR /
COPY --from=rocm-base /rootfs/ /
RUN tar -xzf rocm-systems.tar.gz && mv rocm-systems-develop rocm-systems
RUN --network=none <<-EOF
    set -e
    export CMAKE_PREFIX_PATH="/usr/lib/cmake:${CMAKE_PREFIX_PATH}"
    rm -rf /rocm-systems/projects/rocm-core/build
    mkdir -p /rocm-systems/projects/rocm-core/build && cd /rocm-systems/projects/rocm-core/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DROCM_CMAKE_DIR=/usr/lib/cmake/rocm -DROCM_VERSION=7.11.0 ..
    ninja
    DESTDIR=/rootfs ninja install
EOF

