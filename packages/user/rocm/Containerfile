FROM rocr-runtime-build AS rocminfo-build
WORKDIR /
COPY --from=rocr-runtime-build /usr/ /usr/
COPY --from=fetch rocm-cmake.tar.gz /
RUN tar -xzf rocm-cmake.tar.gz && mv rocm-cmake-master /usr/lib/cmake/rocm
RUN --network=none <<-'EOF'
    set -e
    export PATH="/usr/lib/llvm-amd/bin:$PATH"
    export LLVM_DIR="/usr/lib/llvm-amd/lib/cmake/llvm"
    export CMAKE_PREFIX_PATH="/usr/lib/llvm-amd/lib/cmake:/usr/lib/llvm-amd/lib/cmake/llvm:/usr/lib/cmake:/usr/lib/cmake/hsa-runtime64:${CMAKE_PREFIX_PATH:-}"
    ls -la /usr/lib/cmake/
    ls -la /usr/lib/cmake/hsa-runtime64/ 2>&1 || echo "hsa-runtime64 directory NOT FOUND"
    ls -la /usr/lib/libhsa-runtime64* 2>&1 || echo "libhsa-runtime64 files NOT FOUND"
    mkdir -p /rocm-systems/projects/rocminfo/build && cd /rocm-systems/projects/rocminfo/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_C_COMPILER=/usr/lib/llvm-amd/bin/clang -DCMAKE_CXX_COMPILER=/usr/lib/llvm-amd/bin/clang++ -DROCM_CMAKE_DIR=/usr/lib/cmake/rocm -DROCM_VERSION=7.11.0 -Dhsa-runtime64_DIR=/usr/lib/cmake/hsa-runtime64 ..
    ninja
    DESTDIR=/rootfs ninja install
    mkdir -p /usr/bin /usr/include /usr/lib /usr/libexec /usr/share /usr/amdgcn
    find /rootfs/usr -mindepth 1 -maxdepth 1 -type d -o -type l | while read dir; do
        basename=$(basename "$dir")
        [ "$basename" = "lib64" ] && continue
        cp -rf "$dir"/* /usr/ 2>/dev/null || true
    done
EOF

