#endif // AMD_TRAP_HANDLER_V2_H
HEADER

    mkdir -p /rocm-systems/projects/rocr-runtime/build/runtime/hsa-runtime/core/runtime/blit_shaders
    cat > /rocm-systems/projects/rocr-runtime/build/runtime/hsa-runtime/core/runtime/blit_shaders/amd_blit_shaders_v2.h << 'HEADER'
