    export PATH="/usr/bin:/usr/lib/llvm-22/bin:${PATH}"
    export CMAKE_PREFIX_PATH="/usr/lib/cmake:${CMAKE_PREFIX_PATH}"
    mkdir -p /rocm-systems/projects/rocr-runtime/build && cd /rocm-systems/projects/rocr-runtime/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DROCM_CMAKE_DIR=/usr/lib/cmake/rocm -DROCM_VERSION=7.11.0 -DBUILD_SHARED_LIBS=ON -DBUILD_ROCR_PROFILER=OFF ..
    ninja
    DESTDIR=/rootfs ninja install
EOF

