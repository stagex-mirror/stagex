    cd /rocm-systems/projects/rocr-runtime/build
    
    cmake -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_C_COMPILER=/usr/lib/llvm-amd/bin/clang \
        -DCMAKE_CXX_COMPILER=/usr/lib/llvm-amd/bin/clang++ \
        -DCMAKE_C_STANDARD=11 \
        -DCMAKE_C_FLAGS="-Wno-error -Wno-typedef-redefinition -DHSA_IMAGE_SUPPORT=0" \
        -DCMAKE_CXX_STANDARD=17 \
        -DROCM_PATH=/usr \
        -DLLVM_DIR=/usr/lib/llvm-amd/lib/cmake/llvm \
        -DClang_DIR=/usr/lib/llvm-amd/lib/cmake/clang \
        -DHSA_BUILD_DIR=/usr/lib/rocm \
        -DHSA_BUILD_HSAI=OFF \
        -DHSA_IMAGE_SUPPORT=OFF \
        -DHSA_IMAGE_BUILD=OFF \
        -DHSA_BUILD_HSA1=OFF \
        -DHSA_BUILD_SHADER=OFF \
        -DHSA_ENABLE_AMDGPU=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_ROCR_PROFILER=OFF \
        ..
    
    # Fix nullptr type initialization issue in executable.cpp - rebuild forced 2026-04-12
    sed -i 's/return NULL;/return 0;/' /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/loader/executable.cpp
    # Ensure library directory exists before install
    mkdir -p /rootfs/usr/lib
    ninja -j4
    DESTDIR=/rootfs ninja install
    mkdir -p /usr/bin /usr/include /usr/lib /usr/libexec /usr/share /usr/amdgcn
    # Copy all from rootfs to usr
    cp -r /rootfs/usr/* /usr/ 2>/dev/null || true
    # Force copy cmake directory to ensure hsa-runtime64 is included
    cp -rf /rootfs/usr/lib/cmake/* /usr/lib/cmake/ 2>/dev/null || true
    # Fix: hsa-runtime64 CMake config references /usr/lib/libhsa-runtime64.so.1.21.0
    # Ensure the library exists at that path
    if [ -f /usr/lib/libhsa-runtime64.so.1.21.0 ]; then
        ln -sf /usr/lib/libhsa-runtime64.so.1.21.0 /usr/lib/libhsa-runtime64.so.1
        ln -sf /usr/lib/libhsa-runtime64.so.1 /usr/lib/libhsa-runtime64.so
    fi
EOF

