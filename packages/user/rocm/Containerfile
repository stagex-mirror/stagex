FROM rocprofiler-register-build AS rocr-runtime-build
WORKDIR /
RUN tar -xzf rocm-systems.tar.gz && mv rocm-systems-develop rocm-systems
# Force rebuild - hsa-runtime64 cmake files fix 2026-04-12 v2
RUN --network=none <<-'EOF'
    set -e
    # Force rebuild by echoing a unique timestamp
    echo "Rebuilding rocr-runtime $(date) $(date +%s%N)"
    export PATH="/usr/lib/llvm-amd/bin:$PATH"
    export LLVM_DIR="/usr/lib/llvm-amd/lib/cmake/llvm"
    export CMAKE_PREFIX_PATH="/usr/lib/llvm-amd/lib/cmake:/usr/lib/llvm-amd/lib/cmake/llvm:${CMAKE_PREFIX_PATH:-}"
    

    rm -rf /rocm-systems/projects/rocr-runtime/build
    mkdir -p /rocm-systems/projects/rocr-runtime/build
    # Disable AMDGPU shader compilation - AMD-LLVM clang has compatibility issues
    # Comment out add_subdirectory calls and their dependencies to preserve CMake syntax
    sed -i "s|add_subdirectory( \${CMAKE_CURRENT_SOURCE_DIR}/core/runtime/trap_handler )|#add_subdirectory( \${CMAKE_CURRENT_SOURCE_DIR}/core/runtime/trap_handler ) # Disabled - using placeholder headers|" /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    sed -i "s|add_dependencies( \${CORE_RUNTIME_TARGET} amd_trap_handler_v2 )|#add_dependencies( \${CORE_RUNTIME_TARGET} amd_trap_handler_v2 ) # Disabled|" /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    sed -i "s|add_subdirectory( \${CMAKE_CURRENT_SOURCE_DIR}/core/runtime/blit_shaders )|#add_subdirectory( \${CMAKE_CURRENT_SOURCE_DIR}/core/runtime/blit_shaders ) # Disabled - using placeholder headers|" /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    sed -i "s|add_dependencies( \${CORE_RUNTIME_TARGET} amd_blit_shaders_v2)|#add_dependencies( \${CORE_RUNTIME_TARGET} amd_blit_shaders_v2) # Disabled|" /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    sed -i "s|add_subdirectory( \${CMAKE_CURRENT_SOURCE_DIR}/image/blit_src )|#add_subdirectory( \${CMAKE_CURRENT_SOURCE_DIR}/image/blit_src ) # Disabled|" /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    sed -i "s|add_dependencies( \${CORE_RUNTIME_TARGET} opencl_blit_objects )|#add_dependencies( \${CORE_RUNTIME_TARGET} opencl_blit_objects ) # Disabled|" /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    # Remove opencl_blit_objects.cpp from IMAGE_SRCS (replace with empty to preserve set() syntax)
    sed -i 's|${CMAKE_CURRENT_BINARY_DIR}/image/blit_src/opencl_blit_objects.cpp||' /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    # Fix trailing whitespace before closing paren in set()
    sed -i 's/[[:space:]]*)/)/' /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    # Remove broken set_source_files_properties line
    sed -i '/set_source_files_properties.*PROPERTIES GENERATED/d' /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    # Completely disable image support by commenting out image add_subdirectory
    sed -i "s|add_subdirectory( \${CMAKE_CURRENT_SOURCE_DIR}/image )|#add_subdirectory( \${CMAKE_CURRENT_SOURCE_DIR}/image ) # Disabled image support|" /rocm-systems/projects/rocr-runtime/runtime/hsa-runtime/CMakeLists.txt
    mkdir -p /rocm-systems/projects/rocr-runtime/build/runtime/hsa-runtime/core/runtime/trap_handler
    cat > /rocm-systems/projects/rocr-runtime/build/runtime/hsa-runtime/core/runtime/trap_handler/amd_trap_handler_v2.h << 'HEADER'
//==============================================================================
//  This file is automatically generated - placeholder for build
//==============================================================================

#ifndef AMD_TRAP_HANDLER_V2_H
#define AMD_TRAP_HANDLER_V2_H

namespace rocr {
namespace AMD {

// V2 trap handler constants (V1 constants already defined in amd_trap_handler_v1.h)
static const unsigned char kCodeTrapHandlerV2[] = { 0 };
static const size_t kCodeTrapHandlerV2_size = 0;

static const unsigned char kCodeTrapHandlerV2_9[] = { 0 };
static const size_t kCodeTrapHandlerV2_9_size = 0;

static const unsigned char kCodeTrapHandlerV2_942[] = { 0 };
static const size_t kCodeTrapHandlerV2_942_size = 0;

static const unsigned char kCodeTrapHandlerV2_1010[] = { 0 };
static const size_t kCodeTrapHandlerV2_1010_size = 0;

static const unsigned char kCodeTrapHandlerV2_10[] = { 0 };
static const size_t kCodeTrapHandlerV2_10_size = 0;

static const unsigned char kCodeTrapHandlerV2_11[] = { 0 };
static const size_t kCodeTrapHandlerV2_11_size = 0;

static const unsigned char kCodeTrapHandlerV2_12[] = { 0 };
static const size_t kCodeTrapHandlerV2_12_size = 0;

