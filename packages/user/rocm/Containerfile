# ============================================================================
# Stage: Build clr (ROCm Common Runtime Layer) with HIP

FROM rocr-runtime-build AS clr-build
WORKDIR /
COPY --from=rocr-runtime-build /rootfs/ /
RUN tar -xzf hipify.tar.gz && mv HIPIFY-amd-mainline hipify
RUN --network=none <<-EOF
    set -e
    export CMAKE_PREFIX_PATH="/usr/lib/cmake:${CMAKE_PREFIX_PATH}"
    mkdir -p /rocm-systems/projects/clr/build && cd /rocm-systems/projects/clr/build
    cmake -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DROCM_CMAKE_DIR=/usr/lib/cmake/rocm \
        -DCLR_BUILD_HIP=ON \
        -DHIP_COMMON_DIR=/hipify \
        -DHIPCC_BIN_DIR=/usr/bin \
        -DHIP_PLATFORM=amd \
        ..
    ninja
    DESTDIR=/rootfs ninja install
EOF

