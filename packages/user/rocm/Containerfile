RUN --network=none <<-EOF
    set -e
    export CMAKE_PREFIX_PATH="/usr/lib/cmake:${CMAKE_PREFIX_PATH}"
    mkdir -p /rocm-libraries/projects/composablekernel/build && cd /rocm-libraries/projects/composablekernel/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DROCM_CMAKE_DIR=/usr/lib/cmake/rocm -DROCM_VERSION=7.11.0 ..
    ninja
    DESTDIR=/rootfs ninja install
EOF

# ============================================================================
# Stage: Build RCCL

FROM composablekernel-build AS rccl-build
WORKDIR /
COPY --from=composablekernel-build /rootfs/ /
RUN --network=none <<-EOF
    set -e
    export CMAKE_PREFIX_PATH="/usr/lib/cmake:${CMAKE_PREFIX_PATH}"
    mkdir -p /rocm-systems/projects/rccl/build && cd /rocm-systems/projects/rccl/build
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DROCM_CMAKE_DIR=/usr/lib/cmake/rocm -DROCM_VERSION=7.11.0 ..
    ninja
    DESTDIR=/rootfs ninja install
EOF

# ============================================================================
# Final package stage
# ============================================================================

FROM stagex/core-filesystem AS package
COPY --from=rocm-core-build /rootfs/ /
COPY --from=rocminfo-build /rootfs/ /
COPY --from=clr-build /rootfs/ /
COPY --from=rocr-runtime-build /rootfs/ /
