FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/wardend-${VERSION}.tar.gz .
# The archive extracts to the base image's default cwd `/` (the workspace
# root: /Cargo.toml + /src/). The working dir MUST be `/` so the relative
# `src/...` installs and cargo's default `target/` dir both resolve (the old
# `WORKDIR /wardend` left the cwd in an empty dir, so the binaries built to
# /target but the install looked in /wardend/target, and the unit-file
# installs failed with "can't stat src/...").
#
# The codeberg archive is NESTED under `wardend/` (the repo root), but the
# Containerfile expects a FLAT layout (the workspace root at `/`). The
# repacked archive in the local fetch cache is flat, so the `ADD` above
# extracts directly to `/`. If the mirror's nested archive is ever used
# (e.g. the local cache file is deleted and re-downloaded), the fallback
# below moves the nested contents to `/` so the build still works.
RUN if [ -d /wardend ]; then mv /wardend/* /wardend/.[!.]* / 2>/dev/null; rmdir /wardend; fi
# bootproof: the path dep for the seal + wardenctl crates (the bootproof
# generic engine + the bootproof-platform-wardend verifier). The wardend
# archive is FLAT at /, so the path dep `../../../bootproof/crates/<crate>`
# resolves to /bootproof/crates/<crate>. The bootproof archive's top-level
# IS `bootproof/`, so the ADD extracts directly to /bootproof (no mv). This
# MUST precede `cargo fetch` (cargo fetch resolves the workspace, so the
# path deps must exist). The archive is in the same build context (the
# [sources.bootproof] in the package.toml drops it into fetch/user/wardend).
ARG BOOTPROOF_SOURCE
ADD fetch/${BOOTPROOF_SOURCE} .
# The bootproof crate's build.rs links the tss2 C stack DYNAMICALLY +
# bindgens the devicemapper structs from libdevmapper.h at build time, so
# the tss2 + lvm2 shared objects + headers must be present in the build
# context (the SAME two COPYs the bootproof Containerfile uses). The .pc
# files' Libs lines are emptied in the build RUN below so no pkg-config
# probe emits link flags (the crate's own cargo:rustc-link-arg owns the
# final link line). This is needed for the wardenctl build (it reuses the
# bootproof generic engine + the platform-wardend verifier, which depend
# on the bootproof crate's build.rs).
COPY --from=stagex/user-tpm2-tss . /
COPY --from=stagex/user-lvm2 . /
WORKDIR /
# The wardend stack has real crates.io deps (russh/sshdt for posternd, tokio,
# aws-lc-sys, ...; 257 lock packages), so the build follows the execd pattern:
# `cargo fetch` with network ON, then the compile with --network=none and
# --frozen (the lock is complete for the shipped feature set).
#
# warden MUST be built with --features gvisor,container: the default feature
# set is container-only, and the gvisor moat is what runs the netstack
# sandbox (the sn-7 kernel-offline wire). A wardend built without the gvisor
# feature has no moat for the `type = "gvisor"` netstack unit -> the warden
# fail-closes ("sandbox kind gvisor has no matching moat") and the guest
# panics. The other four binaries build with their default features.
RUN cargo fetch
RUN --network=none <<-EOF
  set -eux
  ARCH=$(uname -m)
  # The cwd is the workspace root `/` (see the WORKDIR above), so cargo's
  # default target dir `target/` and the relative `src/...` paths below all
  # resolve to the same tree.
  T="target/${ARCH}-unknown-linux-musl/release"
  # Clear any stale warden artifacts so the final binary is always relinked
  # (a stale fingerprint + a missing binary makes cargo skip the link).
  rm -rf "${T}/deps/warden-*" "${T}/deps/libwarden*" \
         "${T}/.fingerprint/warden-*" "${T}/.fingerprint/wardend-*" 2>/dev/null || true
  rm -f  "${T}/wardend" 2>/dev/null || true
  # The SAME stale-fingerprint trap for wardend-bridge: a new [[bin]] (the
  # nginx-srv vhost stand-in) added to the package is not relinked when the
  # BuildKit layer cache reuses the prior build's target dir (the old
  # build's bins are present, but the new nginx-srv bin is missing -> the
  # install can't stat it). Clear the package's stale artifacts so the
  # final binaries are always relinked. (dpmon + offline-srv are deleted;
  # their stale artifacts are cleared too, harmlessly.)
  rm -rf "${T}/deps/wardend-bridge-*" "${T}/deps/libwardend_bridge*" \
         "${T}/.fingerprint/wardend-bridge-*" 2>/dev/null || true
  rm -f  "${T}/nginx-srv" "${T}/offline-srv" "${T}/dpmon" 2>/dev/null || true
  # warden: the gvisor + container moats (the netstack + the xdp-attach
  # container oneshot).
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    --features gvisor,container \
    -p warden --bin wardend
  # regent (regentd + wardend-watchdog), postern (posternd),
  # wardend-bridge (nginx-srv), xattach.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p regent -p postern -p wardend-bridge -p xattach -p keep
  # bastion (bastiond): the sandbox init that owns the wire. It replaces
  # `bridge wire` as the bundle's config.json process.args. The bundle's
  # init is now bastiond; the bridge crate still builds (bastiond links its
  # tcp/ws relay core), but the bridge BINARY is no longer the sandbox init.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p bastion
  # seal (seald): the evidence daemon. Runs as an IN-SANDBOX co-tenant of
  # bridge wire (the netstack sandbox); the bundle's config.json
  # linux.devices passes through /dev/tpmrm0 + /dev/tpm0 + /dev/sev-guest so
  # seald's TPM2 / SEV-SNP evidence path works in-sandbox.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p seal
  # wardenctl: the local TRUSTED admin client (the wardenctl target's client
  # side). A HOST-side tool (NOT a sandbox co-tenant) — it runs on the
  # admin's machine. It reuses the seal crate's pure-Rust crypto (P-256 /
  # ECDSA / SHA-256) + the bootproof generic engine (the verify_bundle + the
  # platform-wardend verifier). The bootproof crate's build.rs links the
  # tss2 C stack dynamically, so empty the .pc files' Libs lines first
  # (the SAME sed the bootproof Containerfile uses) so no pkg-config probe
  # emits link flags (the crate's own cargo:rustc-link-arg owns the final
  # link line). Built with the default features (no gvisor/container).
  for f in esys sys mu rc tcti-device tctildr; do
    sed -i 's|^Libs:.*|Libs: |' /usr/lib/pkgconfig/tss2-$f.pc
  done
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p wardenctl
  # scribe (scribed): the log ring buffer. A PER-DAEMON gvisor unit (one of
  # the per-daemon sandboxes, like seald + posternd).
  # It is PURE-STANDALONE (no workspace deps, no feature flags) — it builds
  # with the SAME frozen lock but WITHOUT the gvisor/container features
  # (those are warden's, not scribe's; a `--features warden/gvisor` form
  # fails). The write socket (SOCK_SEQPACKET — host-bound in gVisor, see
  # bind_seqpacket_listener) + the read socket (stream UDS, framed) both
  # land in the devices dir.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p scribe
  # bailiff (bailiffd): the optional k8s-worker adapter (Pod assignments ->
  # unit files via the wardend-unit converter). Reserved (no unit file ships
  # for it yet), but it is a daemon of this repo, so the package ships it
  # with the rest. Pure workspace deps (wardend-unit + wardend-bus), so the
  # frozen lock covers it.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p bailiff
  R="${T}"
  install -vDm755 "$R/wardend"  /rootfs/usr/bin/wardend
  install -vDm755 "$R/regentd"  /rootfs/usr/bin/regentd
  # wardend-watchdog: the data-plane backstop (a SEPARATE process from
  # regentd + the warden; regentd spawns it once at boot). It fires
  # `reboot -f` on a dp-dark >= 540 s (the dp.status file stale)
  # or a stale warden heartbeat >= 600 s, with a persistent reboot-loop
  # guard on the raw disk tail. Dynamic-musl like regentd (libc.musl +
  # libunwind), which the host rootfs already carries.
  install -vDm755 "$R/wardend-watchdog" /rootfs/usr/bin/wardend-watchdog
  # wardend-xdparm: the AF_XDP sock_map fast-path re-arm (a SEPARATE process
  # from regentd + the warden; regentd spawns it once at boot, after
  # spawn_watchdog). It does a real BPF_MAP_LOOKUP_ELEM on the pinned
  # /sys/fs/bpf/<iface>/redirect_ip_map key 0 (the wedge detection: the
  # kernel auto-removes the socket from the map when the sentry dies, so a
  # missing/zero entry = the guard has XDP_ACT_PASS'd everything). On a wedge
  # it re-arms WITHOUT a reboot: a fresh AF_XDP socket (SIOCGIFINDEX +
  # sockaddr_xdp bind) + BPF_MAP_UPDATE_ELEM key 0, with bounded backoff.
  # If the sentry is DEAD it falls back to the existing respawn path (it does
  # not implement a new one). Dynamic-musl like regentd (libc.musl +
  # libunwind), which the host rootfs already carries.
  install -vDm755 "$R/wardend-xdparm" /rootfs/usr/bin/wardend-xdparm
  # wardend-xdpgone: the AF_XDP sock_map wedge TRIGGER (the xdp-9
  # disambiguator's forced-wedge half; a SEPARATE process from regentd + the
  # warden + the watchdog + the re-arm). regentd spawns it once at boot. It
  # watches a trigger file in the bind-mounted devices dir; on trigger it does
  # a BPF_OBJ_GET + BPF_MAP_DELETE_ELEM on key 0 of the pinned
  # /sys/fs/bpf/eth0/redirect_ip_map, which simulates the kernel's
  # xsk_delete_from_maps auto-removal WITHOUT killing the sentry (the socket
  # fd stays open, just removed from the map) — the wedge the re-arm must
  # recover without a reboot. Dynamic-musl like regentd (libc.musl +
  # libunwind), which the host rootfs already carries.
  install -vDm755 "$R/wardend-xdpgone" /rootfs/usr/bin/wardend-xdpgone
  # posternd: the SSH daemon (a PER-DAEMON gvisor unit — its own dedicated
  # bundle image, like scribe). The distro COPYs it into the posternd
  # bundle rootfs (/images/posternd/rootfs/). Dynamic-musl (libc.musl +
  # libunwind), which the posternd-bundle stage carries.
  install -vDm755 "$R/posternd" /rootfs/usr/bin/posternd
  # NOTE: the `bridge` binary was deleted in wardend 0980f89 (the wire logic
  # was folded into bastiond; the wardend-bridge package now produces only
  # the nginx-srv co-tenant — dpmon + offline-srv are deleted). No `bridge`
  # install here.
  # bastiond: the sandbox init — the SOLE occupant of the netstack bundle
  # (the per-daemon architecture: seald + posternd are their own gvisor
  # units, each with a dedicated bundle image). Dynamic-musl (libc.musl +
  # libunwind), which the bundle rootfs already carries (core-musl +
  # core-libunwind). The distro COPYs it into the netstack bundle rootfs;
  # it is the sandbox init, not a host-side binary.
  install -vDm755 "$R/bastiond" /rootfs/usr/bin/bastiond
  # seald: the evidence daemon (the seal package's bin). A PER-DAEMON
  # gvisor unit (its own dedicated bundle image, like scribe). The distro
  # COPYs it into the seald bundle rootfs (/images/seald/rootfs/).
  # Dynamic-musl, but its NEEDED is MORE than bastiond's: the seal crate
  # depends on bootproof, which links tss2 dynamically (libtss2-* +
  # libcrypto.so.3) — the seald-bundle stage carries those.
  install -vDm755 "$R/seald"    /rootfs/usr/bin/seald
  # scribed: the log ring buffer (the scribe package's bin). A PER-DAEMON
  # gvisor unit (its own dedicated bundle image). The distro COPYs it into
  # the scribe bundle rootfs (/images/scribe/rootfs/). Pure-std (no
  # workspace deps) — its NEEDED is just libc.musl.
  install -vDm755 "$R/scribed"  /rootfs/usr/bin/scribed
  # wardenctl: the host-side admin client (the wardenctl target's client
  # side). Dynamic-musl with the SAME NEEDED as the other host binaries
  # (libc.musl + libunwind), which the host rootfs already carries.
  install -vDm755 "$R/wardenctl" /rootfs/usr/bin/wardenctl
  # nginx-srv: the bin of the wardend-bridge package (the UDS-only
  # stock-nginx-workload stand-in, the capstone's second vhost). The distro
  # COPYs it into the netstack bundle rootfs (spawned by the seed's `unit`
  # directive). Dynamic-musl (libc.musl + libunwind), which the netstack
  # bundle rootfs already carries.
  install -vDm755 "$R/nginx-srv" /rootfs/usr/bin/nginx-srv
  install -vDm755 "$R/xattach"  /rootfs/usr/bin/xattach
  # keepd: the disks daemon (the LUKS2 data plane). Runs HOST-SIDE (the gvisor
  # moat has no block-device passthrough; the LUKS volume is a block device
  # that lives on the host). The warden broker injects WARDEND_LUKS_KEY (the
  # unsealed persist secret) before launch; keepd opens the LUKS volume,
  # migrates the PCR policy (seed -> full), and mounts it at /home.
  # Static-musl like the other host-side binaries.
  install -vDm755 "$R/keepd"    /rootfs/usr/bin/keepd
  # bailiffd: the optional k8s-worker adapter (reserved: no unit ships for
  # it yet; see the build note above). Dynamic-musl like the other host
  # binaries.
  install -vDm755 "$R/bailiffd" /rootfs/usr/bin/bailiffd
  # The unit set, shipped alongside the binaries so they are versioned with
  # the wardend pin (single source of truth: the distro COPYs these, it does
  # not carry its own copy). The unit HCL is the single source of truth for
  # the sandbox spec (the per-bundle config.json is eliminated — the warden's
  # moat renders the OCI spec into a per-unit state dir at spawn time); the
  # bundle images carry ONLY rootfs/ (binary + musl libs + /etc gofer
  # files), assembled by the distro.
  install -vDm644 src/warden/units/xdp-attach.hcl /rootfs/etc/wardend/units/xdp-attach.hcl
  install -vDm644 src/warden/units/bastiond.hcl /rootfs/etc/wardend/units/bastiond.hcl
  # scribe: the log ring buffer (a standalone gvisor unit; one of the
  # per-daemon sandboxes). The bundle (a Dir rootfs) is /images/scribe
  # (rootfs/ carrying scribed + the /etc gofer files). The devices dir is
  # bind-mounted into the sandbox, so scribed's write + read sockets land
  # host-visible in /run/wardend/devices.
  install -vDm644 src/warden/units/scribe.hcl     /rootfs/etc/wardend/units/scribe.hcl
  # seald: the evidence daemon (a standalone gvisor unit; one of the
  # per-daemon sandboxes). The bundle (a Dir rootfs) is /images/seald
  # (rootfs/ carrying seald + the /etc gofer files + the tss2 runtime +
  # the /dev/sev-guest placeholder). The devices dir is bind-mounted into
  # the sandbox, so seald's admin/seal sockets + gate.txt + hsm-pub.hex
  # land host-visible in /run/wardend/devices.
  install -vDm644 src/warden/units/seald.hcl     /rootfs/etc/wardend/units/seald.hcl
  # posternd: the SSH daemon (a standalone gvisor unit; one of the
  # per-daemon sandboxes). The bundle (a Dir rootfs) is /images/posternd
  # (rootfs/ carrying posternd + the /etc gofer files + the authorized
  # keys at /root/.ssh — posternd's keys_dir INSIDE the sandbox; the host
  # /root is a separate tmpfs). The devices dir is bind-mounted into the
  # sandbox, so posternd's UDS lands host-visible in /run/wardend/devices.
  install -vDm644 src/warden/units/posternd.hcl /rootfs/etc/wardend/units/posternd.hcl
  # keepd: the host-side disks daemon (the LUKS2 data plane; a persist
  # key-ed secret, so the warden broker holds it until the key is unsealed
  # from seald). The container moat (always in the build) is the host-side
  # primitive; the unit runs with the warden's ambient CAP_SYS_ADMIN.
  install -vDm644 src/warden/units/keepd.hcl /rootfs/etc/wardend/units/keepd.hcl
  # The host-side dhcp oneshot (the QEMU slirp gap): runsc's
  # prepareRedirectInterfaceArgs is a host-side, pre-sandbox step that needs
  # the uplink to already have a single IPv4 address. On the wire the ENA is
  # addressed by a prior VPC-DHCP step (the unit is a no-op there); on QEMU
  # slirp there is no host-side client, so the unit runs udhcpc with the
  # lease-apply script as the -s handler. xdp-attach gates on its sentinel.
  install -vDm644 src/warden/units/dhcp.hcl /rootfs/etc/wardend/units/dhcp.hcl
  install -vDm755 src/warden/guest/usr/libexec/dhcp.sh /rootfs/usr/libexec/dhcp.sh
  # NOTE: the per-bundle config.json files are ELIMINATED (the unit HCL is
  # the single source of truth for the sandbox spec; the warden's moat
  # renders the OCI spec into a per-unit state dir at spawn time). No
  # /images/<name>/config.json installs here — the bundle images carry ONLY
  # rootfs/ (the distro assembles them).
  # The injection seed (the offline-unit concept-proof): bastiond reads it
  # at startup and merges its expose/offline directives. The distro COPYs it
  # into the netstack bundle rootfs at /etc/wardend/seed (the default seed
  # path). Versioned with the wardend pin.
  install -vDm644 src/warden/guest/bastiond/seed /rootfs/images/bastiond/seed
EOF
# demit: the initramfs init (the UKI .initrd /init). NO_STD + NO_ALLOC +
# NOLIBC (links no libc at all): the bare in-tree target spec (dynamic-
# linking false, panic abort, crt-static) + -Zbuild-std=core (sysroot core).
# SEPARATE RUN, NETWORK ON (like the retired user-demit package used):
# -Zbuild-std resolves the sysroot crates (rustc-literal-escaper via
# proc_macro) from the crates.io index, which is NOT in the workspace lock
# (so no --frozen either). The `nolibc` feature gates src/main.rs (the init
# binary). RUSTC_BOOTSTRAP unlocks the -Z flags on the pallet's stable
# toolchain. This REPLACED the separate user-demit package (same archive,
# same flags): one archive fetch now builds every binary of the repo.
ENV RUSTC_BOOTSTRAP=1
ENV RUSTFLAGS='-C codegen-units=1 -C target-feature=+crt-static'
RUN <<-EOF
  set -eux
  ARCH=$(uname -m)
  cargo build \
    --release \
    --features nolibc \
    --target src/demit/target-specs/demit-${ARCH}-nolibc.json \
    -Zjson-target-spec -Zbuild-std=core \
    -p demit
  install -vDm755 target/demit-${ARCH}-nolibc/release/demit /rootfs/usr/bin/demit
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
