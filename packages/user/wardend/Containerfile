FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/wardend-${VERSION}.tar.gz .
WORKDIR /wardend
# The wardend stack has real crates.io deps (russh/sshdt for posternd, tokio,
# aws-lc-sys, ...; 257 lock packages), so the build follows the execd pattern:
# `cargo fetch` with network ON, then the compile with --network=none and
# --frozen (the lock is complete for the shipped feature set).
#
# warden MUST be built with --features gvisor,container: the default feature
# set is container-only, and the gvisor moat is what runs the netstack
# sandbox (the sn-7 kernel-offline wire). A wardend built without the gvisor
# feature has no moat for the `type = "gvisor"` netstack unit -> the warden
# fail-closes ("sandbox kind gvisor has no matching moat") and the guest
# panics. The other four binaries build with their default features.
RUN cargo fetch
RUN --network=none <<-EOF
  set -eux
  ARCH=$(uname -m)
  # warden: the gvisor + container moats (the netstack + the xdp-attach
  # container oneshot).
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    --features gvisor,container \
    -p warden
  # regent (regentd), postern (posternd), wardend-bridge (bridge), xattach.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p regent -p postern -p wardend-bridge -p xattach
  # seal (seald): the evidence daemon. Runs as an IN-SANDBOX co-tenant of
  # bridge wire (the netstack sandbox); the bundle's config.json
  # linux.devices passes through /dev/tpmrm0 + /dev/tpm0 + /dev/sev-guest so
  # seald's TPM2 / SEV-SNP evidence path works in-sandbox.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p seal
  R="target/${ARCH}-unknown-linux-musl/release"
  install -vDm755 "$R/wardend"  /rootfs/usr/bin/wardend
  install -vDm755 "$R/regentd"  /rootfs/usr/bin/regentd
  install -vDm755 "$R/posternd" /rootfs/usr/bin/posternd
  install -vDm755 "$R/bridge"   /rootfs/usr/bin/bridge
  # seald: the evidence daemon (the seal package's bin). The distro COPYs it
  # into the netstack bundle rootfs as a co-tenant of the wire-owning netstack.
  # Dynamic-musl with the SAME NEEDED as bridge (libc.musl + libunwind), which
  # the bundle rootfs already carries (core-musl + core-libunwind).
  install -vDm755 "$R/seald"    /rootfs/usr/bin/seald
  # offline-srv: the second bin of the wardend-bridge package (the UDS-only
  # offline-workload stand-in, the nginx concept-proof). The distro COPYs it
  # into the netstack bundle rootfs as a co-tenant of the wire-owning netstack.
  install -vDm755 "$R/offline-srv" /rootfs/usr/bin/offline-srv
  install -vDm755 "$R/xattach"  /rootfs/usr/bin/xattach
  # The unit set + the netstack bundle's OCI config, shipped alongside the
  # binaries so they are versioned with the wardend pin (single source of
  # truth: the distro COPYs these, it does not carry its own copy). The
  # bundle rootfs (bridge/posternd/busybox/etc) is assembled by the distro;
  # only config.json (the runsc contract) comes from the wardend tree.
  install -vDm644 src/warden/units/xdp-attach.hcl /rootfs/etc/wardend/units/xdp-attach.hcl
  install -vDm644 src/warden/units/netstack.hcl  /rootfs/etc/wardend/units/netstack.hcl
  install -vDm644 src/warden/guest/netstack/config.json /rootfs/images/netstack/config.json
  # The injection seed (the offline-unit concept-proof): bridge wire reads it
  # at startup and merges its expose/offline directives. The distro COPYs it
  # into the netstack bundle rootfs at /etc/wardend/seed (the default seed
  # path). Versioned with the wardend pin, like config.json.
  install -vDm644 src/warden/guest/netstack/seed /rootfs/images/netstack/seed
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
