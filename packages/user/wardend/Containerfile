FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/wardend-${VERSION}.tar.gz .
WORKDIR /wardend
# The wardend stack has real crates.io deps (russh/sshdt for posternd, tokio,
# aws-lc-sys, ...; 257 lock packages), so the build follows the execd pattern:
# `cargo fetch` with network ON, then the compile with --network=none and
# --frozen (the lock is complete for the shipped feature set).
#
# warden MUST be built with --features gvisor,container: the default feature
# set is container-only, and the gvisor moat is what runs the netstack
# sandbox (the sn-7 kernel-offline wire). A wardend built without the gvisor
# feature has no moat for the `type = "gvisor"` netstack unit -> the warden
# fail-closes ("sandbox kind gvisor has no matching moat") and the guest
# panics. The other four binaries build with their default features.
RUN cargo fetch
RUN --network=none <<-EOF
  set -eux
  ARCH=$(uname -m)
  # warden: the gvisor + container moats (the netstack + the xdp-attach
  # container oneshot).
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    --features gvisor,container \
    -p warden
  # regent (regentd + wardend-watchdog), postern (posternd),
  # wardend-bridge (bridge + dpmon + offline-srv), xattach.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p regent -p postern -p wardend-bridge -p xattach
  # seal (seald): the evidence daemon. Runs as an IN-SANDBOX co-tenant of
  # bridge wire (the netstack sandbox); the bundle's config.json
  # linux.devices passes through /dev/tpmrm0 + /dev/tpm0 + /dev/sev-guest so
  # seald's TPM2 / SEV-SNP evidence path works in-sandbox.
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p seal
  R="target/${ARCH}-unknown-linux-musl/release"
  install -vDm755 "$R/wardend"  /rootfs/usr/bin/wardend
  install -vDm755 "$R/regentd"  /rootfs/usr/bin/regentd
  # wardend-watchdog: the data-plane backstop (a SEPARATE process from
  # regentd + the warden; regentd spawns it once at boot). It fires
  # `reboot -f` on a dp-dark >= 540 s (the in-sandbox dpmon status stale)
  # or a stale warden heartbeat >= 600 s, with a persistent reboot-loop
  # guard on the raw disk tail. Dynamic-musl like regentd (libc.musl +
  # libunwind), which the host rootfs already carries.
  install -vDm755 "$R/wardend-watchdog" /rootfs/usr/bin/wardend-watchdog
  # wardend-xdparm: the AF_XDP sock_map fast-path re-arm (a SEPARATE process
  # from regentd + the warden; regentd spawns it once at boot, after
  # spawn_watchdog). It does a real BPF_MAP_LOOKUP_ELEM on the pinned
  # /sys/fs/bpf/<iface>/redirect_ip_map key 0 (the wedge detection: the
  # kernel auto-removes the socket from the map when the sentry dies, so a
  # missing/zero entry = the guard has XDP_ACT_PASS'd everything). On a wedge
  # it re-arms WITHOUT a reboot: a fresh AF_XDP socket (SIOCGIFINDEX +
  # sockaddr_xdp bind) + BPF_MAP_UPDATE_ELEM key 0, with bounded backoff.
  # If the sentry is DEAD it falls back to the existing respawn path (it does
  # not implement a new one). Dynamic-musl like regentd (libc.musl +
  # libunwind), which the host rootfs already carries.
  install -vDm755 "$R/wardend-xdparm" /rootfs/usr/bin/wardend-xdparm
  # wardend-xdpgone: the AF_XDP sock_map wedge TRIGGER (the xdp-9
  # disambiguator's forced-wedge half; a SEPARATE process from regentd + the
  # warden + the watchdog + the re-arm). regentd spawns it once at boot. It
  # watches a trigger file in the bind-mounted devices dir; on trigger it does
  # a BPF_OBJ_GET + BPF_MAP_DELETE_ELEM on key 0 of the pinned
  # /sys/fs/bpf/eth0/redirect_ip_map, which simulates the kernel's
  # xsk_delete_from_maps auto-removal WITHOUT killing the sentry (the socket
  # fd stays open, just removed from the map) — the wedge the re-arm must
  # recover without a reboot. Dynamic-musl like regentd (libc.musl +
  # libunwind), which the host rootfs already carries.
  install -vDm755 "$R/wardend-xdpgone" /rootfs/usr/bin/wardend-xdpgone
  install -vDm755 "$R/posternd" /rootfs/usr/bin/posternd
  install -vDm755 "$R/bridge"   /rootfs/usr/bin/bridge
  # dpmon: the IN-SANDBOX data-plane liveness probe (a co-tenant of
  # bridge wire, spawned by the bundle config.json argv's --dpmon-bin).
  # It does a real external TCP connect on a bounded cadence and publishes
  # `<epoch> pass|fail` to the host-visible /run/wardend/devices/dp.status
  # (the bind-mounted dir the host-side wardend-watchdog reads).
  # Dynamic-musl with the SAME NEEDED as bridge (libc.musl + libunwind),
  # which the bundle rootfs already carries (core-musl + core-libunwind).
  install -vDm755 "$R/dpmon"    /rootfs/usr/bin/dpmon
  # seald: the evidence daemon (the seal package's bin). The distro COPYs it
  # into the netstack bundle rootfs as a co-tenant of the wire-owning netstack.
  # Dynamic-musl with the SAME NEEDED as bridge (libc.musl + libunwind), which
  # the bundle rootfs already carries (core-musl + core-libunwind).
  install -vDm755 "$R/seald"    /rootfs/usr/bin/seald
  # offline-srv: the second bin of the wardend-bridge package (the UDS-only
  # offline-workload stand-in, the nginx concept-proof). The distro COPYs it
  # into the netstack bundle rootfs as a co-tenant of the wire-owning netstack.
  install -vDm755 "$R/offline-srv" /rootfs/usr/bin/offline-srv
  install -vDm755 "$R/xattach"  /rootfs/usr/bin/xattach
  # The unit set + the netstack bundle's OCI config, shipped alongside the
  # binaries so they are versioned with the wardend pin (single source of
  # truth: the distro COPYs these, it does not carry its own copy). The
  # bundle rootfs (bridge/posternd/busybox/etc) is assembled by the distro;
  # only config.json (the runsc contract) comes from the wardend tree.
  install -vDm644 src/warden/units/xdp-attach.hcl /rootfs/etc/wardend/units/xdp-attach.hcl
  install -vDm644 src/warden/units/netstack.hcl  /rootfs/etc/wardend/units/netstack.hcl
  # The host-side dhcp oneshot (the QEMU slirp gap): runsc's
  # prepareRedirectInterfaceArgs is a host-side, pre-sandbox step that needs
  # the uplink to already have a single IPv4 address. On the wire the ENA is
  # addressed by a prior VPC-DHCP step (the unit is a no-op there); on QEMU
  # slirp there is no host-side client, so the unit runs udhcpc with the
  # lease-apply script as the -s handler. xdp-attach gates on its sentinel.
  install -vDm644 src/warden/units/dhcp.hcl /rootfs/etc/wardend/units/dhcp.hcl
  install -vDm755 src/warden/guest/usr/libexec/dhcp.sh /rootfs/usr/libexec/dhcp.sh
  install -vDm644 src/warden/guest/netstack/config.json /rootfs/images/netstack/config.json
  # The injection seed (the offline-unit concept-proof): bridge wire reads it
  # at startup and merges its expose/offline directives. The distro COPYs it
  # into the netstack bundle rootfs at /etc/wardend/seed (the default seed
  # path). Versioned with the wardend pin, like config.json.
  install -vDm644 src/warden/guest/netstack/seed /rootfs/images/netstack/seed
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
