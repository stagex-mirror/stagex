FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-freetype . /
COPY --from=stagex/user-fontconfig . /
COPY --from=stagex/user-pixman . /
COPY --from=stagex/core-libpng . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-gettext . /
COPY --from=stagex/user-harfbuzz . /
COPY --from=stagex/user-glib . /
COPY --from=stagex/core-pcre2 . /
ADD fetch/cairo-${VERSION}.tar.xz .
RUN mv cairo-${VERSION}* cairo
WORKDIR /cairo
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/cairo=."
ENV PKG_CONFIG_PATH="/usr/lib/pkgconfig"
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dxcb=disabled \
		-Dxlib=disabled \
		-Dglib=auto \
		-Dfreetype=auto \
		-Dfontconfig=auto \
		-Dpng=enabled \
		-Dtests=disabled \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
	install -Dm644 COPYING /rootfs/usr/share/licenses/cairo/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
