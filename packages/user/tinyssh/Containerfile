FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
ADD fetch/tinyssh-${VERSION}.tar.gz .
WORKDIR /tinyssh-${VERSION}
RUN --network=none <<-EOF
	set -eux
	make tinysshd tinysshd-makekey CC=clang LDFLAGS=-static
	mkdir -p /rootfs/usr/sbin
	install -m 0755 tinysshd tinysshd-makekey /rootfs/usr/sbin/
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
