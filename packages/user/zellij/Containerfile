FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/zellij-${VERSION}.tar.gz .
WORKDIR /zellij-${VERSION}
RUN cargo fetch --locked
ENV RUSTFLAGS="-C codegen-units=1 -C link-arg=-Wl,--build-id=none -C target-feature=+crt-static"
ENV OPENSSL_NO_VENDOR=1
RUN --network=none <<-EOF
	cargo build \
		--frozen \
		--release \
		--locked \
		--target ${ARCH}-unknown-linux-musl \
		--bin zellij
	install -vDm755 -t /rootfs/usr/bin target/${ARCH}-unknown-linux-musl/release/zellij
	install -vDm644 -t /rootfs/usr/share/licenses/zellij LICENSE.md
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
