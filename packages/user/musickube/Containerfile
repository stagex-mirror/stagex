FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-ncurses . /
COPY --from=stagex/core-curl . /
COPY --from=stagex/core-openssl . /
COPY --from=stagex/core-sqlite3 . /
COPY --from=stagex/core-libev . /
COPY --from=stagex/core-nlohmann-json . /
COPY --from=stagex/user-ffmpeg . /
COPY --from=stagex/user-lame . /
COPY --from=stagex/user-libmicrohttpd . /
COPY --from=stagex/user-taglib . /
COPY --from=stagex/user-asio . /
COPY --from=stagex/user-alsa-lib . /
ADD fetch/musikcube-${VERSION}.tar.gz .
WORKDIR /musikcube-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-march=x86-64 -ffile-prefix-map=/musikcube-${VERSION}=."
ENV CXXFLAGS="-march=x86-64 -ffile-prefix-map=/musikcube-${VERSION}=."
RUN --network=none <<-EOF
	ln -sf /usr/lib/libclang_rt.builtins.a /usr/lib/libatomic.a
	cmake \
		-B build \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
		-DCMAKE_SKIP_RPATH=ON \
		-DCMAKE_EXE_LINKER_FLAGS_INIT="-Wl,--build-id=none" \
		.
	cmake --build build
	DESTDIR="/rootfs" cmake --install build --prefix /usr
	install -Dm644 LICENSE.txt /rootfs/usr/share/licenses/musickube/LICENSE.txt
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
