FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/gping-${VERSION}.tar.gz .
WORKDIR /gping-gping-v${VERSION}
ENV RUST_BACKTRACE=1
ENV RUSTFLAGS='-C codegen-units=1 -C target-feature=+crt-static'
ENV SOURCE_DATE_EPOCH=1
RUN cargo fetch
RUN --network=none <<-EOF
	cargo build \
		--frozen \
		--release \
		--target ${ARCH}-unknown-linux-musl \
		--bin gping
	install -vdm0755 /rootfs/usr/bin
	install -vDm755 -t /rootfs/usr/bin target/${ARCH}-unknown-linux-musl/release/gping
	install -vDm644 -t /rootfs/usr/share/licenses/gping LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
