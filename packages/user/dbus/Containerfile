FROM scratch AS build
ARG VERSION
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-llvm . /
COPY --from=stagex/core-mold . /
COPY --from=stagex/core-onetbb . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-gettext . /
COPY --from=stagex/core-pkgconf . /
ADD fetch/dbus-${VERSION}.tar.gz .
WORKDIR /dbus-${VERSION}
RUN --network=none <<-EOF
	set -eux
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-tests \
		--disable-doxygen-docs \
		--disable-xml-docs \
		--disable-systemd
	make -j "$(nproc)"
	mkdir -p /rootfs/run
	make DESTDIR=/rootfs install
	# Clean up runtime dirs that conflict with core-filesystem /var/run -> ../run symlink
	rm -rf /rootfs/run /rootfs/var/run
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
