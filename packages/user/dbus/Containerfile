FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-libxml2 . /
COPY --from=stagex/user-systemd . /
ADD fetch/dbus-${VERSION}.tar.xz .
WORKDIR /dbus-${VERSION}
RUN --network=none <<-EOF
	set -eux
	meson setup \
		--default-library=shared \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		-Dmodular_tests=disabled \
		-Dtools=true \
		-Dsystemd=enabled \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install --no-rebuild -C output
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
