FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-wayland . /
COPY --from=stagex/user-wayland-protocols . /
COPY --from=stagex/core-bison . /
COPY --from=stagex/core-libxml2 . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-m4 . /
ADD fetch/xkbcommon-${VERSION}.tar.gz .
RUN mv libxkbcommon-xkbcommon-${VERSION} xkbcommon
WORKDIR /xkbcommon
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/xkbcommon=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Denable-x11=false \
		-Denable-wayland=true \
		. build
	meson compile -C build
	DESTDIR=/rootfs meson install -C build
	install -Dm644 LICENSE /rootfs/usr/share/licenses/xkbcommon/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
