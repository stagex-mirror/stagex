FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/core-ncurses . /
ADD fetch/calcurse-${VERSION}.tar.gz .
WORKDIR /calcurse-${VERSION}
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/calcurse-${VERSION}=."
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-doc
	make -j$(nproc)
	DESTDIR=/rootfs make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/calcurse/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
