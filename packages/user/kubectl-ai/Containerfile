FROM stagex/pallet-go AS build
ARG VERSION
ADD fetch/kubectl-ai-${VERSION}.tar.gz .
ENV GOPATH=/cache/go
ENV GOCACHE=/cache/
ENV GOWORK=off
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org
ENV CGO_ENABLED=0
WORKDIR /kubectl-ai-${VERSION}
RUN go mod download
RUN --network=none <<-EOF

	go build -trimpath -o kubectl-ai ./cmd
	mkdir -p /rootfs/usr/bin/
	cp kubectl-ai /rootfs/usr/bin/
	install -Dm644 LICENSE /rootfs/usr/share/licenses/kubectl-ai/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
