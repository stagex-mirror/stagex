FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
ADD fetch/cjson-${VERSION}.tar.gz .
WORKDIR /cJSON-${VERSION}
RUN --network=none <<-EOF
	cmake \
		-B build \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DBUILD_SHARED_AND_STATIC_LIBS=ON \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_SKIP_RPATH=ON \
		-DCJSON_BUILD_TESTS=OFF \
		-DENABLE_CJSON_TEST=OFF \
		-DCMAKE_C_FLAGS="-Wno-long-long -Wno-error"
	cmake --build build
	DESTDIR="/rootfs" cmake --install build
	rm -rf /rootfs/usr/lib64
	install -Dm644 LICENSE /rootfs/usr/share/licenses/cjson/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
