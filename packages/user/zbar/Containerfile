FROM base AS build-libzbar-optimized-qrcode
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--wrap-mode=nofallback \
		-Dbuild_tests=false \
		-Ddoc=false \
		-Dnls=enabled \
		-Dvideo=false \
		-Dx11=disabled \
		-Dxshm=disabled \
		-Dxv=disabled \
		-Ddbus=disabled \
		-Djpeg=disabled \
		-Dimagemagick=disabled \
		-Dgraphicsmagick=disabled \
		-Dnpapi=disabled \
		-Dgtk=no \
		-Dgir=false \
		-Dpython=no \
		-Dqt=false \
		-Djava=disabled \
		-Dcodes=qrcode \
		output
	meson compile -C output
	DESTDIR=/rootfs meson install --no-rebuild -C output
EOF
FROM stagex/core-filesystem AS package-libzbar-optimized-qrcode
COPY --from=build-libzbar-optimized-qrcode /rootfs/ /
