FROM stagex/pallet-clang-meson-busybox AS base
COPY --from=stagex/core-gettext . /
COPY --from=stagex/core-libxml2 . /
ARG VERSION
ADD fetch/zbar-${VERSION}.tar.gz .
WORKDIR /zbar-${VERSION}

FROM base AS build-zbarcam
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--wrap-mode=nofallback \
		-Dbuild_tests=false \
		-Ddoc=false \
		-Dnls=enabled \
		-Dvideo=true \
		-Dx11=disabled \
		-Dxshm=disabled \
		-Dxv=disabled \
		-Ddbus=disabled \
		-Djpeg=disabled \
		-Dimagemagick=disabled \
		-Dgraphicsmagick=disabled \
		-Dnpapi=disabled \
		-Dgtk=no \
		-Dgir=false \
		-Dpython=no \
		-Dqt=false \
		-Djava=disabled \
		output
	meson compile -C output
	DESTDIR=/rootfs meson install --no-rebuild -C output
EOF

FROM stagex/core-filesystem AS package-zbarcam
COPY --from=build-zbarcam /rootfs/ /

FROM base AS build-libzbar
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		--sysconfdir=/etc \
