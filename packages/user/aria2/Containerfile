FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-make . /
COPY --from=stagex/core-openssl . /
COPY --from=stagex/core-libzstd . /
ADD fetch/aria2-${VERSION}.tar.gz .
WORKDIR /aria2-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/aria2-${VERSION}=."
ENV CXXFLAGS="-O2 -fPIC -ffile-prefix-map=/aria2-${VERSION}=."
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--disable-nls \
		--disable-openssl \
		--disable-gnutls \
		--disable-libgmp \
		--disable-unix-dos \
		--disable-libssh2 \
		--disable-alt-rc4 \
		--disable-debug \
		--enable-python-bindings=no
	make -j$(nproc)
	DESTDIR=/rootfs make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/aria2/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
