FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/rsop-v${VERSION}.tar.gz .
WORKDIR /rsop
ENV RUST_BACKTRACE=1
ENV RUSTFLAGS="-C codegen-units=1 -C target-feature=+crt-static"
RUN cargo fetch
RUN --network=none <<-EOF
	cargo build \
		--frozen \
		--release \
		--target ${ARCH}-unknown-linux-musl \
		--bin rsop
	install -vdm0755 /rootfs/usr/bin
	install -vDm755 -t /rootfs/usr/bin target/${ARCH}-unknown-linux-musl/release/rsop
	install -vDm644 -t /rootfs/usr/share/licenses/rsop LICENSES/CC0-1.0.txt
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
