FROM stagex/pallet-rust AS build
ARG TARGETARCH
COPY src/main.rs /src/snptpm-agent.rs
RUN --network=none <<-EOF
       case "${TARGETARCH}" in
               amd64)  ARCH=x86_64 ;;
               arm64)  ARCH=aarch64 ;;
               *)      ARCH="$(uname -m)" ;;
       esac
       mkdir -p /rootfs/usr/bin
       rustc \
               --edition 2021 \
               -O \
               --target "${ARCH}-unknown-linux-musl" \
               -o /rootfs/usr/bin/snptpm-agent \
               /src/snptpm-agent.rs
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
