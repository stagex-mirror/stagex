FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-make . /
ADD fetch/mpg123-${VERSION}.tar.bz2 .
WORKDIR /mpg123-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -ffile-prefix-map=/mpg123-${VERSION}=."
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--disable-shared \
		--disable-debug \
		--disable-examples \
		--disable-assembly \
		--with-default-encoder=none \
		--with-default-decoder=none
	make -j$(nproc)
	DESTDIR=/rootfs make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/libmpg123/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
