+// rearmLoop is the periodic (bounded) data-plane liveness check that detects
+// the AF_XDP socket wedge and re-arms the socket. It runs in a separate
+// goroutine (the dispatch loop blocks on a single poll with no timeout, so the
+// check cannot be inline). Every 10 s it reads the RX ring occupancy (the
+// descriptors the kernel has delivered but we have not yet released). A
+// persistently-full, non-draining ring (occupancy >= half the 512-desc ring =
+// 256, for 3 consecutive samples = 30 s) means the eBPF guard is still
+// redirecting frames to the socket, but the socket's ring is not draining (the
+// data-plane wedge). On detection it re-creates the socket (the sentry's own
+// NewFromSocket, the real perf path) and re-inserts it at key 0 (see
+// rearmAFXDPSocket). An empty ring (idle, no traffic) resets the counter (no
+// false-fire on a legitimately-idle host). A failed re-create backs off
+// (double the interval, capped at 60 s); a success resets it. Bounded +
+// idempotent.
+//
+// The map-emptiness check (the original trigger) is RETIRED: the pinned map is
+// an XSKMAP with a single entry (the live socket) that persists even after a
+// delete (the live socket holds the reference), so an empty map is not a
+// reliable wedge signal. The data-plane liveness (RX ring occupancy) is the
+// correct signal. The map_info + heartbeat logging is kept (useful for wire
+// verification: it confirms the donated map fd is alive + the map is the
+// pinned XSKMAP the host's redirect program uses).
+func (ep *endpoint) rearmLoop() {
+	defer ep.wg.Done()
+	ticker := time.NewTicker(10 * time.Second)
+	defer ticker.Stop()
+	for range ticker.C {
+		if ep.rearm.sockMap == nil {
+			continue
+		}
+		// Heartbeat: read key 0 of the pinned map to confirm the donated fd is
+		// alive (a persistent error would otherwise mask a dead donated fd).
+		// This is NOT the wedge trigger (the map is a single-entry XSKMAP that
+		// persists even when wedged); it is observability only.
+		_, hbErr := ep.rearm.sockMap.NextKeyBytes(nil)
+		log.Infof("xdp: re-arm: heartbeat (mapFD=%d err=%v)", ep.rearm.mapFD, hbErr)
+		// The wedge signal: the RX ring is persistently full and not draining.
+		// Read the occupancy non-destructively (producer - consumer, both
+		// shared atomics) under the re-arm lock (a stable control snapshot; the
+		// dispatch loop drains the ring, so a persistently-full ring means the
+		// dispatch loop is not draining it = the wedge).
+		ep.rearmMu.RLock()
+		control := ep.control
+		occ := uint32(0)
+		if control != nil {
+			occ = control.RX.Occupancy()
+		}
+		ep.rearmMu.RUnlock()
+		// Half the 512-desc ring (NDescriptors = nFrames/2 = 512) = 256. A
+		// persistently-full, non-draining ring (>= 256 for 3 consecutive
+		// samples = 30 s) is the wedge. An empty ring (idle, no traffic)
+		// resets the counter (no false-fire on a legitimately-idle host).
+		if occ >= 256 {
+			ep.rearm.consecutiveFull++
+		} else {
+			ep.rearm.consecutiveFull = 0
+		}
+		wedge := ep.rearm.consecutiveFull >= 3
+		if !wedge {
+			// Not wedged. Reset the re-create backoff (the ring is draining).
+			ep.rearm.rearmFails = 0
+			continue
+		}
+		// Wedged. Attempt the re-create (bounded backoff).
+		if !ep.rearm.rearmNextAttempt.IsZero() && time.Now().Before(ep.rearm.rearmNextAttempt) {
+			continue
+		}
+		log.Infof("xdp: re-arm: wedge detected (consecutiveFull=%d occ=%d); re-creating", ep.rearm.consecutiveFull, occ)
+		if err := ep.rearmAFXDPSocket(); err != nil {
+			ep.rearmFails()
+			log.Warningf("xdp: re-arm: re-create failed (attempt %d): %v", ep.rearm.rearmFails, err)
+		} else {
+			ep.rearm.rearmFails = 0
+			ep.rearm.rearmNextAttempt = time.Time{}
+			ep.rearm.rearmCount++
+			ep.rearm.consecutiveFull = 0
+			log.Infof("xdp: socket re-created + re-inserted at key 0 (re-arm #%d) on %q", ep.rearm.rearmCount, ep.rearm.ifaceName)
+		}
+	}
+}
+
+// rearmFails records a failed re-create and advances the backoff (double the
+// interval, capped at 60 s). It only gates the re-create, not the check
+// cadence (the check keeps running every 10 s).
+func (ep *endpoint) rearmFails() {
+	ep.rearm.rearmFails++
+	backoff := 10 * time.Second
+	for i := 0; i < ep.rearm.rearmFails && backoff < 60*time.Second; i++ {
+		backoff *= 2
+	}
+	if backoff > 60*time.Second {
+		backoff = 60 * time.Second
+	}
+	ep.rearm.rearmNextAttempt = time.Now().Add(backoff)
+}
+
+// rearmAFXDPSocket re-creates the AF_XDP socket and re-arms it: it joins the
+// host netns (the uplink device + the pinned sockmap live there; the sentry
+// runs in its own netns), creates a fresh AF_XDP socket, re-creates the
+// control block (UMEM + rings) against it via the same NewFromSocket path
+// New() uses (the real perf path), binds it to the uplink device + queue 0
+// (the v12 collapse), re-inserts it at key 0 of the pinned sockmap, and
+// swaps the endpoint's active fd + control block (the dispatch loop reads
+// both; the re-created socket must become them, or frames land in a socket
+// nobody drains). A bare socket+bind is not sufficient: the endpoint's rings
+// are mmap'd per-socket, so the control block must be re-created against the
+// new socket. On success the released (old) fd is closed. On any error the
+// old fd is left untouched and the error is returned (rearmLoop backs off).
+func (ep *endpoint) rearmAFXDPSocket() error {
+	// Set the recreating flag BEFORE the map delete (step 3) and clear it on
+	// every return path (success or error). While set, the dispatch loop
+	// skips re-adding the active socket to the pinned sockmap, so the
+	// re-create's critical section (map delete -> old fd close -> new socket
+	// bind) is not interrupted by a concurrent re-add that holds the OLD
+	// socket's map reference alive (which would keep its XDP queue bound and
+	// EBUSY the new socket's bind).
+	ep.rearm.recreating.Store(true)
+	defer ep.rearm.recreating.Store(false)
+	// Join the host netns to bind the new socket to the uplink device. A
+	// socket is netns-agnostic once created, so we return to the sentry
+	// netns immediately after (setns is process-wide; leaving the sentry in
+	// the host netns would break its own loopback/veth).
+	//
+	// The sentry's OWN netns fd is the one opened ONCE at arm time
+	// (curNetNSFile). Opening /proc/self/ns/net at re-create time (this
+	// goroutine) was the hang (step 1a: the os.Open blocked). A fallback
+	// open is kept for the case the arm-time open failed (rare).
+	var savedNS int
+	if ep.rearm.netnsFD >= 0 {
+		var ns *os.File
+		openedAtRecreate := false
+		if ep.rearm.curNetNSFile != nil {
+			ns = ep.rearm.curNetNSFile
+		} else {
+			var err error
+			ns, err = os.Open("/proc/self/ns/net")
+			if err != nil {
+				return fmt.Errorf("re-arm: failed to open current netns: %v", err)
+			}
+			openedAtRecreate = true
+		}
+		savedNS = int(ns.Fd())
+		if err := unix.Setns(ep.rearm.netnsFD, unix.CLONE_NEWNET); err != nil {
+			return fmt.Errorf("re-arm: failed to join host netns: %v", err)
+		}
+		// The arm-time fd is kept open for the endpoint's lifetime (the
+		// re-create reuses it on every cycle). Only the fallback-opened fd
+		// is closed here, AFTER the setns (the fd is needed by the setns
+		// itself, so it cannot be closed before).
+		if openedAtRecreate {
+			ns.Close()
+		}
+	}
+
+	// Release the OLD socket BEFORE binding the new one. The XDP queue is
+	// EXCLUSIVE: a second socket cannot bind uplink+queue 0 while the old
+	// socket still holds it (that was the hang — NewFromSocket's bind
+	// blocked on the queue the old socket owned). The old socket has TWO
+	// reference holders: (1) the sentry's own fd (ep.fd) and (2) the pinned
+	// XSK map entry (key 0 → the socket). Dropping BOTH releases the socket
+	// (refcount → 0), which frees the queue binding. (Closing the fd alone
+	// does NOT free the queue: the map still holds a reference, so the
+	// socket — and its queue — stays alive.)
+	ep.rearmMu.Lock()
+	oldFD := ep.fd
+	ep.rearmMu.Unlock()
+	var zeroKey uint32
+	if err := ep.rearm.sockMap.Delete(&zeroKey); err != nil {
+		log.Warningf("xdp: re-arm: map delete key 0 (best-effort; the old socket's map ref is gone or the entry already absent): %v", err)
+	}
+	if oldFD >= 0 {
+		unix.Close(oldFD)
+	}
+
+	// Re-create the control block (UMEM + rings) against a FRESH socket
+	// binding it to the uplink device + queue 0. Mirror the original New()
+	// sizing (2MiB UMEM / 1024 frames / 512 descriptors). NewFromSocket
+	// performs the bind (Bind=true) and the ring mmap.
+	const (
+		frameSize = 2048
+		umemSize  = 1 << 21
+		nFrames   = umemSize / frameSize
+	)
+	xdpOpts := xdp.Opts{
+		NFrames:       nFrames,
+		FrameSize:     frameSize,
+		NDescriptors:  nFrames / 2,
+		Bind:          true,
+		UseNeedWakeup: ep.rearm.useNeedWakeup,
+	}
+	// The old socket's XDP bind release is ASYNC (RCU grace period, ~200 ms
+	// typical; longer under load). Closing the old fd (step 4) + deleting the
+	// map entry (step 3) does not synchronously free the queue: the kernel
+	// defers the release, so the new bind (NewFromSocket) hits EBUSY ("device
+	// or resource busy") while the old bind is still in-flight. The retry
+	// loop IS the poll-for-release: each attempt is a probe-bind, and a success
+	// means the queue is now free (the release completed). A bounded retry
+	// (500 ms between attempts, up to 60 = ~30 s) gives the starved workqueue
+	// time to process the release (the 2nd+ re-arm's release took >15 s under
+	// QEMU load; 30 s covers it). On a non-EBUSY error (a real failure) we
+	// return immediately. The blind window is the belt-and-suspenders backstop;
+	// on the wire (lower load) it will likely succeed well within the window.
+	//
+	// CRITICAL: NewFromSocket is NOT idempotent. It registers the UMEM
+	// (XDP_UMEM_REG) as its FIRST setsockopt, and the kernel returns EBUSY if
+	// the UMEM is already registered on the socket. If the socket were created
+	// ONCE outside the loop, attempt 0 would register the UMEM (then fail at the
+	// bind with a genuine queue-busy EBUSY), and every retry would then fail at
+	// XDP_UMEM_REG (umem already set) — masking the real bind error. So we
+	// create a FRESH socket on each attempt: a fresh socket has no UMEM, so
+	// XDP_UMEM_REG succeeds and the retry reaches the bind (the real EBUSY).
+	// Each failed attempt's socket is closed (a socket that registered its UMEM
+	// but failed the bind must be released, or its UMEM/rings leak).
+	var newControl *xdp.ControlBlock
+	var lastErr error
+	var newFD int
+	var err error
+	const (
+		bindAttempts   = 30
+		bindRetryDelay = 500 * time.Millisecond
+	)
+	for attempt := 0; ; attempt++ {
+		newFD, err = unix.Socket(unix.AF_XDP, unix.SOCK_RAW, 0)
+		if err != nil {
+			return fmt.Errorf("re-arm: failed to create AF_XDP socket: %v", err)
+		}
+		if err := unix.SetNonblock(newFD, true); err != nil {
+			unix.Close(newFD)
+			return fmt.Errorf("re-arm: failed to set nonblock: %v", err)
+		}
+		newControl, lastErr = xdp.NewFromSocket(newFD, ep.rearm.ifaceIdx, ep.rearm.queueID, xdpOpts)
+		if lastErr == nil {
+			break
+		}
+		// EBUSY is errno 16. The error string carries EITHER the numeric errno
+		// ("...errno 16", from the raw setsockopt path, e.g. XDP_UMEM_REG) OR
+		// the human-readable name ("device or resource busy", from the unix.Bind
+		// path). Match BOTH forms so the retry fires on the bind EBUSY.
+		isBusy := strings.Contains(lastErr.Error(), "errno 16") ||
+			strings.Contains(lastErr.Error(), "resource busy")
+		if !isBusy || attempt >= bindAttempts-1 {
+			unix.Close(newFD)
+			return fmt.Errorf("re-arm: failed to create AF_XDP control block: %v", lastErr)
+		}
+		// EBUSY (the old bind release in-flight): close THIS attempt's socket
+		// (its UMEM is registered but the bind failed) and retry with a FRESH
+		// socket so the next XDP_UMEM_REG starts from a clean socket.
+		unix.Close(newFD)
+		time.Sleep(bindRetryDelay)
+	}
+	// Populate the fill queue so the driver has somewhere to deliver frames.
+	newControl.UMEM.Lock()
+	newControl.Fill.FillAll(&newControl.UMEM)
+	newControl.UMEM.Unlock()
+
+	// Return to the sentry netns (the socket is netns-agnostic now).
+	if savedNS >= 0 {
+		if err := unix.Setns(savedNS, unix.CLONE_NEWNET); err != nil {
+			log.Warningf("xdp: re-arm: failed to return to sentry netns: %v", err)
+		}
+	}
+
+	// Re-insert the new socket at key 0 (UpdateAny). The eBPF guard now
+	// redirects frames to it again.
+	var key uint32
+	var val uint32 = uint32(newFD)
+	if err := ep.rearm.sockMap.Update(&key, &val, ebpf.UpdateAny); err != nil {
+		unix.Close(newFD)
+		return fmt.Errorf("re-arm: failed to re-insert socket at key 0: %v", err)
+	}
+
+	// Swap the endpoint's active fd + control block (the dispatch loop reads
+	// both; the re-created socket must become them, or frames land in a
+	// socket nobody drains).
+	ep.rearmMu.Lock()
+	ep.fd = newFD
+	ep.control = newControl
+	ep.rearmMu.Unlock()
+	return nil
+}
