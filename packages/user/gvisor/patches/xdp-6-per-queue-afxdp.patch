+// rxQueueCount returns the number of RX queues on a netdev, read from sysfs
+// (/sys/class/net/<iface>/queues/rx-*). The guest kernel has CONFIG_SYSFS=y
+// (no separate NET_SYSFS symbol in 7.2), so these per-queue dirs are present
+// (e.g. ENA with 2 IO queues exposes rx-0 and rx-1). It returns 0 if the
+// directory is absent (the caller falls back to a single queue).
+//
+// x/sys v0.43.0 (the pinned version) has the ETHTOOL_GCHANNELS constant but no
+// IoctlEthtool helper, so sysfs is the portable zero-dependency path.
+func rxQueueCount(ifname string) int {
+	entries, err := filepath.Glob(filepath.Join("/sys/class/net", ifname, "queues", "rx-*"))
+	if err != nil || len(entries) == 0 {
+		return 0
+	}
+	return len(entries)
+}
