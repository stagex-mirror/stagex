+// xdp-6: per-queue AF_XDP endpoint. The package doc comment lives in
+// endpoint.go; this comment explains this file's addition.
+//
+// The single-queue endpoint (endpoint.go, New) is left untouched. This file
+// adds NewMulti, a link endpoint backed by ONE AF_XDP socket per RX queue.
+//
+// Why per-queue: the go-branch redirect path (runsc/sandbox/xdp.go) binds a
+// single socket at key 0 and TODOs "we can't assume there's only one queue"
+// (b/240191988). On a multi-queue NIC (e.g. the AWS c6a ENA, which runs the
+// redirect program per RX queue — ena_xdp_handle_buff) a single socket only
+// receives frames RSS-hashed to queue 0; every frame on queue >= 1 has no
+// sockmap entry and is guard-PASSED to the kernel (the sn-6e recovery path).
+// One socket per RX queue gives every queue a redirect target and uses all of
+// the NIC's receive parallelism.
+//
+// multiEndpoint wraps N independent per-queue endpoints (each created by the
+// existing New, which already takes a QueueID) and implements stack.LinkEndpoint
+// over them:
+//
+//   - Ingress: each sub-endpoint runs its own dispatch goroutine reading its
+//     own queue and feeding the shared network dispatcher — exactly the
+//     multi-FD pattern fdbased/endpoint.go uses (N per-FD goroutines, one
+//     dispatcher). DeliverNetworkPacket is safe for concurrent feeders.
+//   - Egress: WritePackets hashes each packet to a queue (pkt.Hash % N), the
+//     same per-connection affinity fdbased uses. TCP sets pkt.Hash to a
+//     per-connection txHash (so a connection stays on one queue — no reordering
+//     within a flow); UDP leaves it 0 (queue 0), identical to fdbased.
+//
+// multiEndpoint holds no mutable state of its own (the eps slice is immutable
+// after construction; all mutable state lives in the sub-endpoints, each with
+// its own mutex), so it needs no lock and is not savable (Link endpoints are
+// not savable). stack.LinkEndpoint has no Saver requirement, so no stateify
+// autogen is needed.
+package xdp
+
+import (
+	"fmt"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+// MultiOptions configure a per-queue AF_XDP endpoint.
+type MultiOptions struct {
+	// FDs are the AF_XDP sockets, one per RX queue.
+	FDs []int
+
+	// QueueIDs[i] is the RX queue that FDs[i] is attached to. len must equal
+	// len(FDs). In the redirect path the client binds the sockets, so this is
+	// informational there; it is used when Bind is true.
+	QueueIDs []uint32
+
+	// Address is the shared link (MAC) address for the endpoint.
+	Address tcpip.LinkAddress
+
+	// ClosedFunc is a function to be called when a queue's peer closes.
+	ClosedFunc func(tcpip.Error)
+
+	// SaveRestore, TXChecksumOffload, RXChecksumOffload propagate to each
+	// per-queue endpoint (same capabilities on every queue).
+	SaveRestore       bool
+	TXChecksumOffload bool
+	RXChecksumOffload bool
+
+	// InterfaceIndex is the interface index of the underlying device.
+	InterfaceIndex int
+
+	// Bind is true when the sentry binds the AF_XDP sockets (the tunnel path).
+	// In the redirect path the client binds, so this is false.
+	Bind bool
+
+	// GRO enables generic receive offload on each queue.
+	GRO bool
+}
+
+// NewMulti creates a link endpoint backed by one AF_XDP socket per RX queue.
+func NewMulti(opts *MultiOptions) (stack.LinkEndpoint, error) {
+	n := len(opts.FDs)
+	if n == 0 {
+		return nil, fmt.Errorf("NewMulti: no AF_XDP FDs")
+	}
+	if len(opts.QueueIDs) != n {
+		return nil, fmt.Errorf("NewMulti: QueueIDs (%d) != FDs (%d)", len(opts.QueueIDs), n)
+	}
+
+	eps := make([]stack.LinkEndpoint, n)
+	for i := 0; i < n; i++ {
+		ep, err := New(&Options{
+			FD:                opts.FDs[i],
+			ClosedFunc:        opts.ClosedFunc,
+			Address:           opts.Address,
+			SaveRestore:       opts.SaveRestore,
+			TXChecksumOffload: opts.TXChecksumOffload,
+			RXChecksumOffload: opts.RXChecksumOffload,
+			InterfaceIndex:    opts.InterfaceIndex,
+			Bind:              opts.Bind,
+			GRO:               opts.GRO,
+			QueueID:           opts.QueueIDs[i],
+		})
+		if err != nil {
+			return nil, fmt.Errorf("NewMulti: queue %d: %v", i, err)
+		}
+		eps[i] = ep
+	}
+	return &multiEndpoint{eps: eps}, nil
+}
+
+// multiEndpoint implements stack.LinkEndpoint over one AF_XDP socket per RX
+// queue. See the file header for the ingress/egress model.
+type multiEndpoint struct {
+	// eps is immutable after construction. All mutable state lives in the
+	// per-queue sub-endpoints (each with its own mutex).
+	eps []stack.LinkEndpoint
+}
+
+var _ stack.LinkEndpoint = (*multiEndpoint)(nil)
+
+// WritePackets partitions the batch across queues by the transport hash and
+// hands each partition to its per-queue endpoint. Each packet is written to
+// exactly one queue; the per-queue endpoint copies its partition to its UMEM
+// (no DecRef, as in the single endpoint), so the aggregate is refcount-neutral
+// and identical to a single endpoint receiving the whole batch.
+func (m *multiEndpoint) WritePackets(pkts stack.PacketBufferList) (int, tcpip.Error) {
+	n := len(m.eps)
+	if n == 1 {
+		return m.eps[0].WritePackets(pkts)
+	}
+
+	sub := make([]stack.PacketBufferList, n)
+	for _, pkt := range pkts.AsSlice() {
+		sub[pkt.Hash%uint32(n)].PushBack(pkt)
+	}
+
+	sent := 0
+	for i, sl := range sub {
+		if sl.Len() == 0 {
+			continue
+		}
+		w, err := m.eps[i].WritePackets(sl)
+		sent += w
+		if err != nil {
+			return sent, err
+		}
+	}
+	return sent, nil
+}
+
+// The remaining methods delegate to the first sub-endpoint (all queues share
+// the same MAC, MTU, and capabilities) or fan out to every sub-endpoint (so
+// each queue gets its own dispatch goroutine / is stopped / is closed).
+
+// MTU implements stack.LinkEndpoint.
+func (m *multiEndpoint) MTU() uint32 { return m.eps[0].MTU() }
+
+// SetMTU implements stack.LinkEndpoint.
+func (m *multiEndpoint) SetMTU(mtu uint32) {
+	for _, e := range m.eps {
+		e.SetMTU(mtu)
+	}
+}
+
+// MaxHeaderLength implements stack.LinkEndpoint.
+func (m *multiEndpoint) MaxHeaderLength() uint16 { return m.eps[0].MaxHeaderLength() }
+
+// LinkAddress implements stack.LinkEndpoint.
+func (m *multiEndpoint) LinkAddress() tcpip.LinkAddress { return m.eps[0].LinkAddress() }
+
+// SetLinkAddress implements stack.LinkEndpoint.
+func (m *multiEndpoint) SetLinkAddress(addr tcpip.LinkAddress) {
+	for _, e := range m.eps {
+		e.SetLinkAddress(addr)
+	}
+}
+
+// Capabilities implements stack.LinkEndpoint.
+func (m *multiEndpoint) Capabilities() stack.LinkEndpointCapabilities {
+	return m.eps[0].Capabilities()
+}
+
+// Attach implements stack.LinkEndpoint. Attaches every per-queue endpoint so
+// each runs its own dispatch goroutine feeding the shared dispatcher. A nil
+// dispatcher (NIC removal) stops them all.
+func (m *multiEndpoint) Attach(d stack.NetworkDispatcher) {
+	for _, e := range m.eps {
+		e.Attach(d)
+	}
+}
+
+// IsAttached implements stack.LinkEndpoint.
+func (m *multiEndpoint) IsAttached() bool { return m.eps[0].IsAttached() }
+
+// Wait implements stack.LinkEndpoint.
+func (m *multiEndpoint) Wait() {
+	for _, e := range m.eps {
+		e.Wait()
+	}
+}
+
+// ARPHardwareType implements stack.LinkEndpoint.
+func (m *multiEndpoint) ARPHardwareType() header.ARPHardwareType {
+	return m.eps[0].ARPHardwareType()
+}
+
+// AddHeader implements stack.LinkEndpoint. The link header is encoded once per
+// packet (all queues produce an identical ethernet header), so delegate to one
+// sub-endpoint — never once per queue.
+func (m *multiEndpoint) AddHeader(pkt *stack.PacketBuffer) {
+	m.eps[0].AddHeader(pkt)
+}
+
+// ParseHeader implements stack.LinkEndpoint.
+func (m *multiEndpoint) ParseHeader(pkt *stack.PacketBuffer) bool {
+	return m.eps[0].ParseHeader(pkt)
+}
+
+// Close implements stack.LinkEndpoint.
+func (m *multiEndpoint) Close() {
+	for _, e := range m.eps {
+		e.Close()
+	}
+}
+
+// SetOnCloseAction implements stack.LinkEndpoint.
+func (m *multiEndpoint) SetOnCloseAction(f func()) {
+	for _, e := range m.eps {
+		e.SetOnCloseAction(f)
+	}
+}
