+// xdpLinkFD extracts the raw FD of an XDP link. link.Link in this build of
+// cilium/ebpf has no FD() method (only the concrete link types do, via their
+// embedded *link.RawLink); AttachXDP and LoadPinnedLink both return a concrete
+// XDP link type that exposes FD().
+func xdpLinkFD(l link.Link) (int, error) {
+	if v, ok := l.(interface{ FD() int }); ok {
+		return v.FD(), nil
+	}
+	return 0, fmt.Errorf("cannot get FD of link type %T", l)
+}
