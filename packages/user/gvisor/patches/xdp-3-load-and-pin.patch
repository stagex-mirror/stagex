--- a/runsc/sandbox/xdp.go
+++ b/runsc/sandbox/xdp.go
@@ -41,6 +41,12 @@
 //
 // To enable XDP support, build gVisor with `--define=gotags=xdp`.
 
+// The redirect path expects the eBPF map to be pinned under
+// /sys/fs/bpf/<iface>/ by the standalone xdp_loader tool, which has no main
+// on the go branch. createRedirectInterfacesAndRoutes therefore performs that
+// pin step itself, using the same embedded object xdp_loader embeds (exposed
+// as xdpcmd.RedirectProgramBytes).
+
 // createRedirectInterfacesAndRoutes initializes the network using an AF_XDP
 // socket on a *host* device, not a device in the container netns. It:
 //
@@ -89,9 +95,76 @@
 	// removed from eBPF maps when released. See net/xdp/xsk.c:xsk_release
 	// and net/xdp/xsk.c:xsk_delete_from_maps.
 	mapPath := xdpcmd.RedirectMapPath(iface.Name)
-	pinnedMap, err := ebpf.LoadPinnedMap(mapPath, nil)
-	if err != nil {
-		return fmt.Errorf("failed to load pinned map %s: %w", mapPath, err)
+	progPath := xdpcmd.RedirectProgramPath(iface.Name)
+	linkPath := xdpcmd.RedirectLinkPath(iface.Name)
+	var pinnedMap *ebpf.Map
+	if pm, err := ebpf.LoadPinnedMap(mapPath, nil); err == nil {
+		// A pinned map already exists (re-run, or pinned by an external
+		// xdp_loader): reuse it.
+		pinnedMap = pm
+	} else {
+		// No pinned map: perform the missing xdp_loader pin step here. Load
+		// the same embedded object tools/xdp/cmd embeds, attach it to the
+		// device in the fastest working mode (offload, driver, generic),
+		// and pin the map, program, and link exactly as xdp_loader does
+		// (/sys/fs/bpf/<iface>/{redirect_ip_map, redirect_program,
+		// redirect_link}). Pinning the link keeps the program attached
+		// after runsc exits.
+		spec, err := ebpf.LoadCollectionSpecFromReader(bytes.NewReader(xdpcmd.RedirectProgramBytes()))
+		if err != nil {
+			return fmt.Errorf("failed to load redirect spec: %v", err)
+		}
+		var objects struct {
+			Program *ebpf.Program `ebpf:"xdp_prog"`
+			SockMap *ebpf.Map     `ebpf:"sock_map"`
+		}
+		if err := spec.LoadAndAssign(&objects, nil); err != nil {
+			return fmt.Errorf("failed to load redirect program: %v", err)
+		}
+		defer objects.Program.Close()
+		defer objects.SockMap.Close()
+
+		var attached link.Link
+		var attachErr error
+		for _, mode := range []link.XDPAttachFlags{link.XDPOffloadMode, link.XDPDriverMode, link.XDPGenericMode} {
+			attached, attachErr = link.AttachXDP(link.XDPOptions{
+				Program:   objects.Program,
+				Interface: iface.Index,
+				Flags:     mode,
+			})
+			if attachErr == nil {
+				break
+			}
+			log.Infof("failed to attach redirect program in mode %v: %v", mode, attachErr)
+		}
+		if attached == nil {
+			return fmt.Errorf("failed to attach redirect program: %v", attachErr)
+		}
+
+		// Create directory /sys/fs/bpf/<device name>/.
+		pinDir := xdpcmd.RedirectPinDir(iface.Name)
+		if err := os.Mkdir(pinDir, 0700); err != nil && !os.IsExist(err) {
+			return fmt.Errorf("failed to create directory for pinning at %s: %v", pinDir, err)
+		}
+
+		// Pin the map, program, and link (same order as xdp_loader).
+		if err := objects.SockMap.Pin(mapPath); err != nil {
+			return fmt.Errorf("failed to pin map at %s: %v", mapPath, err)
+		}
+		log.Infof("Pinned map at %s", mapPath)
+		if err := objects.Program.Pin(progPath); err != nil {
+			return fmt.Errorf("failed to pin program at %s: %v", progPath, err)
+		}
+		log.Infof("Pinned program at %s", progPath)
+		if err := attached.Pin(linkPath); err != nil {
+			return fmt.Errorf("failed to pin link at %s: %v", linkPath, err)
+		}
+		log.Infof("Pinned link at %s", linkPath)
+
+		pinnedMap, err = ebpf.LoadPinnedMap(mapPath, nil)
+		if err != nil {
+			return fmt.Errorf("failed to load pinned map %s: %v", mapPath, err)
+		}
 	}
 	// TODO(b/240191988): Updating of pinned maps should be synchronized and
 	// check for the existence of the key.
