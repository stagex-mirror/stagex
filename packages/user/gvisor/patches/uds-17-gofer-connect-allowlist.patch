+package fsgofer
+
+import "testing"
+
+// TestHostUDSConnectAllowed covers the uds-17 allowlist predicate: an empty
+// list allows everything, a non-empty list requires an exact absolute-path
+// match (no prefix matching, no globbing).
+func TestHostUDSConnectAllowed(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		allowed  []string
+		path     string
+		expected bool
+	}{
+		{
+			name:     "EmptyListAllows",
+			allowed:  nil,
+			path:     "/anything/at/all.sock",
+			expected: true,
+		},
+		{
+			name:     "EmptyListAllowsRelativeToo",
+			allowed:  []string{},
+			path:     "relative.sock",
+			expected: true,
+		},
+		{
+			name:     "ExactMatchAllows",
+			allowed:  []string{"/run/foo.sock"},
+			path:     "/run/foo.sock",
+			expected: true,
+		},
+		{
+			name:     "ExactMatchAmongSeveral",
+			allowed:  []string{"/run/a.sock", "/run/b.sock"},
+			path:     "/run/b.sock",
+			expected: true,
+		},
+		{
+			name:     "CleanedPathMatches",
+			allowed:  []string{"/run/foo.sock"},
+			path:     "/run//foo.sock",
+			expected: true,
+		},
+		{
+			name:     "PrefixDoesNotAllow",
+			allowed:  []string{"/run/foo.sock"},
+			path:     "/run/foo.sock.extra",
+			expected: false,
+		},
+		{
+			name:     "DirectoryPrefixDoesNotAllow",
+			allowed:  []string{"/run"},
+			path:     "/run/foo.sock",
+			expected: false,
+		},
+		{
+			name:     "DifferentPathRejects",
+			allowed:  []string{"/run/foo.sock"},
+			path:     "/run/bar.sock",
+			expected: false,
+		},
+		{
+			name:     "RelativePathRejects",
+			allowed:  []string{"/run/foo.sock"},
+			path:     "run/foo.sock",
+			expected: false,
+		},
+		{
+			name:     "EmptyPathRejects",
+			allowed:  []string{"/run/foo.sock"},
+			path:     "",
+			expected: false,
+		},
+		{
+			name:     "GlobDoesNotMatch",
+			allowed:  []string{"/run/*.sock"},
+			path:     "/run/foo.sock",
+			expected: false,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := hostUDSConnectAllowed(tc.allowed, tc.path); got != tc.expected {
+				t.Errorf("hostUDSConnectAllowed(%v, %q) = %v, want %v", tc.allowed, tc.path, got, tc.expected)
+			}
+		})
+	}
+}
