+// hostUDSConnectAllowed reports whether connecting to the host unix domain
+// socket at hostPath is permitted under the AllowedHostUDS allowlist (uds-17).
+//
+// Security predicate (this is a security boundary):
+//   - An empty allowlist allows everything (the pre-uds-17 behavior, so
+//     existing uses such as bastiond need no changes).
+//   - Otherwise the path must EQUAL one of the entries after filepath.Clean
+//     (exact absolute-path match only; no prefix matching, no globbing).
+func hostUDSConnectAllowed(allowed []string, hostPath string) bool {
+	if len(allowed) == 0 {
+		return true
+	}
+	if !filepath.IsAbs(hostPath) {
+		// The allowlist is absolute paths by construction (validated in
+		// config.Validate); a relative connect path can never equal one.
+		return false
+	}
+	cleaned := filepath.Clean(hostPath)
+	for _, p := range allowed {
+		if filepath.Clean(p) == cleaned {
+			return true
+		}
+	}
+	return false
+}
