+// stringListConfig holds a comma-separated list of strings. It implements
+// flag.Value so a repeatable list can be plumbed through the standard
+// flag/Config/ToFlags reflection machinery (empty elements are dropped, so
+// the zero value and the empty string both mean "unset").
+type stringListConfig []string
+
+func stringListConfigPtr(v stringListConfig) *stringListConfig {
+	return &v
+}
+
+// Set implements flag.Value. Set(String()) should be idempotent.
+func (s *stringListConfig) Set(v string) error {
+	var list stringListConfig
+	for _, part := range strings.Split(v, ",") {
+		if part != "" {
+			list = append(list, part)
+		}
+	}
+	*s = list
+	return nil
+}
+
+// Get implements flag.Value.
+func (s *stringListConfig) Get() any {
+	return *s
+}
+
+// String implements flag.Value.
+func (s stringListConfig) String() string {
+	return strings.Join(s, ",")
+}
