+// isCharDeviceFD reports whether the host file descriptor refers to a
+// character device (via fstat, the authoritative source — the gofer node's
+// metadata may not carry the file type). A non-nil error (the fd is invalid
+// or the fstat fails) is treated as "not a char device" (the regular-file
+// path, the safe default).
+func isCharDeviceFD(hostFD int) bool {
+	var st unix.Stat_t
+	if err := unix.Fstat(hostFD, &st); err != nil {
+		return false
+	}
+	return st.Mode&unix.S_IFMT == unix.S_IFCHR
+}
