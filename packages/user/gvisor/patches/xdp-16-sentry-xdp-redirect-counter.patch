+// eBPF guard keeps redirecting frames (the bpf_counts redirect counter climbs)
+// but the consumer index is not advancing (the socket's ring is not being
+// drained).
+func (rq *RXQueue) Consumer() uint32 {
+	return rq.consumer.RacyLoad()
