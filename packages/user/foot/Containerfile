FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-wayland . /
COPY --from=stagex/user-wayland-protocols . /
COPY --from=stagex/user-xkbcommon . /
COPY --from=stagex/user-fcft . /
COPY --from=stagex/user-freetype . /
COPY --from=stagex/user-utf8proc . /
COPY --from=stagex/user-pixman . /
COPY --from=stagex/user-tllist . /
COPY --from=stagex/user-fontconfig . /
COPY --from=stagex/core-ncurses . /
COPY --from=stagex/core-libpng . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-libxml2 . /
ADD fetch/foot-${VERSION}.tar.gz .
WORKDIR /foot-${VERSION}
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/foot-${VERSION}=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dgrapheme-clustering=enabled \
		-Dime=true \
		-Dterminfo=enabled \
		-Ddocs=disabled \
		. build
	meson compile -C build
	DESTDIR=/rootfs meson install -C build
	install -Dm644 LICENSE /rootfs/usr/share/licenses/foot/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
