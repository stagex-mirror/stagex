FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-make . /
COPY --from=stagex/core-openssl . /
ADD fetch/rsync-${VERSION}.tar.gz .
WORKDIR /rsync-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/rsync-${VERSION}=."
ENV CPPFLAGS="-D_GNU_SOURCE -std=c17"
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--disable-debug \
		--disable-xxhash \
		--disable-lz4 \
		--disable-md2man
	# Workaround: help-from-md.awk generates broken C with unescaped quotes
	# Replace the broken help-rsync.h/help-rsyncd.h with empty stubs
	: > help-rsync.h
	: > help-rsyncd.h
	make -j$(nproc)
	DESTDIR=/rootfs make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/rsync/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
