FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-libpng . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/user-gperf . /
COPY --from=stagex/user-freetype . /
ADD fetch/fontconfig-${VERSION}.tar.xz .
RUN mv fontconfig-${VERSION}* fontconfig
WORKDIR /fontconfig
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/fontconfig=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Ddoc=disabled \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
	install -Dm644 COPYING /rootfs/usr/share/licenses/fontconfig/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
