FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
ADD fetch/kata-static-${VERSION}-x86_64.tar.xz .
RUN --network=none <<-EOF
	mkdir -p /rootfs/usr/bin /rootfs/usr/share/kata-containers /rootfs/etc/kata-containers
	cp bin/* /rootfs/usr/bin/
	cp -r kata-containers/ /rootfs/usr/share/kata-containers/
	mkdir -p /rootfs/etc/kata-containers
	cp configs/ /rootfs/etc/kata-containers/
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
