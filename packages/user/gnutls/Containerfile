FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/core-autoconf . /
COPY --from=stagex/core-automake . /
COPY --from=stagex/core-libtool . /
COPY --from=stagex/core-gettext . /
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-make . /
COPY --from=stagex/core-texinfo . /
COPY --from=stagex/user-nettle . /
COPY --from=stagex/core-openssl . /
COPY --from=stagex/core-gmp . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/user-libtasn1 . /
COPY --from=stagex/user-tpm2-tss . /
COPY --from=stagex/user-libidn2 . /
COPY --from=stagex/user-libunistring . /
COPY --from=stagex/user-p11-kit . /
ADD fetch/gnutls-${VERSION}.tar.xz .
WORKDIR /gnutls-${VERSION}
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-rpath \
		--disable-static \
		--disable-libtool-lock \
		--disable-valgrind-tests \
		--disable-afalg \
		--enable-ktls \
		--with-brotli=link \
		--with-default-trust-store-file=/etc/ssl/certs/ca-certificates.crt \
		--with-tpm2=link \
		--with-zlib=link \
		--with-zstd=link \
		--libdir=/usr/lib
	DESTDIR="/rootfs" make -j "$(nproc)" install
	install -Dm644 COPYING.LESSERv2 /rootfs/usr/share/licenses/gnutls/
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
