FROM stagex/pallet-rust AS build
ARG VERSION
COPY --from=stagex/core-openssl . /
COPY --from=stagex/core-ca-certificates . /
COPY --from=stagex/core-libunwind . /
COPY --from=stagex/user-tpm2-tss . /
ADD fetch/rust-keylime-${VERSION}.tar.gz .
ADD patches/*.patch /rust-keylime-${VERSION}/patches/
WORKDIR /rust-keylime-${VERSION}

# Apply patches
RUN patch -p1 < patches/0001-add-skip-registration-standalone-mode.patch

# Fetch dependencies (needs network)
RUN cargo fetch

# Build the binary (offline)
RUN --network=none <<-'EOF'
	cargo build --release --bin keylime_agent --target x86_64-unknown-linux-musl --offline && \
	strip target/x86_64-unknown-linux-musl/release/keylime_agent && \
	cp target/x86_64-unknown-linux-musl/release/keylime_agent /usr/bin/keylime_agent && \
	ls -lh /usr/bin/keylime_agent
EOF

FROM stagex/core-filesystem AS package-keylime-agent
COPY --from=build /usr/bin/keylime_agent /usr/bin/keylime_agent
COPY --from=stagex/core-libunwind . /
