FROM stagex/pallet-python AS build
COPY --from=stagex/core-py-hatchling . /
COPY --from=stagex/core-py-hatch-vcs . /
COPY --from=stagex/core-py-pathspec . /
COPY --from=stagex/core-py-pluggy . /
COPY --from=stagex/core-py-trove-classifiers . /
COPY --from=stagex/core-py-packaging . /
COPY --from=stagex/user-py-hatch-fancy-pypi-readme . /
COPY --from=stagex/core-py-setuptools-scm . /
ARG VERSION
ADD fetch/py-twisted-${VERSION}.tar.gz /
WORKDIR /twisted-${VERSION}
RUN --network=none <<-EOF
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python -m installer -d /rootfs .dist/*.whl
	install -vDm644 LICENSE /rootfs/usr/share/licenses/py-twisted/LICENSE
	find /rootfs | grep -E "(/__pycache__$|\.pyc$|\.pyo$)" | xargs rm -rf
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
