FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/sshdt-${VERSION}.tar.gz .
WORKDIR /sshdt-${VERSION}
# Dynamic: pallet-rust's musl target defaults to dynamic linking (the
# toolchain patches crt_static_default off). Links against the shared musl
# runtime (core-musl + core-libunwind) already shipped in the rootfs.
ENV RUSTFLAGS='-C codegen-units=1'
RUN cargo fetch
RUN --network=none <<-EOF
  set -eux
  ARCH=$(uname -m)
  cargo build \
    --frozen \
    --release \
    --target "${ARCH}-unknown-linux-musl" \
    -p sshdt
  install -vDm755 target/${ARCH}-unknown-linux-musl/release/sshdt /rootfs/usr/bin/sshdt
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
