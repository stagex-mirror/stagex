FROM stagex/pallet-rust AS build
ARG VERSION
ADD fetch/mdbook-${VERSION}.tar.gz .
WORKDIR /mdBook-${VERSION}
ENV RUST_BACKTRACE=1
ENV RUSTFLAGS='-C codegen-units=1 -C target-cpu=x86-64 -C target-feature=+crt-static -C strip=symbols -C link-arg=-Wl,--build-id=none'
RUN cargo fetch
RUN --network=none <<-EOF
	cargo build \
		--frozen \
		--release \
		--target $(uname -m)-unknown-linux-musl \
		--bin mdbook
	mkdir -p /rootfs/usr/bin
	cp target/$(uname -m)-unknown-linux-musl/release/mdbook /rootfs/usr/bin/
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
