FROM stagex/pallet-clang-cmake-busybox AS build
COPY --from=stagex/core-make / /
ARG VERSION
ADD fetch/msgpack-c-${VERSION}.tar.gz .
WORKDIR /msgpack-c-c-${VERSION}/build
RUN --network=none <<-EOF
	cmake \
		-B . \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DCPP_BUILD=OFF \
		-DCPACK_ENABLE_BUILD_TEST=OFF \
		-DMSGPACK_BUILD_TESTS=OFF \
		..
	cmake --build .
	DESTDIR="/rootfs" cmake --install .
	install -Dm644 ${PWD}/../COPYING /rootfs/usr/share/licenses/msgpack/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

FROM package AS package-run
COPY --from=stagex/core-attr . /

