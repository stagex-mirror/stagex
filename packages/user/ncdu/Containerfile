FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-make . /
COPY --from=stagex/core-ncurses . /
ADD fetch/ncdu-${VERSION}.tar.gz .
WORKDIR /ncdu-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/ncdu-${VERSION}=."
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--disable-xattr
	make -j$(nproc)
	DESTDIR=/rootfs make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/ncdu/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
