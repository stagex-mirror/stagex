FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
ADD fetch/libevdev-${VERSION}.tar.xz .
WORKDIR /libevdev-${VERSION}
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/libevdev-${VERSION}=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Ddocumentation=disabled \
		-Dtests=disabled \
		-Dtools=disabled \
		. build
	meson compile -C build
	DESTDIR=/rootfs meson install -C build
	install -Dm644 COPYING /rootfs/usr/share/licenses/libevdev/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
