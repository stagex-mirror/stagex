## Generic x86_64 config for QEMU emulation target
##
## This config targets the QEMU i440fx/piix4 platform, which provides a
## generic x86_64 build that works across both AMD and Intel CPU families.
##
## NOTE: Intel integrated graphics (libgfxinit) is NOT enabled. The
## libgfxinit module is written in Ada/SPARK and requires a full source-
## bootstrapped gnat (GNAT) compiler, which is not yet available in
## StageX. To add Intel iGPU support:
##   1. Create a gnat/ada-bootstrap package
##   2. Enable CONFIG_MAINBOARD_USE_LIBGFXINIT=y below
##   3. Alternatively, use FSP GOP (CONFIG_RUN_FSP_GOP=y) which uses
##      Intel's proprietary FSP binary blob instead of libgfxinit
##
CONFIG_VENDOR_EMULATION=y
CONFIG_BOARD_EMULATION_QEMU_X86_I440FX=y
CONFIG_USE_X86_64_SUPPORT=y
CONFIG_ANY_TOOLCHAIN=y
