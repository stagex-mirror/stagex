FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-glib . /
COPY --from=stagex/user-freetype . /
COPY --from=stagex/user-fontconfig . /
COPY --from=stagex/core-icu . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/core-libpng . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-zlib . /
ADD fetch/harfbuzz-${VERSION}.tar.xz .
WORKDIR /harfbuzz-${VERSION}
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/harfbuzz-${VERSION}=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dtests=disabled \
		-Ddocs=disabled \
		-Dintrospection=disabled \
		-Draster=disabled \
		-Dvector=disabled \
		-Dgpu=disabled \
		-Dsubset=disabled \
		-Dutilities=disabled \
		. build
	meson compile -C build
	DESTDIR=/rootfs meson install -C build
	install -Dm644 COPYING /rootfs/usr/share/licenses/harfbuzz/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
