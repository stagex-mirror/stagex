FROM stagex/pallet-clang-gnu-busybox AS build
COPY --from=stagex/core-xorgproto . /
COPY --from=stagex/core-libx11 . /
COPY --from=stagex/core-libxcb . /
COPY --from=stagex/core-libxdmcp . /
COPY --from=stagex/core-libxau . /
COPY --from=stagex/user-libxext . /
COPY --from=stagex/core-util-macros . /
ARG VERSION
ADD fetch/libXrender-${VERSION}.tar.xz .
WORKDIR /libXrender-${VERSION}
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var
	make
	make install DESTDIR=/rootfs
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
