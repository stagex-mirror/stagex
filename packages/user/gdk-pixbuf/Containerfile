FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-glib . /
COPY --from=stagex/core-pcre2 . /
COPY --from=stagex/core-libpng . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-expat . /
ADD fetch/gdk-pixbuf-${VERSION}.tar.xz .
RUN mv gdk-pixbuf-${VERSION}* gdk-pixbuf
WORKDIR /gdk-pixbuf
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/gdk-pixbuf=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dbuiltin_loaders='png' \
		-Djpeg=disabled \
		-Dgio_sniffing=false \
		-Dman=false \
		-Dtests=false \
		-Dintrospection=disabled \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
	install -Dm644 COPYING /rootfs/usr/share/licenses/gdk-pixbuf/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
