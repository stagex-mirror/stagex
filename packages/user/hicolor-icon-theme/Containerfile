FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
ADD fetch/hicolor-icon-theme-${VERSION}.tar.xz .
RUN mv hicolor-icon-theme-${VERSION}* hicolor
WORKDIR /hicolor
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
