FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
ADD fetch/libogg-${VERSION}.tar.gz .
WORKDIR /ogg-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -ffile-prefix-map=/ogg-${VERSION}=."
RUN --network=none <<-EOF
	cmake \
		-B build \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=OFF \
		-DBUILD_TESTING=OFF \
		.
	cmake --build build
	DESTDIR=/rootfs cmake --install build
	install -Dm644 COPYING /rootfs/usr/share/licenses/libogg/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
