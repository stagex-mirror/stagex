 end
 
+
+--- Deterministic mpack encoder for build reproducibility.
+--- Handles mixed tables as array+map (matching mpack.encode behavior).
+---
+--- @param mpack module providing encode() function
+--- @param v any value to encode
+--- @return string encoded bytes
+function M.det_encode(mpack, v)
+  local t = type(v)
+  if t == 'nil' then return string.char(0x00) end
+  if t == 'boolean' then return string.char(v and 0xc3 or 0xc2) end
+  if t == 'number' or t == 'string' then return mpack.encode(v) end
+  if t ~= 'table' then return mpack.encode(v) end
+  local num_keys = {}
+  local str_keys = {}
+  local max_idx = 0
+  for k in pairs(v) do
+    if type(k) == 'number' and k > 0 and k == math.floor(k) then
+      table.insert(num_keys, k)
+      if k > max_idx then max_idx = k end
+    else
+      table.insert(str_keys, k)
+    end
+  end
+  table.sort(num_keys)
+  table.sort(str_keys)
+  local is_pure_array = (#num_keys == max_idx and #str_keys == 0)
+  local parts
+  if is_pure_array then
+    local hdr = (max_idx <= 15) and string.char(0x90 + max_idx) or
+      string.char(0xdc, math.floor(max_idx / 256), max_idx % 256)
+    parts = { hdr }
+    for i = 1, max_idx do parts[#parts + 1] = M.det_encode(mpack, v[i]) end
+  else
+    parts = {}
+    if max_idx > 0 then
+      local ahdr = (max_idx <= 15) and string.char(0x90 + max_idx) or
+        string.char(0xdc, math.floor(max_idx / 256), max_idx % 256)
+      parts[#parts + 1] = ahdr
+      for _, i in ipairs(num_keys) do parts[#parts + 1] = M.det_encode(mpack, v[i]) end
+    end
+    if #str_keys > 0 then
+      local mhdr = (#str_keys <= 15) and string.char(0x80 + #str_keys) or
+        string.char(0xde, math.floor(#str_keys / 256), #str_keys % 256)
+      parts[#parts + 1] = mhdr
+      for _, k in ipairs(str_keys) do
+        parts[#parts + 1] = M.det_encode(mpack, k)
+        parts[#parts + 1] = M.det_encode(mpack, v[k])
+      end
+    end
+  end
+  return table.concat(parts)
+end
 return M
