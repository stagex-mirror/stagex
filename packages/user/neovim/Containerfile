FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-make / /
COPY --from=stagex/core-luajit / /
COPY --from=stagex/user-libuv / /
COPY --from=stagex/user-luv / /
COPY --from=stagex/user-tree-sitter / /
COPY --from=stagex/user-tree-sitter-c / /
COPY --from=stagex/user-tree-sitter-lua / /
COPY --from=stagex/user-tree-sitter-markdown / /
COPY --from=stagex/user-tree-sitter-query / /
COPY --from=stagex/user-tree-sitter-vimdoc / /
COPY --from=stagex/user-unibilium / /
COPY --from=stagex/user-utf8proc / /
COPY --from=stagex/user-msgpack / /
COPY --from=stagex/user-msgpack-cxx / /
COPY --from=stagex/core-gettext / /
COPY --from=stagex/user-gperf / /
COPY --from=stagex/user-lpeg / /
COPY --from=stagex/core-ca-certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ADD fetch/v${VERSION}.tar.gz /
WORKDIR /neovim-${VERSION}
ENV CFLAGS="-march=x86-64 -frandom-seed=nvim -ffile-prefix-map=/neovim-${VERSION}=."
ENV CXXFLAGS="-frandom-seed=nvim -ffile-prefix-map=/neovim-${VERSION}=."
ENV SOURCE_DATE_EPOCH="1"
COPY 0001-fix-build-reproducibility.patch .
RUN --network=none <<-EOF
	patch -p1 < 0001-fix-build-reproducibility.patch
	find /usr -type f \( -name '*.a' -o -name '*.so' \) -exec touch -h -d '@1' {} + 2>/dev/null || true
	mkdir -p build/.deps
	cmake \
		-B build/.deps \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DUSE_BUNDLED_LPEG=OFF \
		-DUSE_BUNDLED_LIBUV=OFF \
		-DUSE_BUNDLED_LUV=OFF \
		-DUSE_BUNDLED_LUAJIT=OFF \
		-DUSE_BUNDLED_TS=OFF \
		-DUSE_BUNDLED_TS_PARSERS=OFF \
		-DUSE_BUNDLED_UNIBILIUM=OFF \
		-DUSE_BUNDLED_UTF8PROC=OFF \
		-DUSE_BUNDLED_GETTEXT=OFF \
		-DUSE_BUNDLED_LIBICONV=OFF \
		cmake.deps
	cmake --build build/.deps
	sed -i '/function(find_library_nvim)/,/^endfunction/{s/NO_CMAKE_SYSTEM_PATH/USE_SYSTEM_ENVIRONMENT_PATH/}' cmake/Find.cmake
	sed -i 's|NAMES lpeg_a lpeg liblpeg_a|NAMES lpeg_a lpeg.a liblpeg_a|' cmake/FindLpeg.cmake
	export DEPS_BUILD_DIR="${PWD}/build/.deps"
	cmake \
		-B build \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_FIND_LIBRARY_SUFFIXES=".a;.so" \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
		-DCMAKE_SKIP_RPATH=ON \
		-DCMAKE_C_FLAGS_INIT="-march=x86-64 -frandom-seed=nvim -ffile-prefix-map=/neovim-${VERSION}=." \
		-DCMAKE_CXX_FLAGS_INIT="-frandom-seed=nvim -ffile-prefix-map=/neovim-${VERSION}=." \
		-DCMAKE_EXE_LINKER_FLAGS_INIT="-Wl,--no-threads -Wl,--build-id=none" \
		-DLUAC_PRG="luajit -b -s -d %q -" \
		-DENABLE_TRANSLATIONS=OFF
	cmake --build build
	DESTDIR="/rootfs" cmake --install build --prefix /usr
	find /rootfs -exec touch -h -d '@1' {} +
	rm -rf /rootfs/usr/share/nvim/runtime/parser
	install -Dm644 LICENSE.txt /rootfs/usr/share/licenses/neovim/LICENSE.txt
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/usr /usr
