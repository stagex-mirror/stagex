FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/core-gmp . /
COPY --from=stagex/core-ncurses . /
COPY --from=stagex/core-libedit . /
COPY --from=stagex/user-libnftnl . /
COPY --from=stagex/user-libmnl . /
COPY --from=stagex/user-jansson . /
COPY --from=stagex/core-bash . /
ADD fetch/nftables-${VERSION}.tar.xz .
WORKDIR /nftables-${VERSION}
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	export CONFIG_SHELL=/usr/bin/bash
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--localstatedir=/var \
		--with-cli=editline \
		--with-json \
		--enable-static
	# nftables bakes MAKE_STAMP=$(date +%s) into nftversion.h's nftbuildstamp[].
	# busybox `date` ignores SOURCE_DATE_EPOCH, so pin the stamp explicitly or
	# every rebuild embeds the wall-clock build time (non-reproducible).
	make -j1 MAKE_STAMP="${SOURCE_DATE_EPOCH}"
	make -j1 MAKE_STAMP="${SOURCE_DATE_EPOCH}" install DESTDIR=/rootfs
	# Strip DWARF from the shared lib; its debug sections are not reproducible.
	find /rootfs -name "*.so*" -exec llvm-strip --strip-debug {} +
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
