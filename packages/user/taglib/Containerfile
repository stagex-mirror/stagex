FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-bzip2 . /
COPY --from=stagex/user-utf8cpp . /
ADD fetch/taglib-v${VERSION}.tar.gz .
WORKDIR /taglib-${VERSION}
ARG SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/taglib-${VERSION}=."
ENV CXXFLAGS="-O2 -fPIC -ffile-prefix-map=/taglib-${VERSION}=."
RUN --network=none <<-EOF
	cmake \
		-B build \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=OFF \
		-DTAGLIB_ENABLE_EXAMPLES=OFF \
		-DTAGLIB_BUILD_TESTS=OFF \
		.
	cmake --build build
	DESTDIR=/rootfs cmake --install build
	install -Dm644 COPYING.LGPL /rootfs/usr/share/licenses/taglib/COPYING.LGPL
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
