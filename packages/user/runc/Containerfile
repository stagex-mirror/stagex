FROM stagex/pallet-cgo AS build
ARG VERSION
COPY --from=stagex/user-libseccomp . /
COPY --from=stagex/user-go-md2man . /
COPY --from=stagex/core-bash . /
COPY --from=stagex/core-ncurses . /
ADD fetch/runc-${VERSION}.tar.gz .
WORKDIR /runc-${VERSION}
COPY --chmod=755 <<-EOF /usr/bin/git
	#!/bin/sh
	echo ${VERSION}
EOF
RUN <<-EOF
	CGO_ENABLED=0 make RUNC_BUILDTAGS="-libpathrs" EXTRA_LDFLAGS="-w -s -buildid=" COMMIT=${VERSION} -j "$(nproc)"
	install -vDm755 -t /rootfs/usr/bin runc
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
