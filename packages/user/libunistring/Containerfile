FROM stagex/pallet-clang AS build
ARG VERSION
COPY --from=stagex/core-autoconf . /
COPY --from=stagex/core-automake . /
COPY --from=stagex/core-libtool . /
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-make . /
ADD fetch/libunistring-${VERSION}.tar.xz .
WORKDIR /libunistring-${VERSION}
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static \
		--disable-doc
	make
	DESTDIR="/rootfs" make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/libunistring/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

FROM package AS package-run
COPY --from=stagex/core-attr . /

