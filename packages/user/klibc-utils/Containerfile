FROM stagex/pallet-clang-gnu-busybox AS base
COPY --from=stagex/core-linux-headers . /
FROM base AS build
ARG VERSION
ADD fetch/klibc-${VERSION}.tar.xz .
ADD init.c .
WORKDIR /klibc-${VERSION}
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	set -eux
	# Install kernel UAPI headers for klibc (full include tree)
	mkdir -p linux
	cp -a /usr/include linux/include
	# Configure klibc for musl and minimal initramfs utilities
	cat > local.conf << 'CONF'
	CONFIG_CC="clang"
	CONFIG_CFLAGS="-Os -static"
	CONFIG_LDFLAGS="-static"
	CONF
	# klcc needs CC in environment or as make arg; HOSTCC for host tools too
	export CC=clang
	make -j$(nproc) CC=clang HOSTCC=clang
	# Install utilities to rootfs
	mkdir -p /rootfs/usr/bin
	# Static utilities (klibc progs)
	for util in mount mkdir mknod ls cat sleep pivot_root; do
	    cp usr/utils/static/$util /rootfs/usr/bin/
	done
	# Shell (dash) — static binary, no shared lib needed in initramfs
	cp usr/dash/static/sh /rootfs/usr/bin/
	# Verify
	echo "=== Installed ==="
	ls -la /rootfs/usr/bin/
	# --- Build monolithic init ---
	# Copy init.c into klibc build tree (it was added to context root)
	cp /init.c .
	sed -i 's|prefix = "/usr/lib/klibc"|prefix = "./usr"|' klcc/klcc
	sed -i 's|libdir=/usr/lib/klibc/lib|libdir=./usr/klibc|' klcc/klibc.config
	./klcc/klcc -Os -static -I./linux/include -c init.c -o init.o
	clang -Os -static -nostartfiles -m64 \
	    ./usr/klibc/arch/x86_64/crt0.o init.o \
	    -o init ./usr/klibc/libc.a
	cp init /rootfs/init
	echo "=== Monolith init ==="
	ls -la /rootfs/init
EOF

# --- Default package: vanilla utilities + core-filesystem ---
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/usr/bin/ /usr/bin/

# --- Subpackage: monolithic init (FROM scratch, single static binary) ---
FROM scratch AS package-klibc-utils-mono
COPY --from=build /rootfs/init /init
