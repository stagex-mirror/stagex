FROM stagex/pallet-clang-gnu-busybox AS build
COPY --from=stagex/core-openssl . /
ARG VERSION
ADD fetch/nmap-${VERSION}.tar.bz2 .
WORKDIR /nmap-${VERSION}
RUN --network=none <<-EOF
	sed -i 's/ac_cv_dnet_linux_pf_packet=no/ac_cv_dnet_linux_pf_packet=yes/' libdnet-stripped/configure
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-ipv6 \
		--with-openssl \
		--without-libssh2 \
		--without-nmap-update \
		--without-zenmap \
		--without-ndiff \
		--without-ncat \
		--with-version="${VERSION}"
	make
	make install DESTDIR=/rootfs
	install -Dm644 LICENSE /rootfs/usr/share/licenses/nmap/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
