FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-libxml2 . /
COPY --from=stagex/user-mesa . /
ADD fetch/libepoxy-${VERSION}.tar.xz .
RUN mv libepoxy-${VERSION}* libepoxy
WORKDIR /libepoxy
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/libepoxy=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dglx=no \
		-Degl=yes \
		-Dtests=false \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
	install -Dm644 COPYING /rootfs/usr/share/licenses/libepoxy/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
