FROM stagex/pallet-cgo AS build
ARG VERSION
ADD fetch/gum-${VERSION}.tar.gz .
WORKDIR /gum-${VERSION}
RUN go mod download
RUN --network=none <<-EOF
	go \
		build \
		-trimpath \
		-o gum \
		-v \
		-ldflags="-s -w" \
		.
	mkdir -p /rootfs/usr/bin/
	install -vDm755 -t /rootfs/usr/bin gum
	install -vDm644 -t /rootfs/usr/share/licenses/gum LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs /
