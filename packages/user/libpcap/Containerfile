FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
ADD fetch/libpcap-${VERSION}.tar.gz .
WORKDIR /libpcap-${VERSION}
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/libpcap-${VERSION}=."
RUN --network=none <<-EOF
	autoreconf -vfi
	./configure \
		--prefix=/usr \
		--disable-shared \
		--enable-static
	make -j$(nproc)
	make DESTDIR=/rootfs install
	install -vDm644 -t /rootfs/usr/share/licenses/libpcap LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
