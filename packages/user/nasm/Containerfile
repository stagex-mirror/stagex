FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
ADD fetch/nasm-${VERSION}.tar.xz .
WORKDIR /nasm-${VERSION}
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	./configure --prefix=/usr
	# Apply Alpine cast-to-bool patch: fix __STDC_VERSION__ typo and remove broken bool typedef hack
	patch -p1 <<-'PATCH'
diff --git a/include/compiler.h b/include/compiler.h
index 0ecd4e8d..53a9b5c1 100644
--- a/include/compiler.h
