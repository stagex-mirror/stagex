FROM stagex/pallet-rust AS build
COPY --from=stagex/pallet-python . /
COPY --from=stagex/core-py-cffi . /
COPY --from=stagex/user-py-cparser . /
COPY --from=stagex/user-maturin . /
COPY --from=stagex/user-py-semantic-version . /
COPY --from=stagex/user-py-setuptools-rust . /
COPY --from=stagex/user-py-typing-extensions . /
ARG VERSION
ADD fetch/py-cryptography-${VERSION}.tar.gz .
WORKDIR /cryptography-${VERSION}
RUN gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
RUN --network=none <<-EOF
    python -m installer -d /rootfs .dist/cryptography-*.whl
    install -vDm644 -t /rootfs/usr/share/licenses/py-cryptography LICENSE LICENSE.APACHE LICENSE.BSD
    find /rootfs | grep -E "(/__pycache__$|\.pyc$|\.pyo$|/RECORD$)" | xargs rm -rf
    # The cargo-cyclonedx SBOM embeds a real build timestamp and a random UUID,
    # so strip it to keep the image reproducible.
    rm -rf /rootfs/usr/lib/python*/site-packages/cryptography-*.dist-info/sboms
    # Strip DWARF from the rust extension; its debug sections are not reproducible.
    find /rootfs -name "*.abi3.so" -exec llvm-strip --strip-debug {} +
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
