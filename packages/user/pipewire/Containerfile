FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-alsa-lib . /
COPY --from=stagex/user-systemd . /
COPY --from=stagex/core-openssl . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-dbus . /
COPY --from=stagex/user-glib . /
COPY --from=stagex/core-pcre2 . /
COPY --from=stagex/core-lua . /
COPY --from=stagex/core-gettext . /
COPY --from=stagex/core-libxml2 . /
COPY --from=stagex/core-zlib . /
ADD fetch/pipewire-${VERSION}.tar.bz2 .
ADD fetch/wireplumber-0.5.14.tar.bz2 .
WORKDIR /pipewire-${VERSION}
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/pipewire-${VERSION}=."
ENV PKG_CONFIG_PATH="/usr/lib/pkgconfig"
RUN --network=none <<-EOF
	mv /wireplumber-0.5.14 subprojects/wireplumber
	sed -i 's|i18n_conf = files()|i18n_conf = files('"'"'src/config/wireplumber.conf'"'"')|' subprojects/wireplumber/meson.build
	sed -i "s/if python_po.found() and spa_json_dump_po.found()/if false  # python_po.found() and spa_json_dump_po.found()/" subprojects/wireplumber/po/meson.build
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dalsa=enabled \
		-Ddbus=enabled \
		-Ddocs=disabled \
		-Dexamples=disabled \
		-Dtests=disabled \
		-Dwireplumber:system-lua=true \
		-Dwireplumber:modules=false \
		-Dwireplumber:daemon=false \
		-Dwireplumber:tools=false \
		. build
	meson compile -C build -j1 || (cat build/meson-logs/build-log.txt; exit 1)
	DESTDIR=/rootfs meson install -C build
	install -Dm644 LICENSE /rootfs/usr/share/licenses/pipewire/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
