FROM stagex/pallet-clang AS build
ARG VERSION
COPY --from=stagex/core-autoconf . /
COPY --from=stagex/core-automake . /
COPY --from=stagex/core-libtool . /
COPY --from=stagex/core-busybox . /
COPY --from=stagex/core-make . /
COPY --from=stagex/user-libunistring . /
ADD fetch/libidn2-${VERSION}.tar.gz .
WORKDIR /libidn2-${VERSION}
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--disable-static \
		--disable-doc
	make
	DESTDIR="/rootfs" make install
	install -Dm644 COPYING /rootfs/usr/share/licenses/libidn2/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
