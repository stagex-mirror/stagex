FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/user-ninja . /
COPY --from=stagex/core-make . /
COPY --from=fetch llvm-project.tar.gz /
WORKDIR /src
RUN --network=none <<-EOF
    set -e
    
    # Extract LLVM project
    tar -xzf /llvm-project.tar.gz -C /tmp/
    mv /tmp/llvm-project-amd-mainline /src/llvm-project
    
    # Create build directory
    mkdir -p /src/llvm-project/build
    cd /src/llvm-project/build
    
    # Configure LLVM with ROCm support
    cmake -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DPython3_FIND_VIRTUALENV=FIRST \
        -DLLVM_BUILD_TOOLS=OFF \
        -DLLVM_ENABLE_BINDINGS=OFF \
        -DLLVM_ENABLE_LIBCXX=OFF \
        -DLLVM_ENABLE_TERMINFO=OFF \
        -DLLVM_ENABLE_UNWIND_TABLES=ON \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_TARGETS_TO_BUILD="X86;AMDGPU" \
        -DLLVM_ENABLE_PROJECTS="llvm;clang;lld" \
        -DLLVM_USE_SPLIT_DWARF=ON \
        ../llvm
    
    # Build LLVM (this is the long part)
    ninja -j "$(nproc)" llvm-opt-report clang lld
    
    # Install
    DESTDIR=/rootfs ninja install
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
