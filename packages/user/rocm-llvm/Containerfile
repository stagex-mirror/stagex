COPY --from=llvm-build /rootfs/usr/bin/c-index-test /usr/bin/
COPY --from=llvm-build /rootfs/usr/bin/cc /usr/bin/
COPY --from=llvm-build /rootfs/usr/bin/c++ /usr/bin/
