FROM stagex/pallet-clang-gnu-busybox AS build
COPY --from=stagex/core-ncurses . /
ARG VERSION
ADD fetch/nano-${VERSION}.tar.gz .
WORKDIR /nano-${VERSION}
RUN --network=none <<-EOF
	set -ex
	./configure --prefix=/usr
	make
	make DESTDIR="/rootfs" install
	install -vDm644 -t "/rootfs/usr/share/licenses/nano" COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

FROM package AS package-run
COPY --from=stagex/core-attr . /
COPY --from=stagex/core-libxml2 . /
COPY --from=stagex/pallet-lua . /

