FROM stagex/pallet-python AS build
ARG VERSION
COPY --from=stagex/core-uv . /
COPY --from=stagex/core-libunwind . /
ADD fetch/py-dnspython-${VERSION}.tar.gz .
WORKDIR /dnspython-${VERSION}
RUN --network=none <<-EOF
	set -eu
	uv build --offline --no-cache --wheel --out-dir .dist
	python -m installer --destdir=/rootfs .dist/*.whl
	install -vDm644 -t /rootfs/usr/share/licenses/py-dnspython LICENSE
	find /rootfs | grep -E "(/__pycache__$|\.pyc$|\.pyo$)" | xargs rm -rf
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
