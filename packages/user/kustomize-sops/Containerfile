FROM stagex/pallet-go AS build
ARG VERSION
ADD fetch/kustomize-sops-${VERSION}.tar.gz .
WORKDIR /kustomize-sops-${VERSION}
ENV GOPATH=/cache/go
ENV GOCACHE=/cache/
ENV GOWORK=off
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org
ENV CGO_ENABLED=0
ENV GOHOSTOS=linux
ENV GOHOSTARCH=amd64
RUN go get ./...
RUN --network=none <<-EOF
  set -eu
	go build -trimpath -v
	install -vDm755 -t /rootfs/usr/lib/kustomize/plugins/viaduct.ai/v1/ksops/ksops kustomize-sops
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
