FROM stagex/pallet-gcc-cmake-busybox AS build
ARG VERSION
COPY --from=stagex/core-make . /
COPY --from=stagex/core-gcc . /
ADD fetch/v0.3.27.tar.gz .
WORKDIR /OpenBLAS-0.3.27
RUN --network=none <<-EOF
    set -e
    # Build OpenBLAS with gcc (includes gfortran)
    make -j$(nproc) BINARY=64 USE_THREAD=1 NUM_THREADS=$(nproc) TARGET=GENERIC PREFIX=/usr NO_TCMALLOC=1 DYNAMIC_ARCH=1
    make install PREFIX=/usr DESTDIR=/rootfs
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
