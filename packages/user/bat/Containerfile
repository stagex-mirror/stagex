FROM stagex/pallet-rust AS build
ARG VERSION
ARG TARGETARCH
ADD fetch/bat-v${VERSION}.tar.gz .
WORKDIR /bat-${VERSION}
ENV RUST_BACKTRACE=1
ENV RUSTFLAGS="-C codegen-units=1 -C target-feature=+crt-static"
RUN cargo fetch
RUN --network=none <<-EOF
	cargo build \
		--frozen \
		--release \
		--target ${ARCH}-unknown-linux-musl \
		--bin bat
	install -vdm0755 /rootfs/usr/bin
	install -vDm755 -t /rootfs/usr/bin target/${ARCH}-unknown-linux-musl/release/bat
	install -vDm644 -t /rootfs/usr/share/licenses/bat LICENSE-MIT
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
