FROM stagex/pallet-rust AS build
ARG VERSION
ADD fetch/bat-v${VERSION}.tar.gz .
WORKDIR /bat-${VERSION}
ENV RUST_BACKTRACE=1
ENV RUSTFLAGS="-C codegen-units=1 -C target-feature=+crt-static"
RUN cargo fetch
RUN --network=none <<-EOF
	cargo build \
		--frozen \
		--release \
		--target $(uname -m)-unknown-linux-musl \
		--bin bat
	mkdir -p /rootfs/usr/bin
	cp target/$(uname -m)-unknown-linux-musl/release/bat /rootfs/usr/bin/
	install -Dm644 LICENSE-MIT /rootfs/usr/share/licenses/bat/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
