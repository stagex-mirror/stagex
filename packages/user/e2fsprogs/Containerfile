FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/user-util-linux . /
ADD fetch/e2fsprogs-${VERSION}.tar.gz .
WORKDIR /e2fsprogs-${VERSION}
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--enable-elf-shlibs \
		--enable-symlink-install \
		--disable-fsck \
		--disable-uuidd \
		--disable-libuuid \
		--disable-libblkid \
		--disable-nls
	make
	make DESTDIR=/rootfs install
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

FROM package AS runtime
COPY --from=stagex/core-libcxx . /
COPY --from=stagex/core-libcxxabi . /
COPY --from=stagex/core-libunwind . /
COPY --from=stagex/core-musl . /
COPY --from=stagex/core-ncurses . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/user-libcap-ng . /
COPY --from=stagex/user-util-linux . /
