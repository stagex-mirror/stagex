FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/core-bash . /
COPY --from=stagex/core-ncurses . /
COPY --from=stagex/core-xtrans . /
COPY --from=stagex/core-xorgproto . /
COPY --from=stagex/core-util-macros . /
COPY --from=stagex/core-xmlto . /
ADD fetch/libICE-${VERSION}.tar.xz .

WORKDIR /libICE-${VERSION}
ENV SOURCE_DATE_EPOCH=1
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--enable-ipv6 \
		--enable-docs \
		--with-xmlto \
		--without-fop
	make
	make install DESTDIR=/rootfs
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
