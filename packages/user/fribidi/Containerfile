FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-freetype . /
COPY --from=stagex/core-gettext . /
ADD fetch/fribidi-${VERSION}.tar.xz .
RUN mv fribidi-${VERSION}* fribidi
WORKDIR /fribidi
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/fribidi=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Ddocs=false \
		-Dtests=false \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
	install -Dm644 COPYING /rootfs/usr/share/licenses/fribidi/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
