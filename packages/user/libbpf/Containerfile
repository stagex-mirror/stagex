FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/core-make . /
COPY --from=stagex/user-elfutils . /
COPY --from=stagex/core-libzstd . /
COPY --from=stagex/core-linux-headers . /
ADD fetch/libbpf-v${VERSION}.tar.gz .
WORKDIR /libbpf-${VERSION}/src
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/libbpf-${VERSION}=."
RUN --network=none <<-EOF
	make -j$(nproc) \
		DESTDIR=/rootfs \
		PREFIX=/usr \
		LIBDIR=/usr/lib \
		BOOTSTRAP=1 \
		install
	install -Dm644 ../LICENSE /rootfs/usr/share/licenses/libbpf/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
