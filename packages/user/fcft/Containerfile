FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-fontconfig . /
COPY --from=stagex/user-freetype . /
COPY --from=stagex/core-libpng . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/user-pixman . /
COPY --from=stagex/user-tllist . /
COPY --from=stagex/user-utf8proc . /
ADD fetch/fcft-${VERSION}.tar.gz .
WORKDIR /fcft-${VERSION}
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/fcft-${VERSION}=."
RUN --network=none <<-EOF
	meson setup --prefix=/usr build
	meson compile -C build
	DESTDIR=/rootfs meson install -C build
	install -Dm644 LICENSE /rootfs/usr/share/licenses/fcft/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
