FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
ADD fetch/timew-${VERSION}.tar.gz /
WORKDIR /timew-${VERSION}
ENV SOURCE_DATE_EPOCH="1"
ENV CFLAGS="-march=x86-64"
ENV CXXFLAGS="-march=x86-64"
RUN --network=none <<-EOF
	set -eux
	cmake \
		-B build \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
	DESTDIR="/rootfs" cmake --install build
	install -Dm644 LICENSE /rootfs/usr/share/licenses/timewarrior/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /

FROM package AS package-run
COPY --from=stagex/core-attr . /
COPY --from=stagex/core-libcxx . /
COPY --from=stagex/core-libcxxabi . /
COPY --from=stagex/core-llvm . /

