FROM stagex/pallet-clang-cmake-busybox AS build
ARG VERSION
ADD fetch/asio-1-38-0.tar.gz /asio-src
RUN --network=none <<-EOF
	install -Dm644 /asio-src/asio-asio-1-38-0/include/asio.hpp /rootfs/usr/include/asio.hpp
	cp -r /asio-src/asio-asio-1-38-0/include/asio /rootfs/usr/include/asio
	install -Dm644 /asio-src/asio-asio-1-38-0/LICENSE_1_0.txt /rootfs/usr/share/licenses/asio/LICENSE_1_0.txt
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
