FROM stagex/pallet-clang-cmake-busybox AS build
COPY --from=stagex/core-make / /
ARG VERSION
ADD fetch/tree-sitter-markdown-${VERSION}.tar.gz .
WORKDIR /tree-sitter-markdown-${VERSION}/build
RUN --network=none <<-EOF
	clang -shared -fPIC -O2 -I../tree-sitter-markdown/src -o libtree-sitter-markdown.so ../tree-sitter-markdown/src/parser.c
	install -Dm755 libtree-sitter-markdown.so /rootfs/usr/lib/libtree-sitter-markdown.so
	install -Dm644 ../LICENSE /rootfs/usr/share/licenses/tree-sitter-markdown/LICENSE
	mkdir -p /rootfs/usr/include/tree_sitter
	install -Dm644 ../tree-sitter-markdown/src/tree_sitter/*.h /rootfs/usr/include/tree_sitter/ 2>/dev/null || true
EOF
COPY --chmod=644 <<-'EOF' /rootfs/usr/lib/pkgconfig/tree-sitter-markdown.pc
prefix=/usr
libdir=${prefix}/lib
includedir=${prefix}/include

Name: tree-sitter-markdown
Description: Markdown grammar for tree-sitter
Version: 0.5.3
Libs: -L${libdir} -ltree-sitter-markdown
Cflags: -I${includedir}
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
