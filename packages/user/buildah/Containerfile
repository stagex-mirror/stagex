FROM stagex/pallet-cgo AS build
ARG VERSION
ENV GOPATH=/cache/go
ENV GOCACHE=/cache/
ENV GOWORK=off
ENV GOPROXY=https://proxy.golang.org,direct
ENV GOSUMDB=sum.golang.org
ENV CGO_ENABLED=1
ENV GOHOSTOS=linux
ENV GOHOSTARCH=amd64
COPY --from=stagex/core-gpgme . /
COPY --from=stagex/user-libgpg-error . /
COPY --from=stagex/user-libassuan . /
ADD fetch/buildah-${VERSION}.tar.gz .
WORKDIR /buildah-${VERSION}
RUN go get ./...
RUN <<-EOF
	set -eu
	go build -trimpath -v -tags "exclude_graphdriver_btrfs" -ldflags "${GO_LDFLAGS} -X \"github.com/containers/buildah/pkg/buildversion.version=${VERSION}\"" ./cmd/buildah
	mkdir -p /rootfs/usr/bin/
	cp buildah /rootfs/usr/bin/
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
