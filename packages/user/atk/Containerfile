FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/user-glib . /
COPY --from=stagex/core-pcre2 . /
ADD fetch/atk-${VERSION}.tar.xz .
RUN mv atk-${VERSION}* atk
WORKDIR /atk
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/atk=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dintrospection=false \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
	install -Dm644 COPYING /rootfs/usr/share/licenses/atk/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
