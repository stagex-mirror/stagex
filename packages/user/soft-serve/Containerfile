FROM stagex/pallet-cgo AS build
ARG VERSION
ADD fetch/soft-serve-${VERSION}.tar.gz .
WORKDIR /soft-serve-${VERSION}
RUN go mod download
RUN --network=none <<-EOF
	go \
		build \
		-trimpath \
		-o soft-serve \
		-v \
		-ldflags="-s -w" \
		./cmd/soft
	mkdir -p /rootfs/usr/bin/
	install -vDm755 -t /rootfs/usr/bin soft-serve
	install -vDm644 -t /rootfs/usr/share/licenses/soft-serve LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs /
