FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/core-ncurses / /
ADD fetch/tig-${VERSION}.tar.gz .
WORKDIR /tig-tig-${VERSION}
RUN --network=none <<-EOF
	sh autogen.sh
	./configure --prefix=/usr --without-doc
	make
	make install DESTDIR="/rootfs"
	install -Dm644 COPYING /rootfs/usr/share/licenses/tig/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
