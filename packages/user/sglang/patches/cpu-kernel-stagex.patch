From: StageX <stagex@stagex.tools>
Subject: build the CPU kernel with StageX PyTorch and LLVM OpenMP

SGLang 0.5.16 pins the unreleased-next PyTorch 2.12 line while vLLM 0.26.0
pins 2.11.0. Build the CPU extension against the source-built StageX 2.11.0
package so both inference engines share one libtorch ABI. Replace Debian
multiarch lookup assumptions with StageX's /usr/lib and link the OpenMP CMake
target explicitly so the musl build records its LLVM libomp dependency. Remove
the Intel OpenMP Python requirement because StageX composes LLVM libomp as a
system package, and avoid host-specific `-march=native` output on non-x86.
libc++ does not make `std::sqrt` constexpr in the C++17 mode used by this
extension, so keep the derived scale immutable without requiring constant
evaluation.

--- a/python/pyproject_cpu.toml
+++ b/python/pyproject_cpu.toml
@@ -27,7 +27,6 @@
   "einops",
   "fastapi",
   "gguf",
-  "intel-openmp; platform_machine == 'x86_64'",
   "interegular",
   "IPython",
   "llguidance>=1.7.6,<2.0.0",
@@ -60,7 +60,7 @@
   "tabulate",
   "tiktoken",
   "timm==1.0.16",
-  "torch==2.12.0",
+  "torch==2.11.0+cpu",
   "torchao==0.17.0",
   "torchaudio==2.11.0",
   "torchvision==0.27.0",
--- a/sgl-kernel/pyproject_cpu.toml
+++ b/sgl-kernel/pyproject_cpu.toml
@@ -1,7 +1,7 @@
 [build-system]
 requires = [
   "scikit-build-core>=0.10",
-  "torch==2.12.0",
+  "torch==2.11.0+cpu",
   "wheel",
 ]
 build-backend = "scikit_build_core.build"
--- a/sgl-kernel/csrc/cpu/CMakeLists.txt
+++ b/sgl-kernel/csrc/cpu/CMakeLists.txt
@@ -17,6 +17,7 @@
 message(STATUS ${TORCH_PY_PREFIX})
