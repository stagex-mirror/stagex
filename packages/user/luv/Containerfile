FROM stagex/pallet-clang-cmake-busybox AS build
COPY --from=stagex/core-make / /
COPY --from=stagex/user-libuv . /
COPY --from=stagex/core-luajit . /
ARG VERSION
ADD fetch/luv.tar.gz .
WORKDIR /luv-${VERSION}
RUN --network=none <<-EOF
	mkdir -p build && cd build
	cmake \
		-B . \
		-G Ninja \
		-Wno-dev \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DWITH_SHARED_LIBUV=ON \
		-DWITH_LUA_ENGINE=LuaJIT \
		-DLUA_BUILD_TYPE=System \
		-DBUILD_MODULE=ON \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_C_FLAGS="-I/deps/lua-compat-5.3/c-api" \
		..
	cmake --build .
	DESTDIR="/rootfs" cmake --install .
	install -Dm644 ../LICENSE.txt /rootfs/usr/share/licenses/luv/LICENSE.txt
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
