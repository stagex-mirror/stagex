FROM stagex/pallet-clang-meson-busybox AS build
COPY --from=stagex/user-wayland . /
COPY --from=stagex/core-libxml2 . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/user-wayland-protocols . /
COPY --from=stagex/user-libdrm . /
COPY --from=stagex/user-xkbcommon . /
COPY --from=stagex/user-pixman . /
COPY --from=stagex/user-systemd . /
COPY --from=stagex/user-seatd . /
COPY --from=stagex/user-libdisplay-info . /
COPY --from=stagex/user-hwdata . /
ARG VERSION
ADD fetch/wlroots-${VERSION}.tar.gz .
WORKDIR /wlroots-${VERSION}
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/wlroots-${VERSION}=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dexamples=false \
		-Dbackends=drm \
		-Dsession=enabled \
		-Dxwayland=disabled \
		-Drenderers= \
		-Dcolor-management=disabled \
		-Dlibliftoff=disabled \
		. build
	meson compile -C build
	DESTDIR=/rootfs meson install -C build
	install -Dm644 LICENSE /rootfs/usr/share/licenses/wlroots/LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
