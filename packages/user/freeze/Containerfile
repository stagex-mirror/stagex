FROM stagex/pallet-cgo AS build
ARG VERSION
ADD fetch/freeze-${VERSION}.tar.gz .
WORKDIR /freeze-${VERSION}
RUN go mod download
RUN --network=none <<-EOF
	go \
		build \
		-trimpath \
		-o freeze \
		-v \
		-ldflags="-s -w" \
		.
	mkdir -p /rootfs/usr/bin/
	install -vDm755 -t /rootfs/usr/bin freeze
	install -vDm644 -t /rootfs/usr/share/licenses/freeze LICENSE
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs /
