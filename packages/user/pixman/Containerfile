FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
ADD fetch/pixman-${VERSION}.tar.xz .
RUN mv pixman-${VERSION}* pixman
WORKDIR /pixman
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/pixman=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dtests=disabled \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
	install -Dm644 COPYING /rootfs/usr/share/licenses/pixman/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
