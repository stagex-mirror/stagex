FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/core-perl . /
COPY --from=stagex/core-pcre2 . /
COPY --from=stagex/user-freetype . /
COPY --from=stagex/user-fontconfig . /
COPY --from=stagex/user-harfbuzz . /
COPY --from=stagex/user-glib . /
COPY --from=stagex/user-fribidi . /
COPY --from=stagex/core-libpng . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-expat . /
COPY --from=stagex/user-cairo . /
COPY --from=stagex/user-pixman . /
ADD fetch/pango-${VERSION}.tar.xz .
RUN mv pango-${VERSION}* pango
WORKDIR /pango
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/pango=. -D_DEFAULT_SOURCE"
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dlibthai=disabled \
		-Dxft=disabled \
		-Dbuild-testsuite=false \
		-Dintrospection=disabled \
		. output
	meson compile -C output -j1
	DESTDIR=/rootfs meson install -C output
	install -Dm644 COPYING /rootfs/usr/share/licenses/pango/COPYING
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
