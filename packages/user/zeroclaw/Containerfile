FROM stagex/pallet-rust AS build
ARG VERSION
ADD fetch/zeroclaw-v${VERSION}.tar.gz .
WORKDIR /zeroclaw-${VERSION}
RUN cargo fetch --locked
ENV RUSTFLAGS="-C codegen-units=1 -C target-feature=+crt-static"
RUN --network=none <<-EOF
	cargo build \
		--frozen \
		--release \
		--target "$(uname -m)-unknown-linux-musl" \
		--locked
	install -vDm755 -t /rootfs/usr/bin "target/$(uname -m)-unknown-linux-musl/release/zeroclaw"
	install -vDm644 -t /rootfs/usr/share/licenses/zeroclaw LICENSE-APACHE LICENSE-MIT
EOF

FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
