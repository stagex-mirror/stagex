FROM stagex/pallet-clang-gnu-busybox AS build
ARG VERSION
COPY --from=stagex/user-gpg / /
ADD fetch/password-store-${VERSION}.tar.xz .
WORKDIR /password-store-${VERSION}
RUN make PREFIX=/usr bindir=/usr/bin mandir=/usr/share/man install DESTDIR="/rootfs"
RUN install -Dm644 -t /rootfs/usr/share/licenses/pass/ COPYING
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
