FROM stagex/pallet-clang-meson-busybox AS build
ARG VERSION
COPY --from=stagex/core-zlib . /
COPY --from=stagex/core-brotli . /
COPY --from=stagex/core-libpng . /
ADD fetch/freetype-${VERSION}.tar.gz .
RUN mv freetype-${VERSION}* freetype
WORKDIR /freetype
ENV SOURCE_DATE_EPOCH=1
ENV CFLAGS="-O2 -fPIC -ffile-prefix-map=/freetype=."
RUN --network=none <<-EOF
	meson setup \
		--prefix=/usr \
		-Dlibdir=lib \
		-Dharfbuzz=disabled \
		-Dtests=disabled \
		. output
	meson compile -C output
	DESTDIR=/rootfs meson install -C output
	install -Dm644 LICENSE.TXT /rootfs/usr/share/licenses/freetype/LICENSE.TXT
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
