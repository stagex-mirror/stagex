FROM stagex/pallet-python AS build
COPY --from=stagex/core-meson . /
COPY --from=stagex/user-py-pyproject-metadata . /
COPY --from=stagex/core-samurai . /
ARG VERSION
ADD fetch/py-meson-python-${VERSION}.tar.gz .
WORKDIR /meson_python-${VERSION}
RUN --network=none <<-EOF
	set -eu
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
	python -m installer -d /rootfs .dist/*.whl
	find /rootfs | grep -E "(/__pycache__$|\.pyc$|\.pyo$)" | xargs rm -rf
EOF
FROM stagex/core-filesystem AS package
COPY --from=build /rootfs/ /
