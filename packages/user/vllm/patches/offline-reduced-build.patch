+setuptools==80.9.0 # shared with the source-built StageX PyTorch package
@@ -21,2 +21,2 @@
-# Intel Extension for PyTorch, only for x86_64 CPUs
-intel-openmp==2024.2.1; platform_machine == "x86_64"
+# StageX composes its separately source-built LLVM OpenMP runtime into the OCI
+# artifact instead of representing the system runtime as a Python distribution.
--- a/cmake/cpu_extension.cmake	2026-07-27 08:57:50.000000000 +0800
+++ b/cmake/cpu_extension.cmake	2026-08-06 10:33:08.560147391 +0800
@@ -54,2 +54,7 @@
-        # Fall back to system / toolchain libgomp
-        find_library(OPEN_MP NAMES gomp REQUIRED)
+        # Fall back to the system/toolchain runtime. StageX uses Clang's
+        # separately source-built libomp; GNU builds retain libgomp support.
+        if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+            find_library(OPEN_MP NAMES omp REQUIRED)
+        else()
+            find_library(OPEN_MP NAMES gomp REQUIRED)
+        endif()
@@ -125,3 +130,4 @@
-    if (NOT (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND
-            CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 12.3))
-        message(FATAL_ERROR "X86 backend requires gcc/g++ >= 12.3")
+    if (NOT ((CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND
+              CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 12.3) OR
+             CMAKE_CXX_COMPILER_ID MATCHES "Clang"))
+        message(FATAL_ERROR "X86 backend requires gcc/g++ >= 12.3 or Clang")
