FROM --platform=linux/386 stagex/bootstrap-stage1 AS xbuild
ARG TARGETARCH
ARG GCC_SOURCE
ARG GCC_VERSION
ARG GMP_VERSION
ARG MPFR_VERSION
ARG MPC_VERSION
ARG ISL_VERSION
ARG LINUX_SOURCE
ARG LINUX_VERSION
ARG MUSL_SOURCE
ARG MUSL_VERSION
ARG BINUTILS_SOURCE
ARG BINUTILS_VERSION
ARG BUSYBOX_SOURCE
ARG BUSYBOX_VERSION
ARG MAKE_SOURCE
ARG MAKE_VERSION
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV SOURCE_DATE_EPOCH=1
ENV KCONFIG_NOTIMESTAMP=1
ENV BASE_PATH=/usr/sbin:/usr/bin:/sbin:/bin
ENV PATH=${BASE_PATH}
WORKDIR /
COPY --from=fetch . .

COPY --chmod=755 <<-'EOF' /env.sh
	case "${TARGETARCH}" in
		amd64) export TARGET_ARCH=x86_64 ;;
		arm64) export TARGET_ARCH=aarch64 ;;
		riscv64) export TARGET_ARCH=riscv64 ;;
		*) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;;
	esac
	export BUILD=i386-unknown-linux-musl
	export TARGET=${TARGET_ARCH}-linux-musl
	export SYSROOT=/usr/${TARGET}
	export PATH=${SYSROOT}/bin:${BASE_PATH}
EOF

# gmp/mpfr/mpc/isl renamed into gcc source tree for gcc's in-tree detection.
RUN --network=none <<-EOF
	set -eux
	tar -xf ${LINUX_SOURCE}
	tar -xzf ${MUSL_SOURCE}
	tar -xf ${BINUTILS_SOURCE}
	tar -xf ${GCC_SOURCE}
	tar -xjf ${BUSYBOX_SOURCE}
	tar -xzf ${MAKE_SOURCE}
	tar -xf gmp-${GMP_VERSION}.tar.bz2
	tar -xf mpfr-${MPFR_VERSION}.tar.bz2
	tar -xf mpc-${MPC_VERSION}.tar.gz
	tar -xf isl-${ISL_VERSION}.tar.bz2
	mv gmp-${GMP_VERSION}   gcc-${GCC_VERSION}/gmp
	mv mpfr-${MPFR_VERSION} gcc-${GCC_VERSION}/mpfr
	mv mpc-${MPC_VERSION}   gcc-${GCC_VERSION}/mpc
	mv isl-${ISL_VERSION}   gcc-${GCC_VERSION}/isl
EOF

# Phase 1: i386-hosted cross-toolchain in ${SYSROOT}, discarded from the
# final image. Phase 2 (below) uses it to assemble the native rootfs.
RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p ${SYSROOT}
	cd ${SYSROOT}
	mkdir -pv bin lib lib32 include usr "${TARGET}/bin"
	ln -sfv ../bin ../lib ../lib32 ../include usr
	cd ${SYSROOT}/${TARGET}
	ln -sfv ../lib lib
	ln -sfv ../lib32 lib32
	ln -sfv ../include include
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cd /musl-${MUSL_VERSION}
	make clean distclean
	make \
		-j$(nproc) \
		ARCH="${TARGET_ARCH}" \
		prefix="" \
		DESTDIR="${SYSROOT}" \
		install-headers
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /build-xbinutils
	cd /build-xbinutils
	/binutils-${BINUTILS_VERSION}/configure \
		--target="${TARGET}" \
		--prefix="" \
		--exec-prefix="" \
		--sbindir=/bin \
		--libexecdir=/lib \
		--datarootdir=/_tmp \
		--with-sysroot=/ \
		--with-build-sysroot="${SYSROOT}" \
		--disable-nls \
		--disable-multilib \
		--disable-plugins \
		--disable-gprofng \
		--enable-64-bit-bfd \
		--enable-ld=default \
		--enable-install-libiberty \
		--enable-deterministic-archives
	make \
		-j$(nproc) \
		all-binutils \
		all-gas \
		all-ld
	make \
		-j$(nproc) \
		DESTDIR="${SYSROOT}" \
		install-strip-binutils \
		install-strip-gas \
		install-strip-ld
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /build-xgcc
	cd /build-xgcc
	/gcc-${GCC_VERSION}/configure \
		--prefix="" \
		--exec-prefix="" \
		--sbindir=/bin \
		--libexecdir=/lib \
		--datarootdir=/_tmp \
		--target=${TARGET} \
		--disable-multilib \
		--disable-bootstrap \
		--disable-assembly \
		--disable-libmudflap \
		--disable-libsanitizer \
		--disable-gnu-indirect-function \
		--disable-libmpx \
		--disable-werror \
		--enable-languages=c,c++ \
		--enable-tls \
		--enable-initfini-array \
		--enable-libstdcxx-time=rt \
		--enable-deterministic-archives \
		--with-build-sysroot=${SYSROOT} \
		--with-sysroot=/
	make \
		-j$(nproc) \
		all-gcc
	make \
		-j$(nproc) \
		enable_shared=no \
		all-target-libgcc
	make \
		-j$(nproc) \
		DESTDIR="${SYSROOT}" \
		install-strip-gcc \
		install-strip-target-libgcc
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /build-xmusl
	cd /build-xmusl
	ARCH="${TARGET_ARCH}" \
	CC="${TARGET}-gcc" \
	CROSS_COMPILE="${TARGET}-" \
	LIBCC="${SYSROOT}/lib/gcc/${TARGET}/${GCC_VERSION}/libgcc.a" \
	/musl-${MUSL_VERSION}/configure \
		--host="${TARGET}" \
		--prefix="" \
		--disable-wrapper
	make \
		-j$(nproc) \
		AR="${TARGET}-ar" \
		RANLIB="${TARGET}-ranlib"
	make \
		-j$(nproc) \
		AR="${TARGET}-ar" \
		RANLIB="${TARGET}-ranlib" \
		DESTDIR="${SYSROOT}" \
		install-libs
	rm -f "${SYSROOT}"/lib/ld-musl-${TARGET_ARCH}.so.1
	cp -af \
		"${SYSROOT}/usr/lib/libc.so" \
		"${SYSROOT}/lib/ld-musl-${TARGET_ARCH}.so.1"
EOF

# Finish libgcc/libstdc++ now that musl libs exist in the sysroot.
RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cd /build-xgcc
	make \
		-j $(nproc) \
		-C "${TARGET}/libgcc" \
		distclean
	make \
		-j$(nproc) \
		enable_shared=yes \
		all-target-libgcc \
		all-target-libstdc++-v3
	make \
		-j$(nproc) \
		DESTDIR="${SYSROOT}" \
		install-strip-target-libgcc \
		install-strip-target-libstdc++-v3
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cp -r /linux-${LINUX_VERSION} /linux-xbuild
	cd /linux-xbuild
	LINUX_ARCH=$(echo "${TARGET_ARCH}" \
		| sed -e 's/aarch64/arm64/' -e 's/riscv64/riscv/')
	make -j$(nproc) ARCH="${LINUX_ARCH}" headers
	find usr/include ! -name '*.h' -type f -delete
	cp -Rv usr/include/* "${SYSROOT}/include/"
	rm -rf "${SYSROOT}/_tmp" /linux-xbuild
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /usr/bin
	for bin_path in $(find ${SYSROOT}/bin -name "${TARGET}-*"); do
		bin_name=$(basename "$bin_path")
		ln -sf "${SYSROOT}/bin/${bin_name}" "/usr/bin/${bin_name}"
	done
EOF

# Phase 2: native target-arch rootfs in /rootfs. Ships as bootstrap-stage2.
RUN --network=none <<-EOF
	set -eux
	install -vdm0755 /rootfs/etc
	install -vdm0755 /rootfs/usr
	install -vdm0755 /rootfs/usr/bin
	install -vdm0755 /rootfs/usr/lib
	install -vdm0755 /rootfs/usr/include
	install -vdm0755 /rootfs/usr/share
	install -vdm1777 /rootfs/tmp
	install -vdm0750 /rootfs/root
	ln -sT usr/lib /rootfs/lib64
	ln -sT lib /rootfs/usr/lib64
	ln -sT usr/lib /rootfs/lib
	ln -sT usr/bin /rootfs/bin
	ln -sT usr/sbin /rootfs/sbin
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cp -r /linux-${LINUX_VERSION} /linux-native
	cd /linux-native
	LINUX_ARCH=$(echo "${TARGET_ARCH}" \
		| sed -e 's/aarch64/arm64/' -e 's/riscv64/riscv/')
	make -j$(nproc) ARCH="${LINUX_ARCH}" headers
	find usr/include ! -name '*.h' -type f -delete
	cp -Rv usr/include/* /rootfs/usr/include/
	rm -rf /linux-native
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cd /musl-${MUSL_VERSION}
	make clean distclean
	./configure \
		--prefix=/usr \
		--host=${TARGET}
	make DESTDIR=/rootfs install
	mv -f /rootfs/usr/lib/libc.so /rootfs/usr/lib/ld-musl-${TARGET_ARCH}.so.1
	ln -sf ld-musl-${TARGET_ARCH}.so.1 /rootfs/usr/lib/libc.musl-${TARGET_ARCH}.so.1
	ln -sf /usr/lib/ld-musl-${TARGET_ARCH}.so.1 /rootfs/usr/lib/libc.so
	ln -sf /usr/lib/ld-musl-${TARGET_ARCH}.so.1 /rootfs/usr/bin/ldd
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /build-nbinutils
	cd /build-nbinutils
	/binutils-${BINUTILS_VERSION}/configure \
		--build=${BUILD} \
		--host=${TARGET} \
		--prefix=/usr \
		--bindir=/usr/bin \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--sysconfdir=/etc \
		--disable-nls \
		--disable-multilib \
		--disable-plugins \
		--disable-gprofng \
		--enable-64-bit-bfd \
		--enable-ld=default \
		--enable-install-libiberty \
		--enable-deterministic-archives
	make
	make DESTDIR=/rootfs install
EOF

# Downstream Makefiles assume `cc`; symlink it alongside gcc below.
RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /build-ngcc
	cd /build-ngcc
	/gcc-${GCC_VERSION}/configure \
		--build=${BUILD} \
		--host=${TARGET} \
		--target=${TARGET} \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--libdir=/usr/lib \
		--disable-cet \
		--disable-fixed-point \
		--disable-libstdcxx-pch \
		--disable-multilib \
		--disable-libsanitizer \
		--disable-nls \
		--disable-werror \
		--enable-__cxa_atexit \
		--enable-default-pie \
		--enable-default-ssp \
		--enable-languages=c,c++ \
		--enable-link-serialization=2 \
		--enable-linker-build-id
	make
	make DESTDIR=/rootfs install
	ln -sf gcc /rootfs/usr/bin/cc
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cd /make-${MAKE_VERSION}
	./configure \
		--build=${BUILD} \
		--host=${TARGET} \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--disable-nls
	make
	make DESTDIR=/rootfs install
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cd /busybox-${BUSYBOX_VERSION}
	make CROSS_COMPILE=${TARGET}- defconfig
	echo "CONFIG_STATIC=y" >> .config
	make CROSS_COMPILE=${TARGET}-
	cp busybox /rootfs/usr/bin/busybox
EOF

# Surface the xbuild sysroot at a fixed path so the sysroot subpackage can
# COPY it without needing ${TARGET} expansion in a FROM stage.
RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /sysroot/usr
	cp -al ${SYSROOT} /sysroot/usr/${TARGET}
EOF

FROM scratch AS package-stage2
COPY --from=xbuild /rootfs/ /
RUN ["/usr/bin/busybox", "--install", "-s", "/usr/bin"]

FROM scratch AS package-stage2-sysroot
COPY --from=xbuild /sysroot/ /
