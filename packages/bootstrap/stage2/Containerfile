FROM --platform=linux/386 stagex/bootstrap-stage1 AS xbuild
ARG TARGETARCH
ARG GCC_SOURCE
ARG GCC_VERSION
ARG GMP_VERSION
ARG MPFR_VERSION
ARG MPC_VERSION
ARG ISL_VERSION
ARG LINUX_SOURCE
ARG LINUX_VERSION
ARG MUSL_SOURCE
ARG MUSL_VERSION
ARG BINUTILS_SOURCE
ARG BINUTILS_VERSION
ARG BUSYBOX_SOURCE
ARG BUSYBOX_VERSION
ARG MAKE_SOURCE
ARG MAKE_VERSION
ENV TZ=UTC
ENV LANG=C.UTF-8
ENV SOURCE_DATE_EPOCH=1
ENV KCONFIG_NOTIMESTAMP=1
ENV BASE_PATH=/usr/sbin:/usr/bin:/sbin:/bin
ENV PATH=${BASE_PATH}
WORKDIR /
COPY --from=fetch . .

COPY --chmod=755 <<-'EOF' /env.sh
	case "${TARGETARCH}" in
		amd64) export TARGET_ARCH=x86_64 ;;
		arm64) export TARGET_ARCH=aarch64 ;;
		riscv64) export TARGET_ARCH=riscv64 ;;
		*) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;;
	esac
	export BUILD=i386-unknown-linux-musl
	export TARGET=${TARGET_ARCH}-linux-musl
	export SYSROOT=/usr/${TARGET}
	export PATH=${SYSROOT}/bin:${BASE_PATH}
EOF

# gmp/mpfr/mpc/isl renamed into gcc source tree for gcc's in-tree detection.
RUN --network=none <<-EOF
	set -eux
	tar -xf ${LINUX_SOURCE}
	tar -xzf ${MUSL_SOURCE}
	tar -xf ${BINUTILS_SOURCE}
	tar -xf ${GCC_SOURCE}
	tar -xjf ${BUSYBOX_SOURCE}
	tar -xzf ${MAKE_SOURCE}
	tar -xf gmp-${GMP_VERSION}.tar.bz2
	tar -xf mpfr-${MPFR_VERSION}.tar.bz2
	tar -xf mpc-${MPC_VERSION}.tar.gz
	tar -xf isl-${ISL_VERSION}.tar.bz2
	mv gmp-${GMP_VERSION}   gcc-${GCC_VERSION}/gmp
	mv mpfr-${MPFR_VERSION} gcc-${GCC_VERSION}/mpfr
	mv mpc-${MPC_VERSION}   gcc-${GCC_VERSION}/mpc
	mv isl-${ISL_VERSION}   gcc-${GCC_VERSION}/isl
	# gcc 13 emits ".insn 0xc2202573" for RISC-V vlenb read; that syntax needs
	# binutils 2.36+. Rewrite to ".4byte" which every binutils accepts.
	sed -i 's|\.insn 0xc2202573|.4byte 0xc2202573|' \
		gcc-${GCC_VERSION}/libgcc/config/riscv/value-unwind.h
EOF

# Phase 1: build cross-toolchains for all supported target arches on i386.
# Each sysroot lives at /usr/${T}/ and is arch-neutral in the sense that
# it can be consumed by any host running a clang cross-compiler.
COPY --chmod=755 <<-'EOF' /build-cross-sysroot.sh
	set -eux
	TARGET_ARCH=$1
	TARGET=${TARGET_ARCH}-linux-musl
	SYSROOT=/usr/${TARGET}
	export PATH=${SYSROOT}/bin:${BASE_PATH}

	mkdir -p ${SYSROOT}
	cd ${SYSROOT}
	mkdir -pv bin lib lib32 include usr "${TARGET}/bin"
	ln -sfv ../bin ../lib ../lib32 ../include usr
	cd ${SYSROOT}/${TARGET}
	ln -sfv ../lib lib
	ln -sfv ../lib32 lib32
	ln -sfv ../include include

	cd /musl-${MUSL_VERSION}
	make clean distclean
	make -j$(nproc) ARCH="${TARGET_ARCH}" prefix="" \
		DESTDIR="${SYSROOT}" install-headers

	mkdir -p /build-${TARGET_ARCH}-binutils
	cd /build-${TARGET_ARCH}-binutils
	/binutils-${BINUTILS_VERSION}/configure \
		--target="${TARGET}" \
		--prefix="" --exec-prefix="" \
		--sbindir=/bin --libexecdir=/lib --datarootdir=/_tmp \
		--with-sysroot=/ --with-build-sysroot="${SYSROOT}" \
		--disable-nls --disable-multilib --disable-plugins \
		--disable-gprofng --enable-64-bit-bfd --enable-ld=default \
		--enable-install-libiberty --enable-deterministic-archives
	make -j$(nproc) all-binutils all-gas all-ld
	make -j$(nproc) DESTDIR="${SYSROOT}" \
		install-strip-binutils install-strip-gas install-strip-ld

	# RISC-V needs an explicit ISA/ABI. --with-isa-spec=2.2 keeps gcc from
	# emitting zicsr/zifencei extensions that binutils 2.35's assembler
	# doesn't recognize (added in binutils 2.37).
	case "$TARGET_ARCH" in
		riscv64) EXTRA_GCC_CONF="--with-arch=rv64gc --with-abi=lp64d --with-isa-spec=2.2" ;;
		*)       EXTRA_GCC_CONF="" ;;
	esac
	mkdir -p /build-${TARGET_ARCH}-gcc
	cd /build-${TARGET_ARCH}-gcc
	/gcc-${GCC_VERSION}/configure \
		--prefix="" --exec-prefix="" \
		--sbindir=/bin --libexecdir=/lib --datarootdir=/_tmp \
		--target=${TARGET} \
		--disable-multilib --disable-bootstrap --disable-assembly \
		--disable-libmudflap --disable-libsanitizer \
		--disable-gnu-indirect-function --disable-libmpx --disable-werror \
		--enable-languages=c,c++ --enable-tls --enable-initfini-array \
		--enable-libstdcxx-time=rt --enable-deterministic-archives \
		--with-build-sysroot=${SYSROOT} --with-sysroot=/ \
		${EXTRA_GCC_CONF}
	make -j$(nproc) all-gcc
	make -j$(nproc) enable_shared=no all-target-libgcc
	make -j$(nproc) DESTDIR="${SYSROOT}" \
		install-strip-gcc install-strip-target-libgcc

	mkdir -p /build-${TARGET_ARCH}-musl
	cd /build-${TARGET_ARCH}-musl
	ARCH="${TARGET_ARCH}" \
	CC="${TARGET}-gcc" \
	CROSS_COMPILE="${TARGET}-" \
	LIBCC="${SYSROOT}/lib/gcc/${TARGET}/${GCC_VERSION}/libgcc.a" \
	/musl-${MUSL_VERSION}/configure \
		--host="${TARGET}" --prefix="" --disable-wrapper
	make -j$(nproc) AR="${TARGET}-ar" RANLIB="${TARGET}-ranlib"
	make -j$(nproc) AR="${TARGET}-ar" RANLIB="${TARGET}-ranlib" \
		DESTDIR="${SYSROOT}" install-libs
	rm -f "${SYSROOT}"/lib/ld-musl-${TARGET_ARCH}.so.1
	cp -af "${SYSROOT}/usr/lib/libc.so" \
		"${SYSROOT}/lib/ld-musl-${TARGET_ARCH}.so.1"

	# libgcc/libstdc++ finish now that musl libs exist in the sysroot.
	cd /build-${TARGET_ARCH}-gcc
	make -j$(nproc) -C "${TARGET}/libgcc" distclean
	make -j$(nproc) enable_shared=yes \
		all-target-libgcc all-target-libstdc++-v3
	make -j$(nproc) DESTDIR="${SYSROOT}" \
		install-strip-target-libgcc install-strip-target-libstdc++-v3

	cp -r /linux-${LINUX_VERSION} /linux-xbuild-${TARGET_ARCH}
	cd /linux-xbuild-${TARGET_ARCH}
	LINUX_ARCH=$(echo "${TARGET_ARCH}" \
		| sed -e 's/aarch64/arm64/' -e 's/riscv64/riscv/')
	make -j$(nproc) ARCH="${LINUX_ARCH}" headers
	find usr/include ! -name '*.h' -type f -delete
	cp -Rv usr/include/* "${SYSROOT}/include/"
	rm -rf "${SYSROOT}/_tmp" /linux-xbuild-${TARGET_ARCH}

	# Drop build dirs to keep the layer small.
	rm -rf /build-${TARGET_ARCH}-binutils /build-${TARGET_ARCH}-gcc /build-${TARGET_ARCH}-musl
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	for arch in x86_64 aarch64 riscv64; do
		sh /build-cross-sysroot.sh "$arch"
	done
EOF

# Expose TARGETARCH's cross-toolchain on PATH so phase 2 can use it.
RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /usr/bin
	for bin_path in $(find ${SYSROOT}/bin -name "${TARGET}-*"); do
		bin_name=$(basename "$bin_path")
		ln -sf "${SYSROOT}/bin/${bin_name}" "/usr/bin/${bin_name}"
	done
EOF

# Phase 2: native target-arch rootfs in /rootfs. Ships as bootstrap-stage2.
RUN --network=none <<-EOF
	set -eux
	install -vdm0755 /rootfs/etc
	install -vdm0755 /rootfs/usr
	install -vdm0755 /rootfs/usr/bin
	install -vdm0755 /rootfs/usr/lib
	install -vdm0755 /rootfs/usr/include
	install -vdm0755 /rootfs/usr/share
	install -vdm1777 /rootfs/tmp
	install -vdm0750 /rootfs/root
	ln -sT usr/lib /rootfs/lib64
	ln -sT lib /rootfs/usr/lib64
	ln -sT usr/lib /rootfs/lib
	ln -sT usr/bin /rootfs/bin
	ln -sT usr/sbin /rootfs/sbin
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cp -r /linux-${LINUX_VERSION} /linux-native
	cd /linux-native
	LINUX_ARCH=$(echo "${TARGET_ARCH}" \
		| sed -e 's/aarch64/arm64/' -e 's/riscv64/riscv/')
	make -j$(nproc) ARCH="${LINUX_ARCH}" headers
	find usr/include ! -name '*.h' -type f -delete
	cp -Rv usr/include/* /rootfs/usr/include/
	rm -rf /linux-native
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cd /musl-${MUSL_VERSION}
	make clean distclean
	./configure \
		--prefix=/usr \
		--host=${TARGET}
	make DESTDIR=/rootfs install
	mv -f /rootfs/usr/lib/libc.so /rootfs/usr/lib/ld-musl-${TARGET_ARCH}.so.1
	ln -sf ld-musl-${TARGET_ARCH}.so.1 /rootfs/usr/lib/libc.musl-${TARGET_ARCH}.so.1
	ln -sf /usr/lib/ld-musl-${TARGET_ARCH}.so.1 /rootfs/usr/lib/libc.so
	ln -sf /usr/lib/ld-musl-${TARGET_ARCH}.so.1 /rootfs/usr/bin/ldd
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /build-nbinutils
	cd /build-nbinutils
	/binutils-${BINUTILS_VERSION}/configure \
		--build=${BUILD} \
		--host=${TARGET} \
		--prefix=/usr \
		--bindir=/usr/bin \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--sysconfdir=/etc \
		--disable-nls \
		--disable-multilib \
		--disable-plugins \
		--disable-gprofng \
		--enable-64-bit-bfd \
		--enable-ld=default \
		--enable-install-libiberty \
		--enable-deterministic-archives
	make
	make DESTDIR=/rootfs install
EOF

# Downstream Makefiles assume `cc`; symlink it alongside gcc below.
RUN --network=none <<-EOF
	set -eux
	. /env.sh
	mkdir -p /build-ngcc
	cd /build-ngcc
	/gcc-${GCC_VERSION}/configure \
		--build=${BUILD} \
		--host=${TARGET} \
		--target=${TARGET} \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--libdir=/usr/lib \
		--disable-cet \
		--disable-fixed-point \
		--disable-libstdcxx-pch \
		--disable-multilib \
		--disable-libsanitizer \
		--disable-nls \
		--disable-werror \
		--enable-__cxa_atexit \
		--enable-default-pie \
		--enable-default-ssp \
		--enable-languages=c,c++ \
		--enable-link-serialization=2 \
		--enable-linker-build-id
	make
	make DESTDIR=/rootfs install
	ln -sf gcc /rootfs/usr/bin/cc
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cd /make-${MAKE_VERSION}
	./configure \
		--build=${BUILD} \
		--host=${TARGET} \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--disable-nls
	make
	make DESTDIR=/rootfs install
EOF

# Build a native i386 busybox in xbuild to enumerate applet symlinks — the
# target-arch busybox we cross-compile below cannot be exec'd during cross
# builds without qemu-user binfmt on the host. Keep the file named `busybox`
# so argv[0] matches an applet name (busybox uses argv[0] to dispatch).
RUN --network=none <<-EOF
	set -eux
	cd /busybox-${BUSYBOX_VERSION}
	make clean
	make defconfig
	echo "CONFIG_STATIC=y" >> .config
	make
	mkdir -p /host-tools
	cp busybox /host-tools/busybox
EOF

RUN --network=none <<-EOF
	set -eux
	. /env.sh
	cd /busybox-${BUSYBOX_VERSION}
	make clean distclean
	make CROSS_COMPILE=${TARGET}- defconfig
	echo "CONFIG_STATIC=y" >> .config
	make CROSS_COMPILE=${TARGET}-
	cp busybox /rootfs/usr/bin/busybox
	# Applet list comes from defconfig, identical across target arches; use
	# the host-native busybox as the oracle so no target-arch exec is needed.
	for a in $(/host-tools/busybox --list); do
		ln -sf busybox /rootfs/usr/bin/$a
	done
EOF

# Pack all three target sysroots into /sysroot for the sysroot subpackage.
# Same content ships on every platform tag so any host can cross-build any
# target without rebuilding stage2.
RUN --network=none <<-EOF
	set -eux
	mkdir -p /sysroot/usr
	for T in x86_64-linux-musl aarch64-linux-musl riscv64-linux-musl; do
		cp -al /usr/${T} /sysroot/usr/${T}
	done
EOF

FROM scratch AS package-stage2
COPY --from=xbuild /rootfs/ /

FROM scratch AS package-stage2-sysroot
COPY --from=xbuild /sysroot/ /
