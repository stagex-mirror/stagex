FROM stagex/bootstrap-stage2 AS base
ARG TARGETARCH
WORKDIR /rootfs/
SHELL ["/bin/sh","-l","-c"]
ENV SOURCE_DATE_EPOCH=1
COPY <<-'EOF' /etc/profile
	set -eux
	case "${TARGETARCH}" in
		amd64) ARCH=x86_64 ;;
		arm64) ARCH=aarch64 ;;
		riscv64) ARCH=riscv64 ;;
		*) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;;
	esac
	export ARCH
	export PATH=/usr/sbin:/usr/bin:/sbin:/bin
	export MAKEFLAGS="-j$(nproc)"
	export TARGET=${ARCH}-linux-musl
EOF
WORKDIR /rootfs
RUN --network=none <<-EOF
	install -vdm0750 root
	install -vdm0755 etc
	install -vdm0755 usr
	install -vdm0755 usr/bin
	install -vdm0755 usr/lib
	install -vdm0755 usr/include
	install -vdm1777 tmp
	install -vdm1777 var/tmp
	install -vdm1777 var/spool/mail
	install -vd -o 1000 -g 1000 -m0755 home/user
	ln -sT usr/lib lib64
	ln -sT lib usr/lib64
	ln -sT usr/lib lib
	ln -sT usr/bin bin
	ln -sT usr/sbin sbin
	ln -sT ../run var/run
	ln -sT ../run/lock var/lock
	install -vDm755 -t /rootfs/etc /etc/profile
	find /rootfs/ -type f -exec install -Dm 755 "{}" "/{}" \;
EOF

FROM base AS make
ARG TARGETARCH
ARG MAKE_VERSION
ADD fetch/make-${MAKE_VERSION}.tar.gz /
WORKDIR /make-${MAKE_VERSION}
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--disable-nls
	make
	make DESTDIR=/rootfs install
	rm -rf /make-*
EOF

FROM base AS busybox
ARG TARGETARCH
ARG BUSYBOX_VERSION
ADD fetch/busybox-${BUSYBOX_VERSION}.tar.bz2 /
WORKDIR /busybox-${BUSYBOX_VERSION}
RUN --network=none <<-EOF
	make defconfig
	echo "CONFIG_STATIC=y" >> .config
	make
	mkdir -p /rootfs/usr/bin
	cp busybox /rootfs/usr/bin
	cd /rootfs
	/usr/bin/busybox --install -s usr/bin
	rm -rf /busybox-*
EOF

FROM base AS linux-headers
ARG TARGETARCH
ARG LINUX_VERSION
ADD fetch/linux-${LINUX_VERSION}.tar.xz /
WORKDIR /linux-${LINUX_VERSION}
RUN --network=none <<-EOF
	LINUX_ARCH=$(echo "$ARCH" \
		| sed -e 's/aarch64/arm64/' -e 's/riscv64/riscv/' -e 's/x86_64/x86/')
	make ARCH="$LINUX_ARCH" headers
	find usr/include -name '.*' -delete
	rm usr/include/Makefile
	rm usr/include/headers_check.pl
	cp -Rv usr/include/* /rootfs/usr/include/
	rm -rf /linux-*
EOF

FROM base AS binutils
ARG TARGETARCH
ARG BINUTILS_VERSION
ADD fetch/binutils-${BINUTILS_VERSION}.tar.xz /
WORKDIR /binutils-${BINUTILS_VERSION}
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr \
		--bindir=/usr/bin \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--sysconfdir=/etc \
		--disable-nls \
		--disable-multilib \
		--disable-plugins \
		--disable-gprofng \
		--enable-64-bit-bfd \
		--enable-ld=default \
		--enable-install-libiberty \
		--enable-deterministic-archives
	make
	make DESTDIR=/rootfs install
	rm -rf /binutils-*
EOF

# LAST place gcc-built artifacts appear in stage3's build graph — tier-1
# stages COPY from here; nothing from this stage reaches the final install.
FROM base AS gcc-runtime
RUN --network=none <<-EOF
	set -eux
	mkdir -p /rootfs/usr/bin /rootfs/usr/lib /rootfs/usr/libexec /rootfs/usr/include
	cp -a /usr/bin/gcc /usr/bin/g++ /usr/bin/cpp /rootfs/usr/bin/
	cp -a /usr/lib/libstdc++* /rootfs/usr/lib/  || true
	cp -a /usr/lib/libgcc_s* /rootfs/usr/lib/  || true
	cp -a /usr/lib/gcc /rootfs/usr/lib/
	cp -a /usr/libexec/gcc /rootfs/usr/libexec/
	cp -aR /usr/include/c++ /rootfs/usr/include/ || true
EOF

FROM base AS xz
ARG TARGETARCH
ARG XZ_VERSION
ADD fetch/xz-${XZ_VERSION}.tar.gz /
WORKDIR /xz-${XZ_VERSION}
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr
	make DESTDIR=/rootfs install
	rm -rf /xz-*
EOF

FROM base AS libucontext
ARG TARGETARCH
ARG LIBUCONTEXT_VERSION
ADD fetch/libucontext-${LIBUCONTEXT_VERSION}.tar.gz /
WORKDIR /libucontext-libucontext-${LIBUCONTEXT_VERSION}
RUN --network=none <<-EOF
	sed 's/\((wildcard .*)\)/(sort $\1)/g' -i Makefile
	make -j1 ARCH=${ARCH} DESTDIR=/rootfs install
	rm -rf /libucontext-*
EOF

FROM base AS musl
ARG TARGETARCH
ARG MUSL_VERSION
ADD fetch/musl-${MUSL_VERSION}.tar.gz /
WORKDIR /musl-${MUSL_VERSION}
RUN --network=none <<-EOF
	./configure \
		--prefix=/usr
	make DESTDIR=/rootfs install
	ln -sf /usr/lib/ld-musl-${ARCH}.so.1 /rootfs/usr/bin/ldd
	mv -f /rootfs/usr/lib/libc.so /rootfs/usr/lib/ld-musl-${ARCH}.so.1
	ln -sf ld-musl-${ARCH}.so.1 /rootfs/usr/lib/libc.musl-${ARCH}.so.1
	ln -sf /usr/lib/ld-musl-${ARCH}.so.1 /rootfs/usr/lib/libc.so
	rm -rf /musl-*
EOF

FROM base AS python
