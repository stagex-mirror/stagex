FROM scratch AS cc-zlib
COPY --from=base /rootfs/ /
COPY --from=busybox /rootfs/ /
COPY --from=make /rootfs/ /
COPY --from=cc-musl /rootfs/ /
COPY --from=cc-binutils /rootfs/ /
COPY --from=linux-headers /rootfs/ /
COPY --from=gcc-runtime /rootfs/ /
COPY --from=zlib /rootfs/ /
COPY --from=llvm-bootstrap /rootfs/ /
ARG TARGETARCH
ARG ZLIB_VERSION
ADD fetch/zlib-${ZLIB_VERSION}.tar.gz /
WORKDIR /zlib-${ZLIB_VERSION}
SHELL ["/bin/sh","-l","-c"]
RUN --network=none <<-EOF
	export CC=clang
	export CFLAGS="-fPIC"
	# Without -shared zlib's configure probe fails (no main()) and silently
	# disables libz.so. Force LDSHARED so the probe succeeds.
	export LDSHARED="clang -shared"
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib \
		--shared
	make -j "$(nproc)"
	DESTDIR=/rootfs make install
EOF

FROM scratch AS cc-libffi
COPY --from=base /rootfs/ /
COPY --from=busybox /rootfs/ /
COPY --from=make /rootfs/ /
COPY --from=cc-musl /rootfs/ /
COPY --from=cc-binutils /rootfs/ /
COPY --from=linux-headers /rootfs/ /
COPY --from=gcc-runtime /rootfs/ /
COPY --from=zlib /rootfs/ /
COPY --from=llvm-bootstrap /rootfs/ /
ARG TARGETARCH
ARG LIBFFI_VERSION
ADD fetch/libffi-${LIBFFI_VERSION}.tar.gz /
WORKDIR /libffi-${LIBFFI_VERSION}
SHELL ["/bin/sh","-l","-c"]
RUN --network=none <<-EOF
	set -ex
	CC=clang ./configure \
		--prefix=/usr \
		--enable-pax_emutrap \
		--enable-portable-binary \
		--disable-exec-static-tramp \
		--without-gcc-arch
	make -j "$(nproc)"
	DESTDIR=/rootfs make install
	rm -rf /rootfs/usr/lib64
EOF

FROM scratch AS cc-python
COPY --from=base /rootfs/ /
COPY --from=busybox /rootfs/ /
COPY --from=make /rootfs/ /
COPY --from=cc-musl /rootfs/ /
COPY --from=cc-binutils /rootfs/ /
COPY --from=cc-libffi /rootfs/ /
COPY --from=linux-headers /rootfs/ /
COPY --from=gcc-runtime /rootfs/ /
COPY --from=zlib /rootfs/ /
COPY --from=llvm-bootstrap /rootfs/ /
ARG TARGETARCH
ARG PYTHON_VERSION
ADD fetch/python-${PYTHON_VERSION}.tar.xz /
WORKDIR /Python-${PYTHON_VERSION}
COPY <<-EOF config.site
ac_cv_file__dev_ptmx=no
ac_cv_file__dev_ptc=no
EOF
ENV CONFIG_SITE=config.site
SHELL ["/bin/sh","-l","-c"]
RUN --network=none <<-EOF
	CC=clang CXX=clang++ ./configure \
		--prefix=/usr \
		--with-computed-gotos \
		--without-ensurepip \
		--disable-ipv6
	make
	make DESTDIR=/rootfs install
	ln -s /usr/bin/python3 /rootfs/usr/bin/python
EOF

FROM scratch AS cc-cmake
COPY --from=base /rootfs/ /
COPY --from=busybox /rootfs/ /
COPY --from=make /rootfs/ /
COPY --from=cc-musl /rootfs/ /
COPY --from=cc-binutils /rootfs/ /
COPY --from=cc-python /rootfs/ /
COPY --from=linux-headers /rootfs/ /
COPY --from=gcc-runtime /rootfs/ /
COPY --from=zlib /rootfs/ /
COPY --from=llvm-bootstrap /rootfs/ /
ARG TARGETARCH
ARG CMAKE_VERSION
ADD fetch/cmake-${CMAKE_VERSION}.tar.gz /
WORKDIR /cmake-${CMAKE_VERSION}/build
SHELL ["/bin/sh","-l","-c"]
RUN --network=none <<-EOF
	export CC=clang
	export CXX=clang++
	export CFLAGS="-fPIC"
	export CXXFLAGS="-fPIC -stdlib=libc++"
	export LDFLAGS="-stdlib=libc++"
	../configure \
		--prefix=/usr \
		-- \
		-DCMAKE_USE_OPENSSL=OFF
	make
	make DESTDIR=/rootfs install
EOF

FROM scratch AS cc-libzstd
COPY --from=base /rootfs/ /
COPY --from=busybox /rootfs/ /
COPY --from=make /rootfs/ /
COPY --from=cc-musl /rootfs/ /
COPY --from=cc-binutils /rootfs/ /
COPY --from=cc-cmake /rootfs/ /
COPY --from=linux-headers /rootfs/ /
COPY --from=gcc-runtime /rootfs/ /
COPY --from=zlib /rootfs/ /
COPY --from=llvm-bootstrap /rootfs/ /
ARG TARGETARCH
ARG LIBZSTD_VERSION
ADD fetch/libzstd-${LIBZSTD_VERSION}.tar.gz /
WORKDIR /zstd-${LIBZSTD_VERSION}
SHELL ["/bin/sh","-l","-c"]
RUN --network=none <<-EOF
	export CC=clang
	export CXX=clang++
	cmake \
		-B build-cmake \
		-S build/cmake \
		-DCMAKE_INSTALL_PREFIX=/usr/ \
		-DCMAKE_C_COMPILER=clang \
		-DCMAKE_CXX_COMPILER=clang++ \
		-Dbacktrace=disabled \
		-Db_lto=false \
		-Db_staticpic=true \
		-Db_pie=true \
		-Dpython.bytecompile=0 \
		-Dwerror=false \
		-Db_ndebug=true \
		-Dbin_tests=false \
		-Dbin_contrib=false \
		-Dbin_programs=true \
		-Dmulti_thread=enabled \
		-Dlz4=disabled \
		-Dlzma=disabled \
		-Dzlib=disabled
	cmake --build build-cmake -v --parallel $(nproc)
	mkdir -p /rootfs/usr/lib
	ln -s lib /rootfs/usr/lib64
	DESTDIR=/rootfs cmake --install build-cmake
	rm -rf /rootfs/usr/lib64
EOF

FROM scratch AS cc-libunwind
COPY --from=base /rootfs/ /
COPY --from=busybox /rootfs/ /
COPY --from=make /rootfs/ /
COPY --from=cc-musl /rootfs/ /
COPY --from=cc-binutils /rootfs/ /
COPY --from=cc-cmake /rootfs/ /
COPY --from=cc-libzstd /rootfs/ /
COPY --from=cc-xz /rootfs/ /
COPY --from=cc-zlib /rootfs/ /
COPY --from=cc-libucontext /rootfs/ /
COPY --from=linux-headers /rootfs/ /
COPY --from=gcc-runtime /rootfs/ /
COPY --from=zlib /rootfs/ /
COPY --from=llvm-bootstrap /rootfs/ /
ARG TARGETARCH
ARG LIBUNWIND_VERSION
ADD fetch/libunwind-${LIBUNWIND_VERSION}.tar.gz /
WORKDIR /libunwind-${LIBUNWIND_VERSION}
SHELL ["/bin/sh","-l","-c"]
RUN --network=none <<-EOF
	export CC=clang
	export CXX=clang++
	export CFLAGS="-llzma -lucontext"
	export CXXFLAGS="-llzma -lucontext -stdlib=libc++"
	export CPPFLAGS="-llzma -lucontext"
	./configure \
		--prefix=/usr \
		--enable-cxx-exceptions \
		--disable-tests
	make
	make DESTDIR=/rootfs install
EOF

# TIER 2 LLVM: full 19-target clang, built by tier-1 clang with libc++.
# No libstdc++/libgcc_s linkage in the output.
FROM scratch AS llvm
COPY --from=base /rootfs/ /
COPY --from=cc-musl /rootfs/ /
COPY --from=cc-busybox /rootfs/ /
COPY --from=cc-make /rootfs/ /
COPY --from=cc-binutils /rootfs/ /
COPY --from=cc-python /rootfs/ /
COPY --from=cc-cmake /rootfs/ /
COPY --from=cc-libffi /rootfs/ /
COPY --from=cc-libzstd /rootfs/ /
COPY --from=cc-zlib /rootfs/ /
COPY --from=cc-xz /rootfs/ /
COPY --from=cc-libucontext /rootfs/ /
COPY --from=cc-libunwind /rootfs/ /
COPY --from=linux-headers /rootfs/ /
# Build-env only — tier-1 clang needs libstdc++ to run. Not COPYed into /rootfs.
COPY --from=gcc-runtime /rootfs/ /
COPY --from=llvm-bootstrap /rootfs/ /
ARG TARGETARCH
ARG LLVM_VERSION
ADD fetch/llvm-${LLVM_VERSION}.tar.xz /
COPY patches/*.patch /llvm-project-${LLVM_VERSION}.src/
WORKDIR /llvm-project-${LLVM_VERSION}.src
SHELL ["/bin/sh","-l","-c"]

RUN --network=none <<-EOF
	for file in $(find . -maxdepth 1 -name "*.patch" | sort); do
		patch -p1 < "$file"
	done
EOF

RUN --network=none <<-EOF
	MAJOR_VERSION=$(echo "$LLVM_VERSION" | cut -d'.' -f1)
	case "$ARCH" in
		x86_64) LLVM_TARGET_ARCH=X86 ;;
		aarch64) LLVM_TARGET_ARCH=AArch64 ;;
		riscv64) LLVM_TARGET_ARCH=RISCV ;;
		*) exit 1 ;;
	esac
	# AMDGPU excluded due to non-deterministic build output
	LLVM_TARGETS_TO_BUILD="AArch64;ARM;AVR;BPF;Hexagon;Lanai;LoongArch;Mips;MSP430;NVPTX;PowerPC;RISCV;Sparc;SPIRV;SystemZ;VE;WebAssembly;X86;XCore"
	export CFLAGS="-fPIC"
	export CXXFLAGS="-fPIC -stdlib=libc++"
	export LDFLAGS="-stdlib=libc++"
	cmake \
		-B build \
		-S llvm \
		-Wno-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr/ \
		-DCMAKE_INSTALL_LIBDIR=/usr/lib \
		-DCMAKE_INSTALL_RPATH=/usr/lib \
		-DCMAKE_C_COMPILER=/usr/bin/clang \
		-DCMAKE_CXX_COMPILER=/usr/bin/clang++ \
		-DCMAKE_AR=/usr/bin/llvm-ar \
		-DCMAKE_NM=/usr/bin/llvm-nm \
		-DCMAKE_RANLIB=/usr/bin/llvm-ranlib \
		-DLLVM_USE_LINKER=lld \
		-DLLVM_HEADERS_TABLEGEN=/usr/bin/llvm-tblgen \
		-DCLANG_TABLEGEN=/usr/bin/clang-tblgen \
		-DLLVM_NATIVE_TOOL_DIR=/usr/bin/ \
		-DLLVM_HOST_TRIPLE="${TARGET}" \
		-DLLVM_TARGET_ARCH="${LLVM_TARGET_ARCH}" \
		-DLLVM_TARGETS_TO_BUILD="${LLVM_TARGETS_TO_BUILD}" \
		-DLLVM_RUNTIME_TARGETS="${TARGET}" \
		-DLLVM_BUILTIN_TARGETS="${TARGET}" \
		-DLLVM_ENABLE_PROJECTS="clang;lld" \
		-DLLVM_ENABLE_RUNTIMES="compiler-rt;libunwind;libcxx;libcxxabi" \
		-DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=ON \
		-DLLVM_BUILD_LLVM_DYLIB=ON \
		-DLLVM_LINK_LLVM_DYLIB=ON \
		-DLLVM_INSTALL_UTILS=ON \
		-DLLVM_INSTALL_BINUTILS_SYMLINKS=ON \
		-DLLVM_ENABLE_LIBCXX=ON \
		-DLLVM_ENABLE_BACKTRACES=OFF \
		-DLLVM_ENABLE_BINDINGS=OFF \
		-DLLVM_ENABLE_PEDANTIC=OFF \
		-DLLVM_ENABLE_PLUGINS=OFF \
		-DLLVM_ENABLE_TELEMETRY=OFF \
		-DLLVM_ENABLE_LIBXML2=OFF \
		-DLLVM_ENABLE_LIBEDIT=OFF \
		-DLLVM_ENABLE_LIBPFM=OFF \
		-DLLVM_ENABLE_ICU=OFF \
		-DLLVM_ENABLE_ICONV=OFF \
		-DLLVM_ENABLE_ZSTD=OFF \
		-DCLANG_DEFAULT_RTLIB=compiler-rt \
		-DCLANG_DEFAULT_CXX_STDLIB=libc++ \
		-DCLANG_DEFAULT_UNWINDLIB=libunwind \
		-DCLANG_CONFIG_FILE_SYSTEM_DIR=/etc/clang \
		-DCLANG_ENABLE_STATIC_ANALYZER=OFF \
		-DRUNTIMES_${TARGET}_LIBCXX_HAS_MUSL_LIBC=ON \
		-DRUNTIMES_${TARGET}_LIBCXX_CXX_ABI=libcxxabi \
		-DRUNTIMES_${TARGET}_LIBCXX_HARDENING_MODE=fast \
		-DRUNTIMES_${TARGET}_LIBCXX_HAS_ATOMIC_LIB=OFF \
		-DRUNTIMES_${TARGET}_LIBCXX_USE_COMPILER_RT=ON \
		-DRUNTIMES_${TARGET}_LIBCXXABI_USE_COMPILER_RT=ON \
		-DRUNTIMES_${TARGET}_LIBCXXABI_USE_LLVM_UNWINDER=ON \
		-DRUNTIMES_${TARGET}_LIBUNWIND_USE_COMPILER_RT=ON \
		-DRUNTIMES_${TARGET}_COMPILER_RT_BUILD_BUILTINS=ON \
		-DRUNTIMES_${TARGET}_COMPILER_RT_EXCLUDE_ATOMIC_BUILTIN=OFF \
		-DRUNTIMES_${TARGET}_COMPILER_RT_USE_BUILTINS_LIBRARY=ON \
		-DRUNTIMES_${TARGET}_COMPILER_RT_USE_LLVM_UNWINDER=ON \
		-DRUNTIMES_${TARGET}_COMPILER_RT_BUILD_GWP_ASAN=OFF \
		-DRUNTIMES_${TARGET}_COMPILER_RT_BUILD_SANITIZERS=OFF \
		-DRUNTIMES_${TARGET}_COMPILER_RT_DEFAULT_TARGET_ONLY=ON \
		-DRUNTIMES_${TARGET}_COMPILER_RT_SCUDO_STANDALONE_BUILD_SHARED=OFF
	cmake --build build -v --parallel $(nproc)
	DESTDIR=/rootfs cmake --install build
	rm -f /rootfs/usr/lib/clang/${MAJOR_VERSION}/lib/${TARGET}/libclang_rt.nsan* || true
	ln -sf /usr/bin/clang++ /rootfs/usr/bin/c++
	ln -sf /usr/bin/clang /rootfs/usr/bin/cc
	ln -sf /usr/bin/ld.lld /rootfs/usr/bin/ld
	ln -sf /usr/lib/clang/${MAJOR_VERSION}/lib/${TARGET}/libclang_rt.builtins.a \
		/rootfs/usr/lib/libclang_rt.builtins.a
	strip /rootfs/usr/lib/libLLVM.so.${MAJOR_VERSION}.1 || true
	mkdir -p /rootfs/etc/clang
	echo "-fuse-ld=lld" > /rootfs/etc/clang/clang.cfg
	echo "-fuse-ld=lld" > /rootfs/etc/clang/clang++.cfg
EOF

# INSTALL: tier-2 outputs only. Zero libstdc++/libgcc_s/gcc artifacts ship.
FROM scratch AS install
ARG TARGETARCH
SHELL ["/bin/sh","-l","-c"]
COPY --from=base /rootfs/ /
COPY --from=cc-busybox /rootfs/ /
COPY --from=cc-make /rootfs/ /
COPY --from=cc-musl /rootfs/ /
COPY --from=cc-binutils /rootfs/ /
COPY --from=cc-python /rootfs/ /
COPY --from=cc-cmake /rootfs/ /
COPY --from=linux-headers /rootfs/ /
COPY --from=cc-libffi /rootfs/ /
COPY --from=cc-libzstd /rootfs/ /
COPY --from=cc-libunwind /rootfs/ /
COPY --from=cc-libucontext /rootfs/ /
COPY --from=cc-zlib /rootfs/ /
COPY --from=cc-xz /rootfs/ /
COPY --from=llvm /rootfs/ /
#Non deterministic edge case and we don't need it
RUN rm -rf /usr/share/info/dir

FROM scratch AS package
COPY --from=install . /
